PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX obo:     <http://purl.obolibrary.org/obo/>

# G6 (worked example for the main-text model figure).
# One organisation's engagement roles, read through both layers in one query:
#   real-world layer — each role individual is a role of the organisation (RO role of) in one procurement case,
#     realized in engagements of that case (BFO realized in); one engagement may realize several of its roles;
#   information layer — the role is supported by final role claims (nuproc:supportedByClaim), each about a coded
#     participation of a cluster that reports the engagement, and generated by a coding or adjudication activity (in
#     the demonstration graph, a synthetic one); the participation was coded from a reference whose resolution
#     status is returned; the records that report the engagement are counted.
# Side roles have no claim and are not returned. Aggregate only: no article, event or engagement identifier.
# The organisation is chosen by its label; in the demonstration graph it is a synthetic actor and the values and
# claims are synthetic.
SELECT ?engagementRole ?resolution
       (COUNT(DISTINCT ?e) AS ?nEngagements) (COUNT(DISTINCT ?rec) AS ?nRecords)
       ?claimedBy
WHERE {
  ?org a nuproc:Organization ;
       rdfs:label ?orgLabel .
  FILTER( STR(?orgLabel) = "Vendor Beta (SYN)" )
  ?r   obo:RO_0000081 ?org ;
       obo:BFO_0000054 ?e ;
       nuproc:supportedByClaim ?c .
  ?c   nuproc:claimedRole ?v ;
       nuproc:claimAbout ?p ;
       prov:wasGeneratedBy ?act .
  # the claim that supports the role in this engagement: its participation belongs to a cluster reporting it
  ?k0  nuproc:hasParticipation ?p ;
       nuproc:reportsEngagement ?e .
  ?v   skos:notation ?engagementRole .
  BIND( STRAFTER(STR(?act), "/activity/") AS ?claimedBy )
  { ?p nuproc:hasActorReference ?ref } UNION { ?p nuproc:hasParticipantReference ?ref }
  ?ref nuproc:hasResolutionStatus ?st .
  ?st  skos:notation ?resolution .
  ?rec a nuproc:EventRecord ;
       nuproc:reportsEngagement ?e .
}
GROUP BY ?engagementRole ?resolution ?claimedBy
ORDER BY DESC(?nEngagements) ?engagementRole
