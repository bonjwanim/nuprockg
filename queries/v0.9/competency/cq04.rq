PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# CQ04 (representation) Which events have a participant that is not identified as an individual organisation, and
#   which kind of reference stands for it: a collective, an anonymous singular, a national side or a candidate set?
# CQ04 (R) 참여자 이름이 밝혀지지 않은 사건과 그 참조의 종류
# 기대 (0.9.0 — evaluation/cq/v0.9/expected_results.csv): 301건 / 표기 37종 — ADR-0026 이 후보 집합을
#   네 번째 종류로 옮겼다. Collective 22건 · AnonymousSingular 9건 · NationalSide 245건 ·
#   AmbiguousOrganization 25건
SELECT ?ev ?refClass ?mention ?resolution
WHERE {
  ?ev a nuproc:EngagementCluster ;
      nuproc:hasParticipation ?p .
  ?p  nuproc:hasParticipantReference ?ref .
  ?ref a ?cls .
  # 2026-08-18 — 닫힌 열거를 **상위 클래스 폐포**로 바꾼다.
  #
  #   종전에는 세 하위 클래스를 이름으로 열거했다. 설계 세트에서는 그것이 **완전한
  #   분할**이었다(`rstat:unresolved` 0건). 그런데 축 E 에서 reserved 가 해소 대기
  #   표기를 처음 만들었고, 그것들은 상위 클래스 `UnnamedActorReference` 로만 실려
  #   **26건이 이 질의에서 통째로 빠졌다** — 하필 이 CQ 가 "참여자의 이름이 밝혀지지
  #   않은 사건은 무엇인가" 를 묻는 질의다.
  #
  #   `subClassOf*` 는 반사적이므로 상위 클래스 자신도 잡는다. 설계 세트 결과는
  #   바뀌지 않는다 — 하위 3종이 모두 폐포 안에 있기 때문이다.
  #
  # v0.5 (ADR-0031): 폐포의 기준을 모든 참여자 지칭의 상위 클래스로 올린다. 이름은 있으나
  # 아직 대조되지 않은 지칭(DefiniteOrganizationReference + unresolved)도 슬롯에 설 수 있고,
  # 그것도 '참여자가 식별되지 않은' 경우다. 해소된 지칭은 슬롯에 서지 않으므로 들어오지
  # 않는다. 설계 세트의 결과는 바뀌지 않는다 (그런 지칭이 0건).
  ?cls rdfs:subClassOf* nuproc:ActorReference .
  BIND( STRAFTER( STR(?cls), "ns#" ) AS ?refClass )
  OPTIONAL { ?ref nuproc:hasSourceMention ?mention }
  OPTIONAL { ?ref nuproc:hasResolutionStatus ?rs . ?rs skos:notation ?resolution }
}
ORDER BY ?ev
