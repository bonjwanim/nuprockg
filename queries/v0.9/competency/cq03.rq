PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# CQ03 (representation) Which role did the host side (the counterparty) play in an event? (Every value of the
#   vocabulary is returned, with the number of events that show it, so that what can be represented and what was
#   observed are read apart.)
# CQ03 (R) 한 사건에서 상대측이 수행한 기능 역할은 무엇인가?
# 기대(ORSD §4): 9종 역할이 전부 조회됨.
# 상대측 참여자 슬롯은 비는 것이 정상이다 — counterparty_canon 컬럼이 원자료에 없다.
# v0.8 — **표현 가능성과 관측을 가른다.** 어휘 (상대측 역할 스킴) 의 값마다 한 행을 내고 (표현 가능),
# 설계 자료에서 그 값을 가진 사건 수를 붙인다 (관측 — 없으면 0). observedRole 은 관측된 값에만 채운다. ORSD §4 의 기대
# ('9종 전부 조회') 는 관측에 대한 것이므로 그대로 둔다.
SELECT ?counterpartyRole ?n (IF(?n > 0, ?counterpartyRole, "") AS ?observedRole)
WHERE {
  {
    SELECT ?counterpartyRole (COUNT(DISTINCT ?ev) AS ?n)
    WHERE {
      ?cr skos:inScheme <https://w3id.org/nuproc/counterpartyrole/> ;
          skos:notation ?counterpartyRole .
      OPTIONAL {
        ?ev a nuproc:EngagementCluster ;
            nuproc:hasParticipation ?p .
        ?p  nuproc:hasSide srole:host_side ;
            nuproc:hasCounterpartyRole ?cr .
      }
    }
    GROUP BY ?counterpartyRole
  }
}
ORDER BY DESC(?n) ?counterpartyRole
