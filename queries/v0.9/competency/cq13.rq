PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# CQ13 (temporal) How does the month of an event differ from the publication dates of the articles behind it?
# CQ13 (T) 한 사건의 발생 월과 근거 기사들의 발행일은 어떻게 다른가?
# 기대(ORSD §4): 정밀도가 서로 다르게 표현됨 — 사건은 월(gYearMonth), 기사는 일(date).
# 값이 아니라 **속성과 리터럴 타입**으로 정밀도를 나타낸다 (ADR-0015).
SELECT ?evDatatype ?artDatatype (COUNT(*) AS ?n)
WHERE {
  ?ev  a nuproc:EngagementCluster ; time:hasTime ?ei .
  ?ei  time:inXSDgYearMonth ?evTime .
  ?rec nuproc:describesEvent ?ev ; prov:wasDerivedFrom ?art .
  ?art time:hasTime ?ai .
  ?ai  time:inXSDDate ?artTime .
  BIND( DATATYPE(?evTime)  AS ?evDatatype )
  BIND( DATATYPE(?artTime) AS ?artDatatype )
}
GROUP BY ?evDatatype ?artDatatype
