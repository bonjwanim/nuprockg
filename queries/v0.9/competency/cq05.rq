PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# CQ05 (representation) Which in-scope articles yielded no event?
# CQ05 (R) in-scope 기사 중 사건이 추출되지 않은 기사
# 기대(ORSD §4): design 세트에서 1,680건.
# SourceArticle 에 event 를 요구하는 SHACL 제약은 없다 — presence 는 넓게, event 는
# 엄격하게 코딩된 설계상의 성질이다.
SELECT ?article
WHERE {
  ?article a nuproc:SourceArticle .
  FILTER NOT EXISTS { ?rec a nuproc:EventRecord ; prov:wasDerivedFrom ?article }
}
ORDER BY ?article
