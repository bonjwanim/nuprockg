PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# CQ01 (representation) How many events does each engagement channel have in a given case?
# CQ01 (R) 특정 사례에서 각 관여 채널의 사건은 몇 건인가?
# 기대: 채널 합계가 DATA_AUDIT §4 와 일치 — B2B 216 / B2G 575 / G2G 235 (design 1,026)
SELECT ?case ?channel (COUNT(DISTINCT ?ev) AS ?n)
WHERE {
  ?ev a nuproc:EngagementCluster ;
      nuproc:concernsCase ?c ;
      nuproc:hasEngagementChannel ?ch .
  ?c  rdfs:label ?case .
  ?ch skos:notation ?channel .
}
GROUP BY ?case ?channel
ORDER BY ?case ?channel
