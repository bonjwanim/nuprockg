PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# CQ19 (provenance) On which final claims does a role an organisation bears in a case rest, which activity made each
#   under which plans, and how many claims about the same participations were not adopted (non-final)?
# CQ19 (P · 실세계 층의 출처, v0.8 신설 — ADR-0040 §2) 한 조직이 한 사례에서 지닌 역할은 어느 최종 주장들에 근거하며, 그 주장은
# 어느 활동이 어떤 계획을 따라 냈는가? 같은 참여에 관한, 채택되지 않은 (최종이 아닌) 주장은 몇인가?
# 경로: 역할 — supportedByClaim → 최종 역할 주장 — wasGeneratedBy → 활동 — qualifiedAssociation → (행위자, 계획).
# v0.8 — 역할은 사례 수준이라 최종 주장 여럿이 한 역할을 뒷받침한다. 최종 주장은 v3 모델 코딩 또는 (사람이 점검한 표본
# 사건) 사람의 조정 기준이 낸다. 같은 참여에 관한 최종이 아닌 주장 — 표본 사건의 검증 코더 A · B 와 모델의
# 주장 — 을 센다: 시각이나 개정 관계로 가른 '이전' 주장이 아니라 **채택되지 않은** 주장이다 (종전의 nEarlierClaims 는 이름이
# 뜻과 어긋났다). 한 참여가 여러 종류의 역할을 뒷받침하면 그 참여의 주장은 종류마다 한 번씩 세인다.
# 역할 종류마다 한 행 — 개별 관여 · 주장 IRI 를 내지 않는다 ((iii)층).
SELECT ?roleKind (COUNT(DISTINCT ?r) AS ?nRoles) (COUNT(DISTINCT ?c) AS ?nFinalClaims)
       (GROUP_CONCAT(DISTINCT ?finalActivity; separator="|") AS ?finalActivities)
       (GROUP_CONCAT(DISTINCT ?agent; separator="|") AS ?agents)
       (MIN(?nPlans) AS ?minPlans) (COUNT(DISTINCT ?other) AS ?nNonFinalClaims)
WHERE {
  ?r nuproc:supportedByClaim ?c ; a ?k .
  ?k rdfs:subClassOf nuproc:EngagementRole .
  BIND(STRAFTER(STR(?k), "#") AS ?roleKind)
  ?c prov:wasGeneratedBy ?act ; nuproc:claimAbout ?p .
  {
    SELECT ?act (SAMPLE(?ag0) AS ?ag) (COUNT(DISTINCT ?plan) AS ?nPlans)
    WHERE { ?act prov:qualifiedAssociation ?asn . ?asn prov:agent ?ag0 ; prov:hadPlan ?plan . }
    GROUP BY ?act
  }
  BIND(STRAFTER(STR(?act), "/activity/") AS ?finalActivity)
  BIND(STRAFTER(STR(?ag), "/agent/") AS ?agent)
  OPTIONAL { ?other nuproc:claimAbout ?p . FILTER NOT EXISTS { ?p nuproc:hasFinalRoleClaim ?other } }
}
GROUP BY ?roleKind
ORDER BY ?roleKind
