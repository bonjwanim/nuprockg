PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# CQ08 (provenance) How many distinct articles report an event, and how many article–event mentions does it have?
# CQ08 (P) 한 사건의 고유 근거 기사 수와 기사-사건 언급 수는 각각 몇인가?
# 기대(ORSD §4): 두 값이 별개 속성으로 나오고 합계 차이가 83건
#   (언급 5,228 - 고유 5,145 = 83)
SELECT ?ev ?nUnique (COUNT(?rec) AS ?nMentions)
WHERE {
  ?ev a nuproc:EngagementCluster ;
      nuproc:uniqueSourceArticleCount ?nUnique .
  ?rec nuproc:describesEvent ?ev .
}
GROUP BY ?ev ?nUnique
ORDER BY ?ev
