PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# G4 (optional) Event sequences: the same organisation moving between channels within a case, linking an event only
#   to events in the next month. A demonstration of what can be represented; no empirical reading is offered.
# G4 (선택) 사건 연쇄 — 같은 조직이 한 사례 안에서 채널을 옮겨 가는 전이
# 월 정밀도에서 **바로 다음 달의 사건**으로만 잇는다. 임의의 시간창을 도입하지 않는다.
# **표현 능력의 시연이다. 실증적 해석을 붙이지 않는다** (EVALUATION_PROTOCOL §7).
#
# 첫 실행 뒤 수정 (2026-08-18): 사건 자기조인을 그대로 썼더니 rdflib 에서 10분을 넘겼다.
# (조직, 사례, 월, 채널) 조합으로 먼저 줄인 뒤 인접 월끼리 잇도록 부질의로 바꿨다.
# **결과의 정의는 같다** — 세는 대상이 아니라 계산 순서만 바꿨다.
SELECT ?fromChannel ?toChannel (COUNT(*) AS ?nTransitions)
       (COUNT(DISTINCT ?org) AS ?nOrgs) (COUNT(DISTINCT ?case) AS ?nCases)
WHERE {
  {
    SELECT DISTINCT ?org ?case ?m1 ?fromChannel WHERE {
      ?ev a nuproc:EngagementCluster ; nuproc:concernsCase ?c ;
          nuproc:monthRelativeToT0 ?m1 ; nuproc:hasEngagementChannel ?ch ;
          nuproc:hasParticipation ?p .
      ?p nuproc:hasSide srole:export_side ; nuproc:namesParticipant ?org .
      ?c rdfs:label ?case . ?ch skos:notation ?fromChannel .
    }
  }
  {
    SELECT DISTINCT ?org ?case ?m2 ?toChannel WHERE {
      ?ev2 a nuproc:EngagementCluster ; nuproc:concernsCase ?c2 ;
           nuproc:monthRelativeToT0 ?m2 ; nuproc:hasEngagementChannel ?ch2 ;
           nuproc:hasParticipation ?p2 .
      ?p2 nuproc:hasSide srole:export_side ; nuproc:namesParticipant ?org .
      ?c2 rdfs:label ?case . ?ch2 skos:notation ?toChannel .
    }
  }
  FILTER( ?m2 = ?m1 + 1 )
}
GROUP BY ?fromChannel ?toChannel
ORDER BY DESC(?nTransitions)
