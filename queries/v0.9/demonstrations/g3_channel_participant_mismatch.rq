PREFIX nuproc:  <https://w3id.org/nuproc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX channel: <https://w3id.org/nuproc/channel/>
PREFIX prole:   <https://w3id.org/nuproc/playerrole/>
PREFIX crole:   <https://w3id.org/nuproc/counterpartyrole/>
PREFIX srole:   <https://w3id.org/nuproc/siderole/>
PREFIX erole:   <https://w3id.org/nuproc/engagementrole/>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
PREFIX rstat:   <https://w3id.org/nuproc/resolutionstatus/>

# G3 (required) Channel and participant combinations that the domain regularities do not expect (rules R1, R3, R4
#   and R5 of ADR-0020), counted per rule. The SHACL shapes check the same rules; the point of the demonstration is
#   whether the two give the same answer. No event identifier is returned.
# G3 (필수) 주장된 채널과 참여자 구성/역할 조합의 불일치 탐지
# ADR-0020 의 R1·R3·R4·R5 를 질의로 옮긴 것이며 SHACL 실행 결과와 대조된다 —
# **같은 규칙이 두 실행 경로(SHACL / SPARQL)에서 같은 답을 내는지**가 이 시연의 요점이다.
# 개별 사건 식별자를 내지 않는다.
SELECT ?rule ?severity ?channel ?direction ?role (COUNT(DISTINCT ?ev) AS ?n)
WHERE {
  {
    ?ev nuproc:hasEngagementChannel channel:G2G ; nuproc:hasParticipation ?p .
    ?p nuproc:hasSide srole:export_side .
    FILTER NOT EXISTS { ?p nuproc:hasCodedPlayerCategory prole:government }
    BIND("R1" AS ?rule) BIND("Warning" AS ?severity) BIND("G2G" AS ?channel)
    BIND("export side" AS ?direction) BIND("not government" AS ?role)
  } UNION {
    ?ev nuproc:hasEngagementChannel channel:B2G ; nuproc:hasParticipation ?p .
    ?p nuproc:hasSide srole:export_side ; nuproc:hasCodedPlayerCategory prole:government .
    BIND("R3" AS ?rule) BIND("Warning" AS ?severity) BIND("B2G" AS ?channel)
    BIND("export side" AS ?direction) BIND("government" AS ?role)
  } UNION {
    ?ev nuproc:hasEngagementChannel channel:B2B ; nuproc:hasParticipation ?p .
    ?p nuproc:hasSide srole:export_side ; nuproc:hasCodedPlayerCategory prole:government .
    BIND("R4" AS ?rule) BIND("Warning" AS ?severity) BIND("B2B" AS ?channel)
    BIND("export side" AS ?direction) BIND("government" AS ?role)
  } UNION {
    ?ev nuproc:hasEngagementChannel channel:B2B ; nuproc:hasParticipation ?p .
    ?p nuproc:hasSide srole:host_side ; nuproc:hasCounterpartyRole crole:host_government .
    BIND("R5" AS ?rule) BIND("Warning" AS ?severity) BIND("B2B" AS ?channel)
    BIND("host side" AS ?direction) BIND("host_government" AS ?role)
  }
}
GROUP BY ?rule ?severity ?channel ?direction ?role
ORDER BY ?rule
