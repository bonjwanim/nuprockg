crole:public_community a skos:Concept ;
    rdfs:label "public and community"@en ;
    dcterms:source "registry/codebook_v1.0.csv (counterparty_role, observed_n=90, status=in_use)"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/codebook>,
        <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0005>,
