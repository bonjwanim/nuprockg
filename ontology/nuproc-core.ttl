@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix nuproc: <https://w3id.org/nuproc/ns#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.obolibrary.org/obo/BFO_0000054> a owl:ObjectProperty ;
    rdfs:label "has realization"@en ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo.owl> ;
    skos:altLabel "realized in"@en .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

org:hasMember a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:isDefinedBy org: .

org:subOrganizationOf a owl:ObjectProperty ;
    rdfs:label "sub organization of"@en ;
    rdfs:isDefinedBy org: .

nuproc:ChannelPresenceCodingActivity a owl:Class ;
    rdfs:label "Channel Presence Coding Activity"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md (the three stages)"@en,
        "ADR-0003 3단계"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003> ;
    rdfs:subClassOf prov:Activity,
        nuproc:CodingActivity ;
    skos:definition "A coding activity that read the full article and assigned per-channel presence labels."@en,
        "기사 전문을 읽고 채널별 존재 라벨을 부여한 코딩 활동"@ko ;
    nuproc:alignmentReadinessBFO "BFO:process"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant"@en ;
    nuproc:justifyingCompetencyQuestion "CQ07" ;
    nuproc:ontocleanDependence "+D Depends on the input data"@en,
        "+D 입력 자료에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass"@en,
        "상위 클래스와 같다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One run"@en,
        "+U 한 번의 실행"@ko .

nuproc:EngagementRoleCodingActivity a owl:Class ;
    rdfs:label "Engagement Role Coding Activity"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §3; docs/adr/ADR-0033 §3 (v3: agent claude-opus-5-5, codebook v3.0, coding protocol v3)"@en,
        "ADR-0040 §3; ADR-0033 §3 (v3: 행위자 claude-opus-5-5 · 코드북 v3.0 · 규약 v3)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0024>,
        <https://w3id.org/nuproc/adr/ADR-0033>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf prov:Activity,
        nuproc:CodingActivity ;
    skos:definition "A coding activity that coded the engagement roles of export-side participations, following a codebook and its coding protocol as plans."@en,
        "수출 측 참여의 관여 역할을 코딩한 활동 — 코드북과 그 코딩 규약을 계획으로 따랐다."@ko ;
    skos:scopeNote "A different agent and a different codebook from event extraction. Each value has provenance: for each role value the graph holds the claim (RoleClaim) that yielded it. The model coding does not reproduce (seed and temperature not fixed)"@en,
        "사건 추출 활동과 다른 행위자·다른 코드북이다. 값마다 출처가 있다 — 역할 값마다 그 값을 낸 주장 (RoleClaim) 이 그래프에 있다. 모델의 코딩은 재현되지 않는다 (seed·temperature 미고정)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:process"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant"@en ;
    nuproc:justifyingCompetencyQuestion "CQ07" ;
    nuproc:ontocleanDependence "+D Depends on the input data"@en,
        "+D 입력 자료에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass"@en,
        "상위 클래스와 같다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One run"@en,
        "+U 한 번의 실행"@ko .

nuproc:EventExtractionActivity a owl:Class ;
    rdfs:label "Event Extraction Activity"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md (the three stages)"@en,
        "ADR-0003 3단계"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003> ;
    rdfs:subClassOf prov:Activity,
        nuproc:CodingActivity ;
    skos:definition "A coding activity that extracted structured events from article body text."@en,
        "기사 본문에서 구조화된 사건을 추출한 코딩 활동"@ko ;
    nuproc:alignmentReadinessBFO "BFO:process"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant"@en ;
    nuproc:justifyingCompetencyQuestion "CQ07" ;
    nuproc:ontocleanDependence "+D Depends on the input data"@en,
        "+D 입력 자료에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass"@en,
        "상위 클래스와 같다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One run"@en,
        "+U 한 번의 실행"@ko .

nuproc:ScreeningActivity a owl:Class ;
    rdfs:label "Screening Activity"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md (the three stages)"@en,
        "ADR-0003 3단계"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003> ;
    rdfs:subClassOf prov:Activity,
        nuproc:CodingActivity ;
    skos:definition "A coding activity that read article titles and leads and assigned a relevance bucket."@en,
        "기사 제목·리드를 읽고 관련성 버킷을 부여한 코딩 활동"@ko ;
    nuproc:alignmentReadinessBFO "BFO:process"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant"@en ;
    nuproc:justifyingCompetencyQuestion "CQ07" ;
    nuproc:ontocleanDependence "+D Depends on the input data"@en,
        "+D 입력 자료에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass"@en,
        "상위 클래스와 같다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One run"@en,
        "+U 한 번의 실행"@ko .

nuproc:alignmentReadinessBFO a owl:AnnotationProperty ;
    rdfs:label "alignment readiness (BFO/IAO)"@en ;
    rdfs:comment "Alignment readiness is recorded as an annotation. No foundational ontology is imported. The foundational subclass axioms are in the alignments module: the information entities are subclasses of the IAO information content entity; Engagement, EngagementRole and Organization are subclasses of the BFO process, role and object aggregate; and reportsEngagement is a subproperty of IAO is about. The core module uses two relations from RO (has participant, role of) in its class restrictions; BFO has realization is declared and constrained by the shapes. All of these terms are referenced by IRI only, so their axioms do not enter the consistency check. No alignment with DOLCE is claimed."@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:alignmentReadinessDOLCE a owl:AnnotationProperty ;
    rdfs:label "alignment readiness (DOLCE)"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:appliesToLayer a owl:ObjectProperty ;
    rdfs:label "applies to layer"@en ;
    dcterms:source "docs/adr/ADR-0009-reliability-reporting.md (article / article-event / event)" ;
    rdfs:comment "range is deliberately left unasserted. Its value is a property or a class, so asserting rdfs:range would be metamodelling and would push the ontology out of OWL 2 DL, widening the scope of the consistency check beyond our own axioms (the same concern for which importing the RDF Data Cube vocabulary was rejected). SHACL checks instead, locally, that a measurement has exactly one value of each and that the value of appliesToLayer is one of the three analytic layers; what kind of term measuresProperty names is not checked (see nuproc-shapes.ttl)."@en ;
    rdfs:domain nuproc:DataQualityMeasurement ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0016> ;
    skos:definition "Points to the layer to which a quality measurement applies. (DataQualityMeasurement -> rdfs:Class)"@en,
        "품질 측정치가 어느 계층에 적용되는지 가리킨다. (DataQualityMeasurement → rdfs:Class)"@ko ;
    skos:scopeNote "DQV has no corresponding property, so it is defined locally. The same property has κ 0.88 / 0.60 depending on the layer"@en,
        "DQV 에 대응 속성이 없어 자체 정의한다. 같은 속성이 계층에 따라 κ 0.88 / 0.60 이다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ16" .

nuproc:assertedParticipantCount a owl:DatatypeProperty ;
    rdfs:label "asserted participant count"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md (cases in which the cardinality is stated explicitly)"@en,
        "ADR-0008 (기수 명시 사례)"@ko ;
    rdfs:domain nuproc:CollectiveActorReference ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:positiveInteger ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013> ;
    skos:definition "The number of participating organizations stated in a reference, such as three bidders. (CollectiveActorReference -> xsd:positiveInteger)"@en,
        "지칭에 명시된 참여 조직 수 (예: 입찰자 3사). (CollectiveActorReference → xsd:positiveInteger)"@ko ;
    skos:scopeNote "It is assigned only when explicitly stated. It is not estimated"@en,
        "명시된 경우에만 부여한다. 추정하지 않는다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ04" .

nuproc:claimedResolvedTo a owl:ObjectProperty ;
    rdfs:label "claimed resolved to"@en ;
    dcterms:source "docs/adr/ADR-0043-resolution-claims.md §2.1" ;
    rdfs:domain nuproc:ResolutionClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:Organization ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0043> ;
    skos:definition "Points to the organization to which this claim resolves the reference. (ResolutionClaim -> Organization) Present exactly once when the claimed status is resolved, and absent otherwise (SHACL)."@en,
        "이 주장이 그 지칭을 해소한 조직을 가리킨다. (ResolutionClaim → Organization) 주장된 상태가 resolved 일 때 정확히 하나 있고, 그 밖에는 없다 (SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ17" .

nuproc:clusteredBy a owl:ObjectProperty ;
    rdfs:label "clustered by"@en ;
    dcterms:source "docs/adr/ADR-0027-event-representation.md" ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:MonthGranularityRule ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0027> ;
    skos:definition "Points to the clustering rule that produced this event individual. (EngagementCluster -> MonthGranularityRule) All event-level counts are conditional on this rule."@en,
        "이 사건 개체를 만들어 낸 군집 규칙을 가리킨다. (EngagementCluster → MonthGranularityRule) 사건 수준 집계는 모두 이 규칙에 조건부다."@ko ;
    skos:scopeNote "Without this, the graph cannot say what the number '1,026' is conditional on."@en,
        "이것이 없으면 *'1,026'* 이라는 수가 무엇에 조건부인지 그래프가 말하지 못한다. ADR-0027 §4."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ09" .

nuproc:comparisonType a owl:DatatypeProperty ;
    rdfs:label "comparison type"@en ;
    dcterms:source "docs/adr/ADR-0009-reliability-reporting.md (sample size, comparison type and layer are stated together)"@en,
        "docs/adr/ADR-0009-reliability-reporting.md (표본 수 · 비교 유형 · 계층을 병기한다)"@ko ;
    rdfs:domain nuproc:DataQualityMeasurement ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0009>,
        <https://w3id.org/nuproc/adr/ADR-0016>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "States what was compared with what to obtain a quality measurement, for example human coder A against human coder B before adjudication. (DataQualityMeasurement -> xsd:string)"@en,
        "품질 측정치가 무엇과 무엇을 견주어 얻은 값인지 적는다 — 예: 사람 코더 A 대 사람 코더 B, 조정 전. (DataQualityMeasurement → xsd:string)"@ko ;
    skos:scopeNote "DQV has no corresponding property. Earlier versions stated the comparison only in rdfs:comment, so a query could not return it"@en,
        "DQV 에 대응 속성이 없다. 종전에는 rdfs:comment 에만 적었다 — 그래서 질의 (CQ16) 가 비교 유형을 낼 수 없었다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ16" .

nuproc:describesEvent a owl:ObjectProperty ;
    rdfs:label "describes event"@en ;
    dcterms:source "docs/adr/ADR-0001-analytic-unit.md" ;
    rdfs:domain nuproc:EventRecord ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:EngagementCluster ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0019> ;
    skos:definition "Points to the reported engagement-event cluster that a record contributes to. (EventRecord -> EngagementCluster) The cluster is an analytical representation of what sources reported, not a directly observed real-world occurrence."@en,
        "기록이 어느 보고된 사건 군집에 속하는지 가리킨다. (EventRecord → EngagementCluster) 군집은 직접 관측된 실세계 사건이 아니라 6요소 키로 묶은 분석적 표현이다 (ADR-0027)."@ko ;
    skos:scopeNote "The central relation of the separation between records and clusters — it links article-level records to the analytical cluster that groups those records. || Corrected on 2026-08-22. The previous definition was 'describes a real-world activity'. EngagementCluster had been defined as an analytical cluster, but this property alone had remained on the old reading, so within the same TBox the class definition and the property definition contradicted each other."@en,
        "기록과 군집을 가르는 분리의 핵심 관계 — 기사 수준 기록과 그 기록들을 묶은 분석적 군집을 잇는다. || 2026-08-22 정정. 종전 정의문은 *'실세계 활동을 기술한다'* 였다. ADR-0027 이 EngagementCluster 를 분석적 군집으로 확정했는데 이 속성만 옛 읽기에 남아 있어, 같은 TBox 안에서 클래스 정의문과 속성 정의문이 서로 반대였다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ06;CQ08;CQ15" .

nuproc:generatedQualityMeasurement a owl:ObjectProperty ;
    rdfs:label "generated quality measurement"@en ;
    dcterms:source "docs/adr/ADR-0009-reliability-reporting.md" ;
    rdfs:domain nuproc:ValidationActivity ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:DataQualityMeasurement ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0009>,
        <https://w3id.org/nuproc/adr/ADR-0016> ;
    rdfs:subPropertyOf prov:generated ;
    skos:definition "Points to a quality measurement that a validation activity produced. (ValidationActivity -> DataQualityMeasurement)"@en,
        "검증 활동이 산출한 품질 측정치를 가리킨다. (ValidationActivity → DataQualityMeasurement)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ16" .

nuproc:hasCandidateLabel a owl:DatatypeProperty ;
    rdfs:label "has candidate label"@en ;
    dcterms:source "docs/adr/ADR-0010-khnp-kepco-merge.md; docs/adr/ADR-0026-actor-reference-typing.md" ;
    rdfs:domain nuproc:AmbiguousOrganizationReference ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0026> ;
    skos:definition "Carries the surface form of a candidate that an ambiguous organization reference was narrowed to. (AmbiguousOrganizationReference -> xsd:string) When the candidates are entered in the actor registry as individual organizations, hasCandidateOrganization links them by IRI; organizations are not minted here."@en,
        "모호한 조직 참조가 좁혀 둔 후보의 표기를 싣는다. (AmbiguousOrganizationReference → xsd:string) 후보 조직이 actor registry 에 개별 항목으로 등재되면 hasCandidateOrganization 이 그것을 IRI 로 잇는다 — 없는 조직을 만들어 넣지 않는다 (ADR-0026 결과)."@ko ;
    skos:scopeNote "The candidate organizations (KHNP and KEPCO; CNNC and CGN) are entered individually in registry/candidate_organizations.csv and are linked by hasCandidateOrganization from a candidate-set reference. After the event-by-event resolution, every candidate-set reference left in the design data uses the label 'KHNP/KEPCO'. This property keeps the candidate surface forms."@en,
        "후보 조직(KHNP·KEPCO, CNNC·CGN)은 registry/candidate_organizations.csv 에 개별 조직으로 등재돼 있고, 후보 집합 지칭에서 hasCandidateOrganization 으로 이어진다 (ADR-0031 §11). 사건별 해소 (ADR-0040 §5) 뒤 설계 자료에 후보 집합으로 남은 지칭은 모두 KHNP/KEPCO 다. 이 속성은 후보 표기를 싣는다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" .

nuproc:hasCandidateOrganization a owl:ObjectProperty ;
    rdfs:label "has candidate organization"@en ;
    dcterms:source "docs/adr/ADR-0010-khnp-kepco-merge.md; docs/adr/ADR-0026-actor-reference-typing.md" ;
    rdfs:domain nuproc:AmbiguousOrganizationReference ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:Organization ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0026> ;
    skos:definition "Points to a candidate organization that an ambiguous reference was narrowed to. At least two: with one candidate the reference is resolved, not ambiguous. (AmbiguousOrganizationReference -> Organization)"@en,
        "모호한 조직 참조가 좁혀 둔 후보 조직을 가리킨다. 최소 2개다 — 하나면 모호한 참조가 아니라 해소된 참조다. (AmbiguousOrganizationReference → Organization)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" .

nuproc:hasCodedPlayerCategory a owl:ObjectProperty ;
    rdfs:label "has coded player category"@en ;
    dcterms:source "docs/adr/ADR-0014-two-role-axes.md" ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0014>,
        <https://w3id.org/nuproc/adr/ADR-0024> ;
    skos:definition "Points to the category that was coded for the export-side participation. (CodedParticipation -> CodedPlayerCategory) The basis of assignment differs by value: soe_vendor, government and private_firm were assigned by an organization lookup, epc_contractor and investor from event evidence."@en,
        "수출 측 참여에 코딩된 범주를 가리킨다. (CodedParticipation → CodedPlayerCategory) 부여 근거가 값마다 다르다 — soe_vendor·government·private_firm 은 조직 조회로, epc_contractor·investor 는 사건 증거로 부여됐다 (ADR-0024 맥락)."@ko ;
    skos:scopeNote "It preserves the source data — it does not change the values or the 1,026 coding results. The engagement roles coded for the participant are carried by hasEngagementRole."@en,
        "원자료 보존이다 — 값과 1,026건의 코딩 결과를 바꾸지 않는다 (ADR-0024 §5). 참여자에게 코딩된 관여 역할은 hasEngagementRole 이 진다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ09" .

nuproc:hasCounterpartyRole a owl:ObjectProperty ;
    rdfs:label "has counterparty role"@en ;
    dcterms:source "docs/adr/ADR-0002-role-vocabulary.md" ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0014> ;
    skos:definition "Points to the functional role coded for the counterparty side of that event: a coded claim about what the counterparty did there, recorded on the participation. (CodedParticipation -> CounterpartyRole)"@en,
        "그 사건의 상대측에 코딩된 기능 역할을 가리킨다 — 상대측이 거기서 한 일에 대한 코딩된 주장이며, 참여에 기록된다. (CodedParticipation → CounterpartyRole)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ03;CQ09;CQ11" .

nuproc:hasEngagementChannel a owl:ObjectProperty ;
    rdfs:label "has engagement channel"@en ;
    dcterms:source "codebook activity_type"@en ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0018> ;
    skos:definition "Points to the channel coded for an engagement-event cluster, a component of its clustering key. (EngagementCluster -> EngagementChannel)"@en,
        "관여 사건 군집에 코딩된 채널을 가리킨다 — 군집 키의 한 요소다. (EngagementCluster → EngagementChannel)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ01;CQ09;CQ10" .

nuproc:hasEngagementIdentification a owl:ObjectProperty ;
    rdfs:label "has engagement identification"@en ;
    dcterms:source "evaluation/coding/v3.0/VALIDATION_PROTOCOL.md §2.5" ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040>,
        <https://w3id.org/nuproc/adr/ADR-0044> ;
    skos:definition "Points to the state of the identification of a cluster with one engagement. (EngagementCluster -> EngagementIdentificationStatus) The cluster carries the state, not the engagement: what is identified is the correspondence between the cluster and an engagement. The asserted state is the value given by the cluster's final identification claim (ADR-0044)."@en,
        "군집이 관여 하나로 식별된 근거의 상태를 가리킨다. (EngagementCluster → EngagementIdentificationStatus) 상태는 관여가 아니라 군집이 진다 — 식별되는 것은 군집과 관여의 대응이다. 단언된 상태는 그 군집의 최종 식별 주장이 준 값이다 (ADR-0044)."@ko ;
    skos:scopeNote "Pattern layer: at most one per cluster, from this vocabulary; a cluster that reports an engagement has a state, and the state is not merged; at most one final identification claim, whose value is the state (EngagementClusterShape, IdentificationClaimShape). Profile: a NuProc cluster that carries a state has its final identification claim (EngagementClusterProfileShape). Whether every cluster has a state is a matter of load completeness, counted by check_kg"@en,
        "패턴 층: 군집마다 최대 하나 · 이 어휘의 값 · 관여를 보도하는 군집은 상태를 갖고 그 상태는 merged 가 아니다 · 최종 식별 주장은 많아야 하나이고 그 값이 상태다 (EngagementClusterShape · IdentificationClaimShape). 프로파일: 상태를 진 NuProc 군집은 최종 식별 주장이 있다 (EngagementClusterProfileShape). 모든 군집이 상태를 가졌는가는 적재 완결성이라 check_kg 가 센다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ18" .

nuproc:hasEngagementRole a owl:ObjectProperty ;
    rdfs:label "has engagement role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §3" ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0024>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Points to an engagement role type coded for the export-side participant of this event: a coded claim about a role that participant has in the engagement this event reports, whether or not that engagement took place, recorded on the participation, which is an information entity. It may have several values, with no priority among them. (CodedParticipation -> EngagementRoleType) Assigned from event evidence only, never by an organization lookup."@en,
        "이 사건의 수출 측 참여자에게 코딩된 관여 역할 유형을 가리킨다 — 그 참여자가 이 사건이 보도한 관여에서 지니는 역할에 대한 코딩된 주장이며 (그 관여가 일어났는지와 무관하다), 정보 개체인 참여에 기록된다. 값이 여럿일 수 있고 우선순위가 없다. (CodedParticipation → EngagementRoleType) 사건 증거로만 부여한다 — 조직 조회로 부여하지 않는다."@ko ;
    skos:scopeNote "Replaces hasEngagementFunction of v0.7.0 (one value, chosen by a priority rule). For a resolved participation in a cluster whose final occurrence status is occurred, each value supports a real-world role individual that the organization bears in the case, realized in the engagement that the cluster reports; a merged cluster reports no engagement, so its values support the role but yield no realization. The values of any other cluster (planned, denied or unclear, or stating no status) support no role, and their role claims stay claims"@en,
        "0.7.0 의 hasEngagementFunction (값 하나, 우선순위 규칙) 을 대신한다 (ADR-0040 §3). 최종 발생 상태가 occurred 인 군집의 해소된 참여에서는 값마다 그 조직이 그 사례에서 지니는 실세계 역할 개체를 뒷받침하고, 그 역할은 군집이 보도한 관여에서 실현된다 — 병합 군집은 관여를 보도하지 않으므로 그 값은 역할을 뒷받침하되 실현을 낳지 않는다. 다른 군집 (예정 · 부인 · 불명, 또는 상태를 적지 않은 군집) 의 값은 역할을 뒷받침하지 않고, 그 역할 주장은 주장으로 남는다 (ADR-0041 덧붙임 4 · 5)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ18" .

nuproc:hasEventType a owl:ObjectProperty ;
    rdfs:label "has event type"@en ;
    dcterms:source "codebook primary_code"@en ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0020> ;
    skos:definition "Points to the event type coded for an engagement-event cluster, a component of its clustering key. (EngagementCluster -> EventType)"@en,
        "관여 사건 군집에 코딩된 사건 유형을 가리킨다 — 군집 키의 한 요소다. (EngagementCluster → EventType)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ10;CQ11" .

nuproc:hasFinalIdentificationClaim a owl:ObjectProperty ;
    rdfs:label "has final identification claim"@en ;
    dcterms:source "docs/adr/ADR-0044-case-process-identification-claims-names-participant.md §2.2" ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:IdentificationClaim ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0044> ;
    skos:definition "Points to the claim adopted for the identification status asserted on this cluster: the claim on which the asserted value rests. (EngagementCluster -> IdentificationClaim) At most one; when present, its value is the cluster's identification status (SHACL). A cluster in NuProc data that carries an identification status has exactly one (profile). Claims that were not adopted remain in the graph as non-final claims."@en,
        "이 군집에 단언된 식별 상태에 대해 채택된 주장을 가리킨다 — 단언된 값이 기대는 주장. (EngagementCluster → IdentificationClaim) 많아야 하나이고, 있으면 그 주장의 값이 군집의 식별 상태다 (SHACL). 식별 상태를 진 NuProc 자료의 군집은 정확히 하나를 갖는다 (프로파일). 채택되지 않은 주장은 최종이 아닌 주장으로 그래프에 남는다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ18" .

nuproc:hasFinalOccurrenceClaim a owl:ObjectProperty ;
    rdfs:label "has final occurrence claim"@en ;
    dcterms:source "docs/adr/ADR-0041-v090-occurrence-consortium.md §1" ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:OccurrenceClaim ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0041> ;
    skos:definition "Points to the claim adopted for the occurrence status asserted on this cluster: the claim on which the asserted value rests. (EngagementCluster -> OccurrenceClaim) There is exactly one when a value is asserted, and its claimed occurrence is that value (SHACL). Claims that were not adopted remain in the graph as non-final claims."@en,
        "이 군집에 단언된 발생 상태 값에 대해 채택된 주장을 가리킨다 — 단언된 값이 기대는 주장. (EngagementCluster → OccurrenceClaim) 단언된 값이 있으면 정확히 하나가 있고, 그 주장의 claimedOccurrence 는 그 값이다 (SHACL). 채택되지 않은 주장은 최종이 아닌 주장으로 그래프에 남는다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ20" .

nuproc:hasFinalResolutionClaim a owl:ObjectProperty ;
    rdfs:label "has final resolution claim"@en ;
    dcterms:source "docs/adr/ADR-0043-resolution-claims.md §2.1" ;
    rdfs:domain nuproc:ActorReference ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:ResolutionClaim ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0043> ;
    skos:definition "Points to the claim adopted for the resolution status and organization asserted on this reference: the claim on which the asserted values rest. (ActorReference -> ResolutionClaim) At most one; when present, its status and organization are the reference's (SHACL). A reference in NuProc data has exactly one (profile). Claims that were not adopted remain in the graph as non-final claims."@en,
        "이 지칭에 단언된 해소 상태와 조직에 대해 채택된 주장을 가리킨다 — 단언된 값이 기대는 주장. (ActorReference → ResolutionClaim) 많아야 하나이고, 있으면 그 주장의 상태와 조직이 지칭의 것과 같다 (SHACL). NuProc 자료의 지칭은 정확히 하나를 갖는다 (프로파일). 채택되지 않은 주장은 최종이 아닌 주장으로 그래프에 남는다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ17" .

nuproc:hasFinalRoleClaim a owl:ObjectProperty ;
    rdfs:label "has final role claim"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §3" ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:RoleClaim ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0039>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Points to the claim adopted for an engagement role value asserted on this coded participation: the claim on which the asserted value rests. (CodedParticipation -> RoleClaim) There is exactly one for each asserted role value, and its claimed role is that value (SHACL). Claims that were not adopted remain in the graph as non-final claims."@en,
        "이 코딩된 참여에 단언된 역할 값에 대해 채택된 주장을 가리킨다 — 단언된 값이 기대는 주장. (CodedParticipation → RoleClaim) 단언된 역할 값마다 정확히 하나가 있고, 그 주장의 claimedRole 은 그 값이다 (SHACL). 채택되지 않은 주장은 최종이 아닌 주장으로 그래프에 남는다."@ko ;
    skos:scopeNote "In NuProc data the adopted claim is the model coding's (coding protocol v3), except in the events that people checked, where it is the claim of the adjudicated human reference (the coders' value where they agreed, the author's adjudication where they did not). The model is evaluated against its frozen output, not against the graph's final values"@en,
        "NuProc 자료에서 채택된 주장은 모델 코딩 (코딩 규약 v3) 의 것이고, 사람이 점검한 표본 사건에서는 사람의 조정 기준 (두 코더가 같은 칸은 그 값, 갈린 칸은 저자의 조정) 의 것이다. 모델 평가는 그래프의 최종값이 아니라 동결된 모델 출력에서 센다 (ADR-0040)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ19" .

nuproc:hasObservedPlayerRole a owl:ObjectProperty ;
    rdfs:label "has observed player role"@en ;
    dcterms:source "Design set: 49 events whose article-level records disagree on the coded player category"@en,
        "설계 세트: 기사 수준 기록의 코딩된 player 범주가 갈리는 사건 49건"@ko ;
    rdfs:domain nuproc:EventRecord ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0019> ;
    skos:definition "Points to the export-side coded player category as observed at record level. (EventRecord -> CodedPlayerCategory)"@en,
        "기록 수준에서 관측된 수출 측 코딩 범주를 가리킨다. (EventRecord → CodedPlayerCategory)"@ko ;
    skos:scopeNote "It can differ from the event-level hasSelectedPlayerRole (49 cases). This difference reveals the dedup loss"@en,
        "사건 수준 hasSelectedPlayerRole 과 다를 수 있다 (49건). 이 차이가 dedup 손실을 드러낸다 (ADR-0019 §4)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02" .

nuproc:hasOccurrenceStatus a owl:ObjectProperty ;
    rdfs:label "has occurrence status"@en ;
    dcterms:source "docs/adr/ADR-0041-v090-occurrence-consortium.md §1" ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0041> ;
    skos:definition "Points to the occurrence status of the engagement reported by this cluster's records: a coded value. (EngagementCluster -> OccurrenceStatus) At most one per cluster (SHACL)."@en,
        "이 군집의 기록들이 보도하는 관여의 발생 상태를 가리킨다 — 코딩된 값이다. (EngagementCluster → OccurrenceStatus) 군집마다 많아야 하나다 (SHACL)."@ko ;
    skos:scopeNote "Pattern layer: at most one per cluster, a value of this vocabulary, a cluster that reports an engagement has the value occurred (a cluster whose value is not occurred, or that has none, reports no engagement), the value has one final claim (EngagementClusterShape), and only a cluster with the value occurred grounds a role (EngagementRoleShape). Profile: every NuProc cluster has a value (EngagementClusterProfileShape, also counted by check_kg)"@en,
        "패턴 층: 군집마다 최대 하나 · 이 어휘의 값 · 관여를 보도하는 군집은 값이 occurred 다 (값이 occurred 가 아니거나 없으면 관여를 보도하지 않는다) · 값의 최종 주장 하나 (EngagementClusterShape) · 값이 occurred 인 군집만 역할의 근거가 된다 (EngagementRoleShape). 프로파일: NuProc 의 군집마다 값이 있다 (EngagementClusterProfileShape — check_kg 도 센다)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ20" .

nuproc:hasOrganizationType a owl:ObjectProperty ;
    rdfs:label "has organization type"@en ;
    dcterms:source "docs/adr/ADR-0014-two-role-axes.md (decision A)"@en,
        "ADR-0014 결정 A"@ko ;
    rdfs:domain nuproc:Organization ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0014> ;
    skos:definition "Points to the fixed type of an organization. (Organization -> OrganizationType)"@en,
        "조직의 고정 유형을 가리킨다. (Organization → OrganizationType)"@ko ;
    skos:scopeNote "Values come from the actor registry. They are not a coding output but values confirmed by the researcher"@en,
        "행위자 레지스트리에서만 값이 채워진다. 코딩 산출물이 아니라 연구자 확정분이다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02" .

nuproc:hasParticipantReference a owl:ObjectProperty ;
    rdfs:label "has participant reference"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md" ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:ActorReference ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0031> ;
    rdfs:subPropertyOf nuproc:hasActorReference ;
    skos:definition "Points to the reference that stands in the participant slot because no individual organization has been identified for it: the source did not name one (UnnamedActorReference), or no decision has yet matched the named one (DefiniteOrganizationReference, rstat:unresolved). Exclusive with namesParticipant. (CodedParticipation -> ActorReference)"@en,
        "참여자 슬롯에 선 지칭을 가리킨다 — 개별 조직이 식별되지 않았기 때문이다: 출처가 이름을 대지 않았거나(UnnamedActorReference), 이름은 있으나 아직 어느 결정도 대조하지 않았다(DefiniteOrganizationReference, rstat:unresolved). namesParticipant 와 배타적이다 (ADR-0013). (CodedParticipation → ActorReference)"@ko ;
    skos:scopeNote "It is exclusive with namesParticipant. A reference is not an organization, so it is not placed on the same property. It is a subproperty of hasActorReference"@en,
        "namesParticipant 와 배타적이다. 지칭은 조직이 아니므로 같은 속성에 두지 않는다. hasActorReference 의 하위 속성이다 (ADR-0031)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" .

nuproc:hasParticipation a owl:ObjectProperty ;
    rdfs:label "has participation"@en ;
    dcterms:source "docs/adr/ADR-0001-analytic-unit.md" ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:CodedParticipation ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013> ;
    skos:definition "Points to a participation that is a component of an engagement-event cluster. (EngagementCluster -> CodedParticipation)"@en,
        "관여 사건 군집의 구성요소인 참여를 가리킨다. (EngagementCluster → CodedParticipation)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ03;CQ04" .

nuproc:hasResolutionStatus a owl:ObjectProperty ;
    rdfs:label "has resolution status"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md; docs/adr/ADR-0010-khnp-kepco-merge.md" ;
    rdfs:domain nuproc:ActorReference ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0010>,
        <https://w3id.org/nuproc/adr/ADR-0026>,
        <https://w3id.org/nuproc/adr/ADR-0031> ;
    skos:definition "Points to the resolution state of a participant reference. (ActorReference -> ResolutionStatus) Organizations carry no resolution state: what is resolved is the reference, not the organization. The admissible states follow from the kind of the reference. The asserted status is the value given by the reference's final resolution claim."@en,
        "참여자 지칭의 해소 상태를 가리킨다. (ActorReference → ResolutionStatus) 조직은 해소 상태를 갖지 않는다 — 해소되는 것은 지칭이지 조직이 아니다 (ADR-0026). 허용되는 상태는 지칭의 종류에서 나온다 (ADR-0031 §3). 단언된 상태는 그 지칭의 최종 해소 주장이 준 값이다 (ADR-0043)."@ko ;
    skos:scopeNote "In v0.3 Organization was removed from the domain. In v0.5 the domain was widened to all participant references (ActorReference) — resolved gains a bearer"@en,
        "v0.3 에서 정의역에서 Organization 을 뺐다 (ADR-0026 §3). v0.5 에서 정의역을 모든 참여자 지칭(ActorReference)으로 넓혔다 — resolved 에 담지자가 생긴다 (ADR-0031)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ17" .

nuproc:hasSampleSize a owl:DatatypeProperty ;
    rdfs:label "has sample size"@en ;
    dcterms:source "docs/adr/ADR-0009-reliability-reporting.md" ;
    rdfs:domain nuproc:DataQualityMeasurement ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:positiveInteger ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0016> ;
    skos:definition "The number of sampled items used for a quality measurement. (DataQualityMeasurement -> xsd:positiveInteger)"@en,
        "품질 측정에 사용된 표본 수. (DataQualityMeasurement → xsd:positiveInteger)"@ko ;
    skos:scopeNote "DQV has no corresponding property, so it is defined locally"@en,
        "DQV 에 대응 속성이 없어 자체 정의한다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ16" .

nuproc:hasSelectedPlayerRole a owl:ObjectProperty ;
    rdfs:label "has selected player role"@en ;
    dcterms:source "docs/adr/ADR-0019-event-record-identity.md" ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0024> ;
    skos:definition "Points to the event-level coded category that deduplication selected. (EngagementCluster -> CodedPlayerCategory)"@en,
        "dedup 이 고른 사건 수준 코딩 범주를 가리킨다. (EngagementCluster → CodedPlayerCategory)"@ko ;
    skos:scopeNote "Introduced in v0.3. Previously, event-level values were also carried by hasPlayerRole (domain CodedParticipation), so inference classified all 1,026 events as CodedParticipation."@en,
        "v0.3 에서 들어왔다. 종전에는 사건 수준 값도 hasPlayerRole(domain CodedParticipation)로 실려, 추론이 1,026 사건 전건을 CodedParticipation 으로 분류했다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ09" .

nuproc:hasSide a owl:ObjectProperty ;
    rdfs:label "has side"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §4" ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0036>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Indicates which side of the engagement a participation is on: the export side or the host side. (CodedParticipation -> SideRole)"@en,
        "참여가 관여의 어느 쪽 (수출 측 · 발주 측) 인지 가리킨다. (CodedParticipation → SideRole)"@ko ;
    skos:scopeNote "A property of the side, not part of the participation's identity. Optional in the pattern layer and at most one per participation: a participation from a source without an export and a host side is told apart by its side key. The NuProc profile requires it on every participation"@en,
        "쪽의 속성이지 참여의 동일성의 일부가 아니다. 패턴 층에서는 선택이며 참여마다 최대 하나다 — 수출 · 발주 측이 없는 원천의 참여는 sideKey 로 쪽을 가른다. NuProc 프로파일은 모든 참여에 요구한다 (ADR-0036 · ADR-0040 §4)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ03" .

nuproc:hasSourceMention a owl:DatatypeProperty ;
    rdfs:label "has source mention"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md (prevention of information loss)"@en,
        "ADR-0008 정보손실 방지"@ko ;
    rdfs:domain nuproc:ActorReference ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0017>,
        <https://w3id.org/nuproc/adr/ADR-0031> ;
    skos:definition "The label by which the loaded dataset referred to the participant, as it stands in that dataset. (ActorReference -> xsd:string) In the NuProc design data this is the coded actor label player_canon after first-stage normalisation, possibly truncated at 40 characters, not an excerpt of article text."@en,
        "적재된 자료가 참여자를 가리킨 표기 — 그 자료에 있는 그대로. (ActorReference → xsd:string) NuProc 설계 자료에서는 1단계 정규화를 거친 코딩 행위자 표기(player_canon)이며 40자에서 잘린 것이 있다. 기사 본문 발췌가 아니다."@ko ;
    skos:scopeNote "Not an excerpt of article text but the coded actor label (record-level coded data). Labels that refer to persons are not carried — the reference, status and link are carried. Up to v0.4, 'verbatim' in the definition was not true"@en,
        "기사 본문 발췌가 아니라 코딩된 행위자 표기다 ((iii)층). 인물을 가리키는 표기는 싣지 않는다 (ADR-0017) — 지칭·상태·링크는 싣는다. v0.4 까지 정의문의 *verbatim* 은 사실이 아니었다 (ADR-0031 §7)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" .

nuproc:hasTypeClassificationStatus a owl:ObjectProperty ;
    rdfs:label "has type classification status"@en ;
    dcterms:source "docs/adr/ADR-0025-organization-type-axes.md" ;
    rdfs:domain nuproc:Organization ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0025> ;
    skos:definition "Points to the classification state of the organization-type assignment. (Organization -> TypeClassificationStatus)"@en,
        "조직 유형 부여의 분류 상태를 가리킨다. (Organization → TypeClassificationStatus)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02" .

nuproc:hasTypeSource a owl:DatatypeProperty ;
    rdfs:label "has type source"@en ;
    dcterms:source "docs/adr/ADR-0025-organization-type-axes.md; registry/actor_registry.csv (type_source)" ;
    rdfs:domain nuproc:Organization ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0025> ;
    skos:definition "The source of the organization-type assignment, transcribed from the actor registry's type_source field."@en,
        "조직 유형 부여의 출처. actor registry 의 type_source 를 그대로 싣는다."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02" .

nuproc:justifyingCompetencyQuestion a owl:AnnotationProperty ;
    rdfs:label "justifying competency question"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:measuredViolations a owl:AnnotationProperty ;
    rdfs:label "measured violations on the design set"@en ;
    rdfs:comment "Informational: what the design set showed for this rule. It does not set sh:severity."@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:measuresProperty a owl:ObjectProperty ;
    rdfs:label "measures property"@en ;
    dcterms:source "docs/adr/ADR-0009-reliability-reporting.md" ;
    rdfs:comment "range is deliberately left unasserted. Its value is a property or a class, so asserting rdfs:range would be metamodelling and would push the ontology out of OWL 2 DL, widening the scope of the consistency check beyond our own axioms (the same concern for which importing the RDF Data Cube vocabulary was rejected). SHACL checks instead, locally, that a measurement has exactly one value of each and that the value of appliesToLayer is one of the three analytic layers; what kind of term measuresProperty names is not checked (see nuproc-shapes.ttl)."@en ;
    rdfs:domain nuproc:DataQualityMeasurement ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0016> ;
    skos:definition "Points to what a quality measurement measured: a property, or, for the measurements of whether clusters are valid events and correctly merged, the class EngagementCluster. (DataQualityMeasurement -> rdf:Property or rdfs:Class)"@en,
        "품질 측정치가 무엇을 잰 것인지 가리킨다 — 속성, 또는 군집이 타당한 사건인지 · 바르게 묶였는지를 잰 측정에서는 클래스 EngagementCluster. (DataQualityMeasurement → rdf:Property 또는 rdfs:Class)"@ko ;
    skos:scopeNote "DQV has no corresponding property, so it is defined locally (vocabulary file checked, 2026-08-15)"@en,
        "DQV 에 대응 속성이 없어 자체 정의한다 (어휘 파일 확인, 2026-08-15)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ16" .

nuproc:monthRelativeToT0 a owl:DatatypeProperty ;
    rdfs:label "month relative to T0"@en ;
    dcterms:source "data month_rel_T0"@en,
        "데이터 month_rel_T0"@ko ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0015> ;
    skos:definition "The number of months relative to the reference point of the case. (EngagementCluster -> xsd:integer)"@en,
        "사례 기준시점 대비 상대 개월 수. (EngagementCluster → xsd:integer)"@ko ;
    skos:scopeNote "T0 itself is not in the three input files of the source dataset, so it is not represented; this is a known limitation"@en,
        "T0 자체는 입력 3파일에 없다 — 표현하지 않는다 (한계로 기록)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ12" .

nuproc:namesParticipant a owl:ObjectProperty ;
    rdfs:label "names participant"@en ;
    dcterms:source "player_canon in the source dataset"@en ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:Organization ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0032> ;
    skos:definition "Points to the organization that a participation denotes as its participant. (CodedParticipation -> Organization) The participation is part of a reported cluster; the organization is a real legal person or institution, or a group of them acting together as one party."@en,
        "참여 기록이 참여자로 지시하는 조직을 가리킨다. (CodedParticipation → Organization) 참여는 보고된 군집의 구성요소이고, 조직은 실재하는 법인·기관, 또는 함께 한 당사자로 움직이는 그 무리다."@ko ;
    skos:scopeNote "In this dataset only the export side has a value, because the source data have no counterparty organization column. The model also allows at most one of the two slots on the host side. A participation has at most one participant (pattern): a group of organizations acting together as one party (a consortium) is one organization, whose members are linked with org:hasMember. The reference of a resolved participation stands on hasActorReference and points to this organization with resolvedTo. This differs from participation in the real-world layer (RO has participant, from an engagement to an organization): this property is the organization that a participation, an information entity, denotes"@en,
        "이 자료에서는 수출 측에만 값이 있다 — 원자료에 상대 조직 열이 없다. 모델은 발주 측에도 두 슬롯 중 최대 하나를 허용한다 (ADR-0013 개정 2026-09-16). 참여마다 참여자는 많아야 하나다 (패턴 — ADR-0041 §3): 함께 한 당사자로 움직인 조직 무리 (컨소시엄) 는 조직 하나이고 구성원은 org:hasMember 로 잇는다. 해소된 참여의 지칭은 hasActorReference 에 서고 resolvedTo 로 이 조직을 가리킨다 (ADR-0031). 실세계 층의 참여 (RO has participant — 관여 → 조직) 와 다르다: 이 속성은 정보 개체인 참여가 지시하는 조직이다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ14;CQ15" .

nuproc:ontocleanDependence a owl:AnnotationProperty ;
    rdfs:label "OntoClean dependence"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:ontocleanIdentityCriterion a owl:AnnotationProperty ;
    rdfs:label "OntoClean identity criterion"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:ontocleanRigidity a owl:AnnotationProperty ;
    rdfs:label "OntoClean rigidity"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:ontocleanUnity a owl:AnnotationProperty ;
    rdfs:label "OntoClean unity"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:reportsEngagement a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "reports engagement"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §2" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( nuproc:EventRecord nuproc:EngagementCluster ) ] ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:Engagement ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Points to the real-world engagement that this record or cluster reports. (EventRecord or EngagementCluster -> Engagement) Functional: a record or a cluster reports at most one engagement. A cluster that a person found to merge two or more engagements (identification state merged), and a cluster whose final occurrence status is not occurred (planned, denied or unclear), has none, and neither do its records."@en,
        "이 기록 · 군집이 보도한 실세계 관여를 가리킨다. (EventRecord · EngagementCluster → Engagement) 함수적이다 — 기록 · 군집은 관여를 많아야 하나 보도한다. 사람이 둘 이상의 관여를 묶었다고 판단한 군집 (식별 상태 merged) 과 최종 발생 상태가 occurred 가 아닌 군집 (planned · denied · unclear) 은 이 속성을 갖지 않고, 그 기록도 갖지 않는다."@ko ;
    skos:scopeNote "A subproperty of IAO is about (obo:IAO_0000136), asserted in the alignments module. A cluster and its records report the same engagement (SHACL). It differs from describesEvent (record to cluster), which is a grouping relation inside the information layer"@en,
        "IAO 의 is about (obo:IAO_0000136) 의 하위 속성이다 (alignments 모듈). 군집과 그 기록은 같은 관여를 보도한다 (SHACL). describesEvent (기록 → 군집) 와 다르다 — 그것은 정보 층 안의 묶음 관계다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ06;CQ18" .

nuproc:resolvedTo a owl:ObjectProperty ;
    rdfs:label "resolved to"@en ;
    dcterms:source "docs/adr/ADR-0031-reference-resolution-completed.md; docs/adr/ADR-0022-entity-resolution-criteria.md §6 (from registry rows decided by a human); docs/adr/ADR-0040-v080-real-world-layer-roles.md §5 and docs/adr/ADR-0041-v090-occurrence-consortium.md §3 (for candidate-set labels, from event-level decisions made by the model coding under coding protocol v3 or by the author, each recorded as a resolution claim: ADR-0043)"@en,
        "ADR-0031; ADR-0022 §6 (사람이 판정한 레지스트리 행에서); ADR-0040 §5 · ADR-0041 §3 (후보 집합 표기는 사건별 해소 결정에서 — 코딩 규약 v3 의 모델 코딩 또는 저자가 사건마다 내린 판정이며, 판정마다 해소 주장으로 남는다 — ADR-0043)"@ko ;
    rdfs:domain nuproc:ActorReference ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:Organization ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0022>,
        <https://w3id.org/nuproc/adr/ADR-0031> ;
    skos:definition "Points to the organization that the reference's final resolution claim identified as the participant this reference was used for. (ActorReference -> Organization) Present exactly when the reference's status is resolved; the same organization is then the namesParticipant of the participation."@en,
        "지칭의 최종 해소 주장이 이 지칭을 어느 조직으로 판정했는지를 가리킨다. (ActorReference → Organization) 상태가 resolved 일 때 정확히 있고, 그 참여의 namesParticipant 와 같은 조직이다."@ko ;
    skos:scopeNote "Not lexical denotation — a person label in an organization slot is resolved to that person's organization but does not denote that organization. The two or more candidates of an unresolvable reference are linked by hasCandidateOrganization. No property chain leading to namesParticipant is defined"@en,
        "어휘적 지시가 아니다 — 조직 슬롯의 인물 표기는 그 인물의 조직으로 해소되지만 그 조직을 지시하지 않는다. 해소 불가 지칭의 후보 둘 이상은 hasCandidateOrganization 이 잇는다. namesParticipant 로 가는 속성 사슬은 두지 않는다 (ADR-0031 대안 A)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ17" .

nuproc:roleClass a owl:AnnotationProperty ;
    rdfs:label "role class"@en ;
    rdfs:comment "Links a value of the engagement role type or side role scheme to the OWL class of the real-world role it stands for. It is an annotation property, so the SKOS concept and the OWL class stay distinct entities (no punning). A coded value on a participation is information; a role individual of the linked class is asserted only where the participant organization was resolved."@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:ruleKind a owl:AnnotationProperty ;
    rdfs:label "rule kind"@en ;
    rdfs:comment "The kind of rule a shape encodes: 'ontology invariant' (sh:Violation), 'assertion rule' (sh:Violation: a rule for what the real-world layer asserts, not a condition of existence) or 'domain regularity' (sh:Warning). Severity follows the kind, not the measured rate."@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:shapeLayer a owl:AnnotationProperty ;
    rdfs:label "shape layer"@en ;
    rdfs:comment "The layer a shape belongs to: 'pattern' (domain-neutral constraints that follow from the definitions of the reusable patterns) or 'profile' (constraints that encode the NuProc dataset and codebook). An external dataset is validated against the pattern layer."@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:sideKey a owl:DatatypeProperty ;
    rdfs:label "side key"@en ;
    dcterms:source "docs/adr/ADR-0036-direction-optional-pattern.md (a reuse requirement rather than a competency question)"@en,
        "재사용 요구 — EVALUATION_PROTOCOL §8 체크리스트 1 (CQ 또는 reuse requirement); ADR-0036 D12"@ko ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0036> ;
    skos:definition "The source's designation of the side of a two-sided engagement event that this participation is on, for example the name of the field or element family under which the source records that party. It records structure, not initiative. (CodedParticipation -> xsd:string) The two participations of one event never share a side key: a shared key would make them the same side. It is needed only by a participation that carries no side role."@en,
        "원천이 이 참여가 선 쪽에 붙인 이름 — 예를 들어 원천이 그 당사자를 적는 필드나 요소 계열의 이름. 구조를 적고, 주도를 적지 않는다. (CodedParticipation → xsd:string) 한 사건의 두 참여는 같은 sideKey 를 갖지 않는다 — 같으면 같은 쪽이 된다. 측 역할이 없는 참여에만 필요하다."@ko ;
    skos:scopeNote "Not the same as NationalSideReference — that is a kind of reference to a participant (an expression that denotes a national side rather than an organization), whereas sideKey is the name of the structure by which the source divides the parties of one record into two sides. It does not denote a participant. When the source separates the export side from the host side, the side value names the side and no side key is needed — every participation in the NuProc data carries its side, so the NuProc data carry no sideKey. It is justified by a reuse requirement, not by a competency question"@en,
        "NationalSideReference 와 다르다 — 그것은 참여자를 가리킨 지칭의 종류(조직이 아니라 국가 단위로 묶어 가리킨 표기)이고, sideKey 는 원천이 한 레코드의 당사자를 두 쪽으로 가른 구조의 이름이다. 참여자를 가리키지 않는다. 원천이 수출 · 발주 측을 가르면 측 값이 쪽의 이름이므로 필요 없다 — NuProc 자료의 참여는 모두 측을 가지므로 sideKey 를 싣지 않는다 (ADR-0036 §6). CQ 가 아니라 재사용 요구로 정당화한다 (ADR-0036 D12)"@ko .

nuproc:status a owl:AnnotationProperty ;
    rdfs:label "status"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> .

nuproc:supportedByClaim a owl:ObjectProperty ;
    rdfs:label "supported by claim"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §2" ;
    rdfs:domain nuproc:EngagementRole ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:RoleClaim ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Points to a final role claim on which this role is asserted: a claim that the role's bearer has this role in an engagement reported by a cluster of the role's case whose final occurrence status is occurred. (EngagementRole -> RoleClaim) A facet role has one or more, and each keeps the provenance of the real-world assertion."@en,
        "이 역할 개체를 단언하게 한 최종 역할 주장을 가리킨다 — 역할의 담지 조직이, 최종 발생 상태가 occurred 인 그 사례의 군집이 보도한 한 관여에서 이 역할을 지닌다는 주장. (EngagementRole → RoleClaim) facet 역할은 하나 이상을 갖고, 실세계 단언의 출처가 주장마다 남는다."@ko ;
    skos:scopeNote "A side role has no claim: the side comes from the structure of the source data (the player family is the export side)"@en,
        "측 역할에는 주장이 없다 — 측은 원자료의 구조 (player 계열 = 수출 측) 에서 온다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ19" .

nuproc:uniqueSourceArticleCount a owl:DatatypeProperty ;
    rdfs:label "unique source article count"@en ;
    dcterms:source "The source dataset (83 cases in which one article contributes more than once to the same event)"@en,
        "DATA_AUDIT §2.2 (차이 83건)"@ko ;
    rdfs:domain nuproc:EngagementCluster ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0019> ;
    skos:definition "The number of unique articles whose records belong to this cluster. It differs from the number of records, which counts mentions, and merging the two would lose information. (EngagementCluster -> xsd:nonNegativeInteger)"@en,
        "이 군집에 속한 기록들의 고유 기사 수. 기록 수(언급 수)와 다른 값이며 합치면 정보가 사라진다. (EngagementCluster → xsd:nonNegativeInteger)"@ko ;
    skos:scopeNote "The mention count is obtained by counting instances of EventRecord — a derivable value is not loaded separately"@en,
        "언급 수는 EventRecord 를 세어 얻는다 — 파생 가능한 값을 따로 적재하지 않는다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ08" .

nuproc:usedCodebookVersion a owl:ObjectProperty ;
    rdfs:label "used codebook version"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md" ;
    rdfs:domain nuproc:CodingActivity ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:CodebookVersion ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003> ;
    rdfs:subPropertyOf prov:used ;
    skos:definition "Points to the codebook edition that a coding activity used. (CodingActivity -> CodebookVersion)"@en,
        "코딩 활동이 사용한 코드북 판을 가리킨다. (CodingActivity → CodebookVersion)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ07" .

nuproc:usedPromptSpecification a owl:ObjectProperty ;
    rdfs:label "used prompt specification"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md" ;
    rdfs:domain nuproc:CodingActivity ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:PromptSpecification ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003> ;
    rdfs:subPropertyOf prov:used ;
    skos:definition "Points to the prompt specification that a coding activity used. (CodingActivity -> PromptSpecification)"@en,
        "코딩 활동이 사용한 프롬프트 명세를 가리킨다. (CodingActivity → PromptSpecification)"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ07" .

<http://purl.obolibrary.org/obo/RO_0000057> a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/ro.owl> .

<http://purl.obolibrary.org/obo/RO_0000081> a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/ro.owl> .

dqv:QualityMeasurement a owl:Class .

org:Organization a owl:Class .

nuproc:AnonymousSingularReference a owl:Class ;
    rdfs:label "Anonymous Singular Reference"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md (empirical count of subtypes: 6 kinds / 6 cases)"@en,
        "ADR-0008 하위 유형 실측 (6종 / 6건)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013> ;
    rdfs:subClassOf nuproc:UnnamedActorReference ;
    skos:definition "A reference denoting exactly one organization whose identity is not disclosed."@en,
        "정확히 하나의 조직을 가리키나 정체가 밝혀지지 않은 지칭"@ko ;
    skos:scopeNote "Design set: 9 kinds / 9 cases, as confirmed during entity resolution. The initial empirical count was 6 kinds / 6 cases"@en,
        "design 세트 9종 / 9건 (행위자 해소에서 확정). ADR-0008 초기 실측은 6종 / 6건 였다"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" ;
    nuproc:ontocleanDependence "+D Depends on CodedParticipation"@en,
        "+D CodedParticipation 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (the CodedParticipation in which the reference is used)"@en,
        "상위 클래스와 같다 (그 지칭이 쓰인 CodedParticipation — ADR-0031 §8)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One referring expression"@en,
        "+U 하나의 지칭 표현"@ko .

nuproc:CommercialSupplyRole a owl:Class ;
    rdfs:label "Commercial Supply Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "The role of commercially supplying equipment, components or services other than the major equipment."@en,
        "주기기 이외의 기자재 · 부품 · 서비스를 상업적으로 공급하는 역할."@ko ;
    skos:scopeNote "The real-world counterpart of erole:commercial_supply (nuproc:roleClass). Individuals are created only from the final claims of resolved participations, and each has one or more final role claims that support it (supportedByClaim)"@en,
        "erole:commercial_supply 의 실세계 대응 (nuproc:roleClass). 해소된 참여의 최종 주장에서만 개체를 만든다 — 개체마다 그것을 뒷받침하는 최종 역할 주장이 하나 이상 있다 (supportedByClaim)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:ConstructionContractRole a owl:Class ;
    rdfs:label "Construction Contract Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "The role of winning or performing an engineering, procurement and construction (EPC) contract."@en,
        "설계 · 조달 · 시공 (EPC) 을 수주하거나 수행하는 역할."@ko ;
    skos:scopeNote "The real-world counterpart of erole:construction_contract (nuproc:roleClass). Individuals are created only from the final claims of resolved participations, and each has one or more final role claims that support it (supportedByClaim)"@en,
        "erole:construction_contract 의 실세계 대응 (nuproc:roleClass). 해소된 참여의 최종 주장에서만 개체를 만든다 — 개체마다 그것을 뒷받침하는 최종 역할 주장이 하나 이상 있다 (supportedByClaim)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:DefiniteOrganizationReference a owl:Class ;
    rdfs:label "Definite Organization Reference"@en ;
    dcterms:source "docs/adr/ADR-0031-reference-resolution-completed.md; entity resolution of the design set (organization labels: 34 kinds, 567 cases · person labels: 3 kinds, 3 cases)"@en,
        "ADR-0031; ENTITY_RESOLUTION_REPORT §5.1 (조직 표기 34종 567건 · 인물 표기 3종 3건)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0031> ;
    rdfs:subClassOf nuproc:ActorReference ;
    owl:disjointWith nuproc:UnnamedActorReference ;
    skos:definition "An actor reference by which the source picked out one organization definitely: by its name, an abbreviation of it, or an office-holder standing for it. A group of organizations acting together as one party, such as a consortium, is one organization. Whether a recorded decision has identified which registered organization that is, is its resolution status (resolved or unresolved), not its kind."@en,
        "출처가 조직 하나를 확정적으로 가리킨 지칭 — 이름·약칭, 또는 그 조직을 대표하는 직위 보유자로. 함께 한 당사자로 움직이는 조직 무리 (컨소시엄 등) 도 조직 하나다. 어느 등록 조직인지를 기록된 결정이 식별했는지는 종류가 아니라 해소 상태(resolved 또는 unresolved)다."@ko ;
    skos:scopeNote "These are the references that use a label whose registry mention_kind is organization or person_in_org_slot, and the references that use a candidate-set label whose article evidence pointed to one organization, or to the candidates acting together as one party, in the event-by-event resolution. In the design set, all of them are resolved. A reference that has a name but has not yet been matched also belongs here (rstat:unresolved) — it is not placed under UnnamedActorReference. A definite reference resolves to one organization (pattern: at most one resolvedTo). A reference that names a consortium resolves to the consortium organization, whose members are linked with org:hasMember"@en,
        "레지스트리 mention_kind 가 organization · person_in_org_slot 인 표기를 쓴 지칭, 그리고 사건별 해소 (ADR-0040 §5 · ADR-0041 §3) 에서 기사 근거가 조직 하나, 또는 한 당사자로 함께 움직인 후보들을 가리킨 후보 집합 표기를 쓴 지칭이다. 설계 세트에서는 전부 resolved 다. 이름은 있으나 아직 대조되지 않은 지칭도 여기 속한다(rstat:unresolved) — UnnamedActorReference 로 두지 않는다. 확정 지칭은 조직 하나로 해소된다 (패턴 — resolvedTo 많아야 하나, ADR-0041 §3). 컨소시엄을 가리킨 지칭은 컨소시엄 조직으로 해소되고, 그 구성원은 org:hasMember 로 잇는다"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ17" ;
    nuproc:ontocleanDependence "+D Depends on CodedParticipation"@en,
        "+D CodedParticipation 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (ActorReference)"@en,
        "상위 클래스(ActorReference)와 같다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One referring expression"@en,
        "+U 하나의 지칭 표현"@ko .

nuproc:ExportSideRole a owl:Class ;
    rdfs:label "Export Side Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "The role of being on the export side of a procurement case: the side that sells a nuclear new build or its supply, financing or sponsorship."@en,
        "조달 사례에서 수출 측에 서는 역할 — 원전 또는 그 공급 · 금융 · 후원을 파는 쪽."@ko ;
    skos:scopeNote "In NuProc data the player family of the source is the export side: each (organization, case) with a resolved export-side participation in a cluster whose final occurrence status is occurred has one such role individual"@en,
        "NuProc 자료에서는 원자료의 player 계열이 수출 측이다 — 최종 발생 상태가 occurred 인 군집에 해소된 수출 측 참여가 있는 (조직, 사례) 마다 이 역할 개체가 하나 있다 (ADR-0041 덧붙임 4 · 5)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:FinancingRole a owl:Class ;
    rdfs:label "Financing Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "The role of providing or offering equity, financing or guarantees."@en,
        "지분 · 금융 · 보증을 제공하거나 제안하는 역할."@ko ;
    skos:scopeNote "The real-world counterpart of erole:financing (nuproc:roleClass). Individuals are created only from the final claims of resolved participations, and each has one or more final role claims that support it (supportedByClaim)"@en,
        "erole:financing 의 실세계 대응 (nuproc:roleClass). 해소된 참여의 최종 주장에서만 개체를 만든다 — 개체마다 그것을 뒷받침하는 최종 역할 주장이 하나 이상 있다 (supportedByClaim)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:HostSideRole a owl:Class ;
    rdfs:label "Host Side Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "The role of being on the host side of a procurement case: the country, owner or authorities procuring the new build."@en,
        "조달 사례에서 발주 (현지) 측에 서는 역할 — 원전을 사는 나라 · 사업주 · 당국 쪽."@ko ;
    skos:scopeNote "In the NuProc design data the host-side participant is never identified as an organization (there is no counterparty organization column), so this class has no individuals there. It is used for sources that record the host side as an organization"@en,
        "NuProc 설계 자료에서는 발주 측 참여자가 조직으로 식별되지 않으므로 (상대 조직 열이 없다) 이 클래스의 개체가 없다. 발주 측을 조직으로 적는 원천에서 쓰인다"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:NationalSideReference a owl:Class ;
    rdfs:label "National Side Reference"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013> ;
    rdfs:subClassOf nuproc:UnnamedActorReference ;
    skos:definition "A reference denoting a national side rather than an organization, such as 'the US side'. Confusing it with organization aggregates would contaminate cross-case organization queries."@en,
        "조직이 아니라 국가 단위로 묶어 가리키는 지칭 (예: 미국 측). 조직 집계와 혼동하면 cross-case 조직 질의가 오염된다"@ko ;
    skos:scopeNote "Most national-side references in the design data come from labels of the form 'X (government)', which do not say which body of the government is meant, so they denote a national side rather than an organization (ADR-0023). Candidate-set labels whose article evidence pointed only to a national side in the event-by-event resolution also belong here. This is why state sponsorship rarely reaches the real-world layer: a national-side reference cannot be the bearer organization of a role"@en,
        "설계 자료의 국가 측 지칭은 대부분 'X (government)' 꼴 표기에서 온다 — 정부의 어느 기관인지를 가리지 않으므로 조직이 아니라 국가 측이다 (ADR-0023). 사건별 해소 (ADR-0040 §5) 에서 기사 근거가 국가 쪽만 가리킨 후보 집합 표기도 여기 든다. 국가 후원 역할이 실세계 층에 드물게 오르는 까닭이다 — 국가 측 지칭은 역할의 담지 조직이 되지 못한다"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" ;
    nuproc:ontocleanDependence "+D Depends on CodedParticipation"@en,
        "+D CodedParticipation 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (the CodedParticipation in which the reference is used)"@en,
        "상위 클래스와 같다 (그 지칭이 쓰인 CodedParticipation — ADR-0031 §8)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One referring expression"@en,
        "+U 하나의 지칭 표현"@ko .

nuproc:OtherEngagementRole a owl:Class ;
    rdfs:label "Other Engagement Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "A role that an organization bears in a procurement case and that is none of the five role facets above (technology supply, construction contract, financing, state sponsorship, commercial supply)."@en,
        "조직이 조달 사례에서 지니는 역할 가운데 위 다섯 (노형 공급 · 건설 계약 · 금융 · 국가 후원 · 상업 공급) 어느 것도 아닌 것."@ko ;
    skos:scopeNote "The real-world counterpart of erole:other (nuproc:roleClass). Individuals are created only from the final claims of resolved participations, and each has one or more final role claims that support it (supportedByClaim)"@en,
        "erole:other 의 실세계 대응 (nuproc:roleClass). 해소된 참여의 최종 주장에서만 개체를 만든다 — 개체마다 그것을 뒷받침하는 최종 역할 주장이 하나 이상 있다 (supportedByClaim)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:StateSponsorRole a owl:Class ;
    rdfs:label "State Sponsor Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "The role of a government (a state body or an intergovernmental body) representing or sponsoring the export side."@en,
        "정부 (국가 기관 · 정부간 기구) 가 수출 측을 대표하거나 후원하는 역할."@ko ;
    skos:scopeNote "The real-world counterpart of erole:state_sponsorship (nuproc:roleClass). Individuals are created only from the final claims of resolved participations, and each has one or more final role claims that support it (supportedByClaim)"@en,
        "erole:state_sponsorship 의 실세계 대응 (nuproc:roleClass). 해소된 참여의 최종 주장에서만 개체를 만든다 — 개체마다 그것을 뒷받침하는 최종 역할 주장이 하나 이상 있다 (supportedByClaim)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:TechnologySupplyRole a owl:Class ;
    rdfs:label "Technology Supply Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf nuproc:EngagementRole ;
    skos:definition "The role of proposing, negotiating or performing the supply of a reactor design or major equipment."@en,
        "원자로 노형 · 주기기의 공급을 제안 · 협상 · 수행하는 역할."@ko ;
    skos:scopeNote "The real-world counterpart of erole:technology_supply (nuproc:roleClass). Individuals are created only from the final claims of resolved participations, and each has one or more final role claims that support it (supportedByClaim)"@en,
        "erole:technology_supply 의 실세계 대응 (nuproc:roleClass). 해소된 참여의 최종 주장에서만 개체를 만든다 — 개체마다 그것을 뒷받침하는 최종 역할 주장이 하나 이상 있다 (supportedByClaim)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (via EngagementRole)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (bearer organization, procurement case, role type)"@en,
        "상위 클래스와 같다 (담지 조직, 조달 사례, 역할 유형)"@ko ;
    nuproc:ontocleanRigidity "+R — as for the superclass: rigid for role individuals; an organization's taking this role is anti-rigid"@en,
        "+R — 상위 클래스와 같다 (역할 개체에 대해 강성이다. 조직이 이 역할을 맡는 것은 반강성이다)"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:claimAbout a owl:ObjectProperty ;
    rdfs:label "claim about"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §3" ;
    rdfs:domain nuproc:RoleClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:CodedParticipation ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0039>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Points to the coded participation that this role claim is about. (RoleClaim -> CodedParticipation) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 역할 주장이 관한 코딩된 참여를 가리킨다. (RoleClaim → CodedParticipation) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ19" .

nuproc:claimedIdentification a owl:ObjectProperty ;
    rdfs:label "claimed identification"@en ;
    dcterms:source "docs/adr/ADR-0044-case-process-identification-claims-names-participant.md §2.2" ;
    rdfs:domain nuproc:IdentificationClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0044> ;
    skos:definition "Points to the identification status that this claim gives the cluster. (IdentificationClaim -> EngagementIdentificationStatus) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 주장이 그 군집에 준 식별 상태 값을 가리킨다. (IdentificationClaim → EngagementIdentificationStatus) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ18" .

nuproc:claimedOccurrence a owl:ObjectProperty ;
    rdfs:label "claimed occurrence"@en ;
    dcterms:source "docs/adr/ADR-0041-v090-occurrence-consortium.md §1" ;
    rdfs:domain nuproc:OccurrenceClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0041> ;
    skos:definition "Points to the occurrence status that this claim gives for the cluster's engagement. (OccurrenceClaim -> OccurrenceStatus) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 주장이 그 군집의 관여에 대해 준 발생 상태 값을 가리킨다. (OccurrenceClaim → OccurrenceStatus) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ20" .

nuproc:claimedResolutionStatus a owl:ObjectProperty ;
    rdfs:label "claimed resolution status"@en ;
    dcterms:source "docs/adr/ADR-0043-resolution-claims.md §2.1" ;
    rdfs:domain nuproc:ResolutionClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0043> ;
    skos:definition "Points to the resolution status that this claim gives the reference. (ResolutionClaim -> ResolutionStatus) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 주장이 그 지칭에 준 해소 상태 값을 가리킨다. (ResolutionClaim → ResolutionStatus) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ17" .

nuproc:claimedRole a owl:ObjectProperty ;
    rdfs:label "claimed role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §3" ;
    rdfs:domain nuproc:RoleClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0039>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Points to the engagement role type that this claim says the participant has. (RoleClaim -> EngagementRoleType) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 주장이 참여자가 지닌다고 한 역할 유형 값을 가리킨다. (RoleClaim → EngagementRoleType) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ19" .

nuproc:hasActorReference a owl:ObjectProperty ;
    rdfs:label "has actor reference"@en ;
    dcterms:source "docs/adr/ADR-0031-reference-resolution-completed.md" ;
    rdfs:domain nuproc:CodedParticipation ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:ActorReference ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0031> ;
    skos:definition "Points to the reference by which the loaded dataset referred to this participation's participant, whether or not that reference was resolved. (CodedParticipation -> ActorReference) It records how the participant was referred to; it is not a participant slot: the slot is namesParticipant when an organization has been identified, and hasParticipantReference otherwise."@en,
        "이 참여의 참여자를 적재된 자료가 어떤 지칭으로 불렀는지를 가리킨다 — 해소 여부와 무관하게. (CodedParticipation → ActorReference) 참여자 슬롯이 아니다: 슬롯은 조직이 식별됐으면 namesParticipant, 아니면 hasParticipantReference 다 (ADR-0013)."@ko ;
    skos:scopeNote "It is stated explicitly on every participation that has a reference — including the reference that stands in the slot. This is because no reasoner runs at CQ and SHACL time. At most one per participation"@en,
        "지칭이 있는 모든 참여에 명시한다 — 슬롯의 지칭까지. CQ·SHACL 시점에 추론기가 돌지 않기 때문이다. 참여당 최대 하나다"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ17" .

nuproc:identificationClaimAbout a owl:ObjectProperty ;
    rdfs:label "identification claim about"@en ;
    dcterms:source "docs/adr/ADR-0044-case-process-identification-claims-names-participant.md §2.2" ;
    rdfs:domain nuproc:IdentificationClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:EngagementCluster ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0044> ;
    skos:definition "Points to the engagement-event cluster that this identification claim is about. (IdentificationClaim -> EngagementCluster) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 식별 주장이 관한 보도 사건 군집을 가리킨다. (IdentificationClaim → EngagementCluster) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ18" .

nuproc:occurrenceClaimAbout a owl:ObjectProperty ;
    rdfs:label "occurrence claim about"@en ;
    dcterms:source "docs/adr/ADR-0041-v090-occurrence-consortium.md §1" ;
    rdfs:domain nuproc:OccurrenceClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:EngagementCluster ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0041> ;
    skos:definition "Points to the engagement-event cluster that this occurrence claim is about. (OccurrenceClaim -> EngagementCluster) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 발생 주장이 관한 보도 사건 군집을 가리킨다. (OccurrenceClaim → EngagementCluster) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ20" .

nuproc:resolutionClaimAbout a owl:ObjectProperty ;
    rdfs:label "resolution claim about"@en ;
    dcterms:source "docs/adr/ADR-0043-resolution-claims.md §2.1" ;
    rdfs:domain nuproc:ResolutionClaim ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:ActorReference ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0043> ;
    skos:definition "Points to the actor reference that this resolution claim is about. (ResolutionClaim -> ActorReference) Exactly one per claim (OWL restriction and SHACL)."@en,
        "이 해소 주장이 관한 참여자 지칭을 가리킨다. (ResolutionClaim → ActorReference) 주장마다 정확히 하나다 (OWL 제한 · SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ17" .

nuproc:CodebookVersion a owl:Class ;
    rdfs:label "Codebook Version"@en ;
    dcterms:source "docs/adr/ADR-0006-codebook-vs-manual-divergence.md; version v2.6.5c of the source dataset's coding manual (not distributed)"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003>,
        <https://w3id.org/nuproc/adr/ADR-0006>,
        <https://w3id.org/nuproc/adr/ADR-0033> ;
    rdfs:subClassOf prov:Plan ;
    skos:definition "A specific edition of the coding guidance in force at the time of coding. It is an input to a coding activity and is revised over time. It is the plan (prov:Plan) the coding agent followed; each coding activity that followed it names it on its qualified association with prov:hadPlan."@en,
        "코딩 시점에 사용된 코딩 지침의 특정 판. 코딩 활동의 입력이며 시간에 따라 갱신된다. 코딩 행위자가 따른 계획(prov:Plan)이며, 그것을 따른 각 코딩 활동의 한정 연관에 prov:hadPlan 으로 적힌다 (ADR-0033)."@ko ;
    skos:scopeNote "Version v2.6.5c of the source dataset's coding manual (not distributed) and codebook v1.0 are at different levels"@en,
        "매뉴얼 v2.6.5c 와 codebook v1.0 은 층위가 다르다 (ADR-0006)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ07" ;
    nuproc:ontocleanDependence "-D" ;
    nuproc:ontocleanIdentityCriterion "Version string"@en,
        "버전 문자열"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One edition"@en,
        "+U 하나의 판"@ko .

nuproc:CollectiveActorReference a owl:Class ;
    rdfs:label "Collective Actor Reference"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md (empirical count of subtypes: 16 kinds / 19 cases)"@en,
        "ADR-0008 하위 유형 실측 (16종 / 19건)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013> ;
    rdfs:subClassOf nuproc:UnnamedActorReference ;
    skos:definition "A reference denoting two or more organizations together, such as multiple bidders or the firms of a given country. Some of these state a cardinality."@en,
        "둘 이상의 조직을 묶어 가리키는 지칭 (예: 복수 입찰자, 특정 국적 기업군). 일부는 기수가 명시된다"@ko ;
    skos:scopeNote "Design set: 19 kinds / 22 cases, as confirmed during entity resolution. The initial empirical count was 16 kinds / 19 cases"@en,
        "design 세트 19종 / 22건 (행위자 해소에서 확정). ADR-0008 초기 실측은 16종 / 19건 였다"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" ;
    nuproc:ontocleanDependence "+D Depends on CodedParticipation"@en,
        "+D CodedParticipation 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (the CodedParticipation in which the reference is used)"@en,
        "상위 클래스와 같다 (그 지칭이 쓰인 CodedParticipation — ADR-0031 §8)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One referring expression"@en,
        "+U 하나의 지칭 표현"@ko .

nuproc:MonthGranularityRule a owl:Class ;
    rdfs:label "Month Granularity Rule"@en ;
    dcterms:source "docs/adr/ADR-0027-event-representation.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0027> ;
    skos:definition "The clustering rule that conditions the existence of an event individual: article-level engagements sharing a six-field key (case, channel, event subtype, leading actor, counterparty role, calendar month) are treated as one EngagementCluster."@en,
        "사건 개체의 존재 조건인 군집 규칙. 기사 수준 관여를 6요소 키(사례·채널·사건 하위유형·주도 행위자·상대측 역할·역월)로 묶어 하나의 EngagementCluster 로 삼는다."@ko ;
    skos:scopeNote "The dedup rule used to exist only in code and documentation. Because that rule is the existence condition of an event individual, the graph must carry it."@en,
        "ADR-0027 §2 — dedup 규칙이 코드와 문서에만 있었다. 그 규칙이 사건 개체의 존재 조건이므로 그래프가 담아야 한다."@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ09" ;
    nuproc:ontocleanDependence "-D" ;
    nuproc:ontocleanIdentityCriterion "Being the same clustering rule: the composition of its key (six fields) and its time unit (month). The rule identifier records this identity; it does not constitute it"@en,
        "같은 군집 규칙 — 키의 구성 (6요소) 과 시간 단위 (월). 규칙 식별자는 이 동일성을 기록할 뿐 이루지 않는다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One rule"@en,
        "+U 하나의 규칙"@ko .

nuproc:PromptSpecification a owl:Class ;
    rdfs:label "Prompt Specification"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md (prompt_file spec v1)"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003>,
        <https://w3id.org/nuproc/adr/ADR-0033> ;
    rdfs:subClassOf prov:Plan ;
    skos:definition "A specific edition of the prompt specification supplied as input to a coding activity. It is the plan (prov:Plan) the coding agent followed; each coding activity names it on its qualified association with prov:hadPlan."@en,
        "코딩 활동에 입력된 프롬프트 명세의 특정 판. 코딩 행위자가 따른 계획(prov:Plan)이며, 각 코딩 활동의 한정 연관에 prov:hadPlan 으로 적힌다 (ADR-0033)."@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ07" ;
    nuproc:ontocleanDependence "-D" ;
    nuproc:ontocleanIdentityCriterion "Prompt file + version"@en,
        "프롬프트 파일 + 버전"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One specification"@en,
        "+U 하나의 명세"@ko .

nuproc:concernsCase a owl:ObjectProperty ;
    rdfs:label "concerns case"@en ;
    dcterms:source "docs/adr/ADR-0001-analytic-unit.md" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( nuproc:Engagement nuproc:EngagementCluster nuproc:EngagementRole ) ] ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:range nuproc:ProcurementCase ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0001>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    skos:definition "Points to the procurement case to which an engagement, a reported engagement-event cluster or an engagement role is assigned. (Engagement, EngagementCluster or EngagementRole -> ProcurementCase) An engagement and a role each concern exactly one case (OWL restrictions); a cluster and the engagement it reports, and a role and the engagements in which it is realized, concern the same case (SHACL)."@en,
        "관여, 보고된 관여 사건 군집, 또는 관여 역할이 배정된 조달 사례를 가리킨다. (Engagement · EngagementCluster · EngagementRole → ProcurementCase) 관여와 역할은 사례 정확히 하나에 속하고 (OWL 제한), 군집과 그것이 보도한 관여, 역할과 그것을 실현한 관여는 같은 사례에 속한다 (SHACL)."@ko ;
    nuproc:justifyingCompetencyQuestion "CQ01;CQ12;CQ14;CQ18" .

nuproc:AmbiguousOrganizationReference a owl:Class ;
    rdfs:label "Ambiguous Organization Reference"@en ;
    dcterms:source "docs/adr/ADR-0010-khnp-kepco-merge.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0010>,
        <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0026> ;
    rdfs:subClassOf nuproc:UnnamedActorReference ;
    skos:definition "A reference by which the source of an event points to a set of known candidate organizations without determining which one of them is meant (for example, KHNP/KEPCO in some events). It is not an organization and not a prov:Agent: a reference does not act. The kind of a reference is set by the source of the event, not by the form of the label, so the same label may be a definite reference in another event."@en,
        "그 사건의 원천이 알려진 후보 조직 무리를 가리키되 그중 어느 하나인지 정하지 않는 지칭 (예: 어느 사건의 KHNP/KEPCO). 조직이 아니며 prov:Agent 도 아니다 — 참조는 행위하지 않는다. 지칭의 종류는 라벨의 꼴이 아니라 그 사건의 원천이 정한다 — 같은 표기가 다른 사건에서는 확정 지칭일 수 있다."@ko ;
    skos:scopeNote "Previously the candidate set was an Organization and a prov:Agent — the class definition read 'a single legal personality', yet the scopeNote stated 'a value in which two legal entities are coded as one'."@en,
        "종전에는 후보 집합이 Organization 이자 prov:Agent 였다 — 클래스 정의는 '유일 법인격' 인데 scopeNote 가 '두 법인이 하나로 코딩된 값' 이라 적었다."@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" ;
    nuproc:ontocleanDependence "+D Depends on CodedParticipation"@en,
        "+D CodedParticipation 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Same as the superclass (the CodedParticipation in which the reference is used). The candidate set is not identity but an attribute"@en,
        "상위 클래스와 같다 (그 지칭이 쓰인 CodedParticipation — ADR-0031 §8). 후보 집합은 동일성이 아니라 속성이다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One referring expression"@en,
        "+U 하나의 지칭 표현"@ko .

nuproc:SourceArticle a owl:Class ;
    rdfs:label "Source Article"@en ;
    dcterms:source "docs/adr/ADR-0001-analytic-unit.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0001>,
        <https://w3id.org/nuproc/adr/ADR-0004> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A news article in the scope of the coding, from which zero or more article-level engagement records were coded. This ontology represents only the article identifier and its publication date; it does not represent body text or excerpts."@en,
        "코딩 범위에 든 원천 뉴스 기사 — 기사 수준 관여 기록이 0건 이상 코딩됐다. 본 온톨로지는 기사의 식별자와 발행일만 표현하며 본문·발췌는 표현하지 않는다."@ko ;
    skos:scopeNote "Articles that have no event make up 38.0% of the design set. This is a normal state, and no constraint is imposed"@en,
        "사건을 갖지 않는 기사가 설계 세트의 38.0% 다. 정상 상태이며 제약을 걸지 않는다"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ05;CQ06;CQ13;CQ15" ;
    nuproc:ontocleanDependence "-D" ;
    nuproc:ontocleanIdentityCriterion "Being the same published article. The article_id assigned by the collection pipeline records this identity; it does not constitute it"@en,
        "같은 발행 기사 — 수집 경로가 부여한 article_id 는 이 동일성을 기록할 뿐 이루지 않는다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One article"@en,
        "+U 하나의 기사"@ko .

nuproc:DataQualityMeasurement a owl:Class ;
    rdfs:label "Data Quality Measurement"@en ;
    dcterms:source "docs/adr/ADR-0009-reliability-reporting.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0009>,
        <https://w3id.org/nuproc/adr/ADR-0016> ;
    rdfs:subClassOf dqv:QualityMeasurement ;
    skos:definition "A single quality measurement produced by a validation activity. Which property was measured, at which layer, and on how many sampled items are represented alongside it."@en,
        "검증 활동이 산출한 하나의 품질 측정치. 어떤 속성을 어느 계층에서 몇 개의 표본으로 쟀는지가 함께 표현된다."@ko ;
    skos:scopeNote "Not attached to individual events. A measurement is of a sample"@en,
        "개별 사건에 붙이지 않는다. 측정은 표본에 대한 것이다 (ADR-0009)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Quality family"@en,
        "DOLCE:Quality 계열"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ16" ;
    nuproc:ontocleanDependence "+D Depends on ValidationActivity"@en,
        "+D ValidationActivity 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Metric + target property + applicable layer + sample"@en,
        "측정 지표 + 대상 속성 + 적용 계층 + 표본"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One measurement"@en,
        "+U 하나의 측정"@ko .

nuproc:EventRecord a owl:Class ;
    rdfs:label "Event Record"@en ;
    dcterms:source "docs/adr/ADR-0001-analytic-unit.md (5,839 records)"@en,
        "ADR-0001 (5,839건)"@ko ;
    rdfs:comment "The mention ordinal in a record's identity is assigned by NuProc, not given by the data: it follows a fixed sort (case, article, clustering key, source row order). For the 71 exactly duplicated pairs the 1/2 assignment is arbitrary, and IRIs are stable only if regeneration uses the same sort."@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0001>,
        <https://w3id.org/nuproc/adr/ADR-0019>,
        <https://w3id.org/nuproc/adr/ADR-0036> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "An information entity produced by coding one engagement activity from one source entity. Records that share the key of the clustering rule are clustered into one EngagementCluster."@en,
        "하나의 원천 개체에서 하나의 관여 활동을 코딩해 만든 정보 개체. 여러 기록이 군집 규칙의 키를 공유하면 하나의 EngagementCluster 군집으로 묶인다."@ko ;
    skos:scopeNote "In the NuProc data the source entity is a news article (SourceArticle), and the key of the clustering rule is the six-field key. The requirement that the source be a news article is in the profile layer (EventRecordProfileShape). || A record points with reportsEngagement to the engagement it reports, which is the engagement reported by the cluster the record contributes to (SHACL). From v0.9.0 the OWL axiom that every record reports an engagement is removed, so that the report of a planned or denied engagement does not imply that the engagement exists. A record whose cluster reports no engagement reports none (SHACL)"@en,
        "NuProc 자료에서 원천 개체는 뉴스 기사(SourceArticle)이고, 군집 규칙의 키는 6요소 키다 (ADR-0027). 기사 출처 요구는 프로파일 층에 있다 (EventRecordProfileShape, ADR-0036). || 기록은 그것이 보도한 관여를 reportsEngagement 로 가리키고, 그 관여는 기록이 속한 군집이 보도한 관여와 같다 (SHACL). 0.9.0 — 모든 기록이 관여를 보도한다는 OWL 공리를 뺐다: 예정 · 부인된 관여의 보도가 관여의 존재를 함의하지 않게. 관여를 보도하지 않는 군집의 기록은 관여를 보도하지 않는다 (SHACL, ADR-0041 §2)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object family"@en,
        "DOLCE:Non-agentive Social Object 계열"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ06;CQ07;CQ08;CQ13;CQ15" ;
    nuproc:ontocleanDependence "+D Depends on its source entity (in NuProc, a SourceArticle) and on EngagementCluster"@en,
        "+D 원천 개체(NuProc 에서는 SourceArticle)와 EngagementCluster 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "(source entity, position of the record in that source). In NuProc: article_id + dedup key + mention ordinal (the ordinal is needed because 71 fully duplicate pairs exist)"@en,
        "(원천 개체, 그 원천 안에서 기록의 자리). NuProc 에서는 article_id + dedup key + 언급 서수다 (완전 중복 71쌍이 존재하므로 서수가 필요하다 — ADR-0019)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One event mention extracted from one source entity"@en,
        "+U 한 원천 개체에서 추출된 한 건의 사건 언급"@ko .

nuproc:ProcurementCase a owl:Class ;
    rdfs:label "Procurement Case"@en ;
    dcterms:source "The source dataset (case_id: 4 distinct values)"@en,
        "DATA_AUDIT §4 (case_id 4종)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0007>,
        <https://w3id.org/nuproc/adr/ADR-0044> ;
    owl:disjointWith nuproc:CodingActivity,
        nuproc:ValidationActivity ;
    skos:definition "The procurement process for one nuclear new-build project, in which organizations engage over years. It is the case unit of this study, and engagements and roles belong to a case."@en,
        "하나의 원전 신규 건설 사업을 두고 조직들이 여러 해에 걸쳐 관여하는 조달 과정. 이 연구의 사례 단위이며, 관여와 역할이 사례에 속한다."@ko ;
    nuproc:alignmentReadinessBFO "BFO:process — the procurement over the new build at one site, in which organizations take part. The research design chooses which process (site, planned units) and the period observed; it does not make the process (ADR-0044 §2.1)"@en,
        "BFO:process — 한 부지의 신규 건설을 두고 조직들이 참여하는 조달 과정이다. 연구 설계는 어느 과정인지 (부지 · 계획 호기) 와 관찰 기간을 정할 뿐 과정을 만들지 않는다 (ADR-0044 §2.1)"@ko ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant family"@en,
        "DOLCE:Perdurant 계열"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ01;CQ12;CQ14" ;
    nuproc:ontocleanDependence "+D Depends on its participants (organizations): there is no procurement without a procuring party"@en,
        "+D 참여자 (조직) 에 의존 — 조달하는 쪽이 없으면 조달 과정이 없다"@ko ;
    nuproc:ontocleanIdentityCriterion "Being the same procurement process: the procurement for the same nuclear new-build project, picked out by its site and planned units. The research design chooses which process is studied and over which period. The case_id records this identity; it does not constitute it"@en,
        "같은 조달 과정 — 같은 원전 신규 건설 사업 (부지와 계획된 호기로 가린다) 의 조달이다. 연구 설계는 어느 과정을 어느 기간 볼지 정할 뿐이다. case_id 는 이 동일성을 기록할 뿐 이루지 않는다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One procurement process"@en,
        "+U 하나의 조달 과정"@ko .

nuproc:UnnamedActorReference a owl:Class ;
    rdfs:label "Unnamed Actor Reference"@en ;
    dcterms:source "docs/adr/ADR-0008-unnamed-actor-reference.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0008>,
        <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0031> ;
    rdfs:subClassOf nuproc:ActorReference ;
    skos:definition "An expression by which the source data referred to a participant without identifying it as an individual organization. It is a referring expression rather than an organization, and is therefore not placed at the same level as Organization."@en,
        "원자료가 참여자를 개별 조직으로 특정하지 않고 지칭한 표현. 조직이 아니라 지칭 표현이며, 따라서 Organization 과 같은 계층에 두지 않는다."@ko ;
    skos:scopeNote "It is an information entity (a referring expression), not a real actor. What separates it from Organization is the difference in identity criterion — for an organization, being the same body (the same legal person, public body or collaboration, which its canonical_id only records); for a reference, the participation in which it is used. From v0.5 it is a subclass of ActorReference, the superclass of all participant references"@en,
        "실재 행위자가 아니라 정보 개체(지칭 표현)다. Organization 과 가르는 근거는 동일성 기준의 차이다 — 조직은 같은 기관 (같은 법인격 · 같은 공공 기관 · 같은 협력체이며 canonical_id 는 이를 기록할 뿐이다), 지칭은 그것이 쓰인 참여 (ADR-0013 §2). v0.5 부터 모든 참여자 지칭의 상위 클래스 ActorReference 의 하위 클래스다 (ADR-0031)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ04;CQ17" ;
    nuproc:ontocleanDependence "+D Depends on CodedParticipation"@en,
        "+D CodedParticipation 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "The CodedParticipation in which the reference is used (the same as ActorReference)"@en,
        "그 지칭이 쓰인 CodedParticipation (ActorReference 와 같다 — ADR-0031 §8)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One referring expression"@en,
        "+U 하나의 지칭 표현"@ko .

nuproc:ValidationActivity a owl:Class ;
    rdfs:label "Validation Activity"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md; docs/adr/ADR-0009-reliability-reporting.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003>,
        <https://w3id.org/nuproc/adr/ADR-0009> ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "An activity in which human coders independently validated machine coding results on a sample. It produces quality measurements."@en,
        "사람 코더가 표본에 대해 기계 코딩 결과를 독립 검증한 활동. 품질 측정치를 산출한다."@ko ;
    nuproc:alignmentReadinessBFO "BFO:process"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant"@en ;
    nuproc:justifyingCompetencyQuestion "CQ16" ;
    nuproc:ontocleanDependence "+D Depends on the object of validation"@en,
        "+D 검증 대상에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "The validation experiment (target property + sample + coder composition)"@en,
        "검증 실험 (대상 속성 + 표본 + 코더 구성)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One validation experiment"@en,
        "+U 하나의 검증 실험"@ko .

nuproc:IdentificationClaim a owl:Class ;
    rdfs:label "Identification Claim"@en ;
    dcterms:source "docs/adr/ADR-0044-case-process-identification-claims-names-participant.md §2.2" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0027>,
        <https://w3id.org/nuproc/adr/ADR-0041>,
        <https://w3id.org/nuproc/adr/ADR-0044> ;
    rdfs:subClassOf _:n0c5f767f326767fb,
        _:n95f12b644f21f87f,
        _:nfc59f29bf8274f6f,
        prov:Entity ;
    owl:disjointWith nuproc:EngagementCluster ;
    skos:definition "A claim, made by one activity about one engagement-event cluster, of what the cluster's identification with one engagement rests on (the clustering key alone, a person's check, or a person's finding that it merges engagements), given as one identification status. It is an information entity. For the identification status asserted on a cluster, the claim that yielded it is its final claim."@en,
        "한 활동이 한 보도 사건 군집에 대해, 그 군집을 관여 하나와 동일시하는 것이 무엇에 기대는지 — 군집 키만 · 사람의 확인 · 사람이 본 병합 — 를 식별 상태 값 하나로 한 주장. 정보 개체다. 군집에 단언된 식별 상태는 그 값을 낸 주장이 그 값의 최종 주장이다."@ko ;
    skos:scopeNote "Of the same form as occurrence and resolution claims. In NuProc data every cluster has a claim of the clustering activity (key_based); a sampled cluster that people checked adds the coders' claims and, where both coders judged one engagement or both judged several, a reference claim derived from them; a re-checked cluster adds the author's claim. The reference claim, where there is one, is final; the author's claim is final where it changes the value; otherwise the clustering activity's claim is final. Claims that were not adopted remain as non-final claims (ADR-0044 §2.2)"@en,
        "발생 · 해소 주장과 같은 꼴이다. NuProc 자료에서 군집마다 군집 활동의 주장 (key_based) 이 있고, 사람이 확인한 표본 군집에는 코더의 주장과 — 두 코더가 같게 하나 또는 둘 이상이라고 했으면 — 그것에서 파생된 기준 주장이, 다시 확인한 군집에는 저자의 주장이 더해진다. 기준 주장이 있으면 그것이 최종이고, 저자의 주장은 값을 바꿀 때 최종이며, 그 밖에는 군집 활동의 주장이 최종이다. 채택되지 않은 주장은 최종이 아닌 주장으로 남는다 (ADR-0044 §2.2)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18" ;
    nuproc:ontocleanDependence "+D Depends on its generating activity and on the cluster it is about"@en,
        "+D 생성 활동과 대상 군집에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "(generating activity, cluster, claimed identification status): an activity makes only one claim about a cluster. The claimed value is essential to the claim"@en,
        "(생성 활동, 대상 군집, 주장된 식별 상태) — 한 활동은 한 군집에 관해 주장을 하나만 낸다. 주장된 값은 주장에 본질적이다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One judgement of one activity"@en,
        "+U 한 활동의 한 판정"@ko .

nuproc:OccurrenceClaim a owl:Class ;
    rdfs:label "Occurrence Claim"@en ;
    dcterms:source "docs/adr/ADR-0041-v090-occurrence-consortium.md §1 · §5" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040>,
        <https://w3id.org/nuproc/adr/ADR-0041> ;
    rdfs:subClassOf _:n154dff0d1abbfc2d,
        _:n2dae27dca630e206,
        _:n423ca93898b38189,
        prov:Entity ;
    owl:disjointWith nuproc:EngagementCluster ;
    skos:definition "A claim, made by one coding or adjudication activity, of the occurrence status of the engagement reported by the records of one engagement-event cluster, with one value. It is an information entity. For the occurrence status asserted on a cluster, the claim that yielded it is that value's final claim."@en,
        "한 코딩 · 판정 활동이 한 보도 사건 군집의 기록들이 보도하는 관여의 발생 상태를 값 하나로 한 주장. 정보 개체다. 군집에 단언된 발생 상태 값은 그 값을 낸 주장이 그 값의 최종 주장이다."@ko ;
    skos:scopeNote "The same pattern as the role claim (RoleClaim). In the NuProc data the final claim is that of the model coding (occurrence protocol v1); for the events of the human-checked sample it is that of the human reference (the coders' value where the two agree, otherwise the author's adjudication), and a reference claim is derived from the claims of the coders who gave its value (prov:wasDerivedFrom). Claims that were not adopted (the model's claims for the sample and the coders' claims) remain as non-final claims"@en,
        "역할 주장 (RoleClaim) 과 같은 꼴이다. NuProc 자료에서 최종 주장은 모델 코딩 (발생 상태 규약 v1) 의 것이고, 사람이 점검한 표본 사건에서는 사람 기준 (두 코더가 같으면 그 값, 갈리면 저자의 조정) 의 것이다 — 기준 주장은 그 값을 낸 코더의 주장에서 파생된다 (prov:wasDerivedFrom). 채택되지 않은 주장 (표본의 모델 주장 · 코더의 주장) 은 최종이 아닌 주장으로 남는다 (ADR-0041 §5)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ20" ;
    nuproc:ontocleanDependence "+D Depends on its generating activity and on the cluster it is about"@en,
        "+D 생성 활동과 대상 군집에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "(generating activity, cluster, claimed occurrence status): an activity makes only one claim about a cluster. The claimed value is essential to the claim"@en,
        "(생성 활동, 대상 군집, 주장된 발생 상태 값) — 한 활동은 한 군집에 관해 주장을 하나만 낸다. 주장된 값은 주장에 본질적이다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One judgement of one activity"@en,
        "+U 한 활동의 한 판정"@ko .

nuproc:ResolutionClaim a owl:Class ;
    rdfs:label "Resolution Claim"@en ;
    dcterms:source "docs/adr/ADR-0043-resolution-claims.md §2" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0031>,
        <https://w3id.org/nuproc/adr/ADR-0040>,
        <https://w3id.org/nuproc/adr/ADR-0043> ;
    rdfs:subClassOf _:n9a888a3570682fca,
        _:ne30ac9fb4d16f5c3,
        _:nf8829843966daf70,
        prov:Entity ;
    owl:disjointWith nuproc:ActorReference ;
    skos:definition "A claim, made by one judging activity, of how one actor reference is resolved: the resolution status it gives the reference and, if the reference is resolved, the organization it identifies. It is an information entity. For the resolution status and the organization asserted on a reference, the claim that yielded them is their final claim."@en,
        "한 판정 활동이 한 참여자 지칭이 어떻게 해소되는지를 — 지칭에 주는 해소 상태와, 해소되면 그 지칭이 가리키는 조직을 — 값으로 한 주장. 정보 개체다. 지칭에 단언된 해소 상태와 조직은 그 값을 낸 주장이 그 값의 최종 주장이다."@ko ;
    skos:scopeNote "Of the same form as role and occurrence claims. In NuProc data the final claim is that of the judgement that first gave the adopted value: the actor registry's judgement of the label (a person), the event-by-event judgement of a bundled label (the model), or a later judgement by a person that changed the value (a decision a protocol handed over, the blind re-judgement or the re-check of the remaining candidate sets). Where the value is unchanged, the earlier claim stays final, and claims that were not adopted remain as non-final claims. The resolution status is a summary fixed by the kind of the reference and its organization; the record of the judgement (who made it, under which plan, with which value) is in the claims (ADR-0043 §2.2, §2.5)"@en,
        "역할 · 발생 주장과 같은 꼴이다. NuProc 자료에서 최종 주장은 채택된 값을 처음 낸 판정의 것이다: 행위자 등록부의 라벨 판정 (사람), 묶인 표기의 사건별 판정 (모델), 또는 그 뒤 값을 바꾼 사람의 판정 (규약이 넘긴 판정 · 블라인드 재판정 · 남은 후보 집합의 재확인). 값이 같으면 앞 주장이 그대로 최종이고, 채택되지 않은 주장은 최종이 아닌 주장으로 남는다. 해소 상태는 지칭의 종류와 조직에서 정해지는 요약이고, 판정의 기록 — 누가 · 어느 계획으로 · 어떤 값을 냈는가 — 은 주장이 갖는다 (ADR-0043 §2.2 · §2.5)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ17" ;
    nuproc:ontocleanDependence "+D Depends on its generating activity and on the reference it is about"@en,
        "+D 생성 활동과 대상 지칭에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "(generating activity, reference, claimed resolution status and organization): an activity makes only one claim about a reference. The claimed value is essential to the claim"@en,
        "(생성 활동, 대상 지칭, 주장된 해소 상태와 조직) — 한 활동은 한 지칭에 관해 주장을 하나만 낸다. 주장된 값은 주장에 본질적이다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One judgement of one activity"@en,
        "+U 한 활동의 한 판정"@ko .

nuproc:RoleClaim a owl:Class ;
    rdfs:label "Role Claim"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §3 (provenance for each role value; several values)"@en,
        "ADR-0040 §3 (역할 값마다의 출처, 다중값)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0033>,
        <https://w3id.org/nuproc/adr/ADR-0039>,
        <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf _:n70bd5cb2eccf2671,
        _:na597143ea2208d7c,
        _:nc414a07715f68d5f,
        prov:Entity ;
    owl:disjointWith nuproc:CodedParticipation,
        nuproc:EngagementCluster ;
    skos:definition "A claim, made by one coding or adjudication activity, that the participant of one coded participation has a given engagement role type in the engagement reported by its cluster, whether or not that engagement took place. It is an information entity. There is one claim per value: an activity that claims three role types for one participation makes three claims. For each role value asserted on a participation, the claim that yielded it is that value's final claim."@en,
        "한 코딩 · 판정 활동이 한 코딩된 참여의 참여자가 그 군집이 보도한 관여에서 한 역할 유형을 지닌다고 한 주장 — 그 관여가 일어났는지와 무관하다. 정보 개체다. 주장은 값 하나에 하나다 — 한 활동이 한 참여에 관해 역할 유형 셋을 주장하면 주장도 셋이다. 참여에 단언된 역할 값마다 그 값을 낸 주장이 그 값의 최종 주장이다."@ko ;
    skos:scopeNote "The hasEngagementRole values asserted on the participation are kept: the claims record where each value came from. Queries read the values directly and follow the claims only when they ask for provenance. The human coders are anonymous. The claims in the public demonstration graph are synthetic"@en,
        "참여에 단언된 hasEngagementRole 값은 그대로 둔다 — 주장은 그 값이 어디서 왔는지 적는다. 질의는 값을 바로 읽고, 출처를 물을 때만 주장을 따라간다. 사람 코더는 익명이다. 공개 시연 그래프의 주장은 합성이다"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ19" ;
    nuproc:ontocleanDependence "+D Depends on the CodedParticipation it is about and on the activity that generated it"@en,
        "+D 대상 CodedParticipation 과 생성 활동에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "(generating activity, participation the claim is about, claimed role value): an activity makes only one claim per value about a participation. The claimed value is essential to the claim (a different value is a different claim)"@en,
        "(생성 활동, 대상 참여, 주장된 역할 값) — 한 활동은 한 참여에 관해 값마다 주장을 하나만 낸다. 주장된 값은 주장에 본질적이다 (값이 다르면 다른 주장이다)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One claim (one activity, one participation, one value)"@en,
        "+U 하나의 주장 (한 활동 · 한 참여 · 한 값)"@ko .

nuproc:CodingActivity a owl:Class ;
    rdfs:label "Coding Activity"@en ;
    dcterms:source "docs/adr/ADR-0003-llm-coding-provenance.md; the model execution metadata of the source dataset (not distributed)"@en ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0003> ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "A coding activity, by a model or a person, that produced labels or structured events from articles. The agent and the plans it followed (a prompt specification and a codebook version, each where one was used) attach to this activity."@en,
        "기사에서 라벨 또는 구조화 사건을 산출한 코딩 활동 — 모델 또는 사람이 한다. 행위자와 그가 따른 계획 (프롬프트 명세 · 코드북 버전 — 각각 쓴 경우에만) 이 이 활동에 붙는다."@ko ;
    skos:scopeNote "A model's coding is not reproducible — seed and temperature are not exposed. Reproducibility is not claimed"@en,
        "모델의 코딩은 재현되지 않는다 — seed·temperature 미노출. 재현성을 주장하지 않는다"@ko ;
    nuproc:alignmentReadinessBFO "BFO:process"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant"@en ;
    nuproc:justifyingCompetencyQuestion "CQ07" ;
    nuproc:ontocleanDependence "+D Depends on the input data"@en,
        "+D 입력 자료에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "The agent (a model or a coder) + the plans it followed (the prompt and the codebook version, each where one was used) + input + time of execution"@en,
        "행위자 (모델 또는 코더) + 계획 (프롬프트 · 코드북 버전 — 각각 쓴 경우) + 입력 + 실행 시점"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One coding run"@en,
        "+U 한 번의 코딩 실행"@ko .

nuproc:ActorReference a owl:Class ;
    rdfs:label "Actor Reference"@en ;
    dcterms:source "docs/adr/ADR-0031-reference-resolution-completed.md" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0031> ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith nuproc:CodedParticipation,
        nuproc:EngagementCluster,
        nuproc:Organization ;
    skos:definition "The reference by which the loaded dataset referred to the participant of one participation, whatever its resolution state; in the NuProc data, a coded actor label, not an excerpt of article text. It is an information entity, not an actor: resolving it links it to an organization but does not make it one."@en,
        "적재된 자료가 한 참여의 참여자를 가리킨 지칭 — 해소 상태와 무관하게. NuProc 자료에서는 코딩된 행위자 표기이지 기사 발췌가 아니다. 행위자가 아니라 정보 개체다: 해소는 지칭을 조직에 잇지만 조직으로 만들지 않는다."@ko ;
    skos:scopeNote "The kind of reference (the subclass) is rigid. The resolution status (hasResolutionStatus) takes only the values its kind allows (ReferenceKindStatusShape): the only change possible is a definite reference's from unresolved to resolved, and then too the class and the IRI stay the same. A reference is not a label but the use of a label in one participation, so the same label can be a reference of a different kind in different events (the label 'KHNP/KEPCO' is a definite reference, a candidate-set reference or a national-side reference, depending on the article evidence). Organizations are outside this hierarchy (ADR-0013 alternative A remains rejected). When judgements disagree, the reference still has one kind, that of the final judgement; the earlier judgements remain as non-final resolution claims (ADR-0043)"@en,
        "지칭의 종류(하위 클래스)는 강성이다. 해소 상태(hasResolutionStatus)는 종류가 허용하는 값만 갖는다 (ReferenceKindStatusShape) — 바뀔 수 있는 것은 확정 지칭의 unresolved → resolved 뿐이고, 그때도 클래스와 IRI 는 유지된다. 지칭은 표기가 아니라 그 표기가 한 참여에서 쓰인 것이다 — 같은 표기가 사건마다 다른 종류의 지칭일 수 있다 (예: 'KHNP/KEPCO' 는 기사 근거에 따라 확정 지칭, 후보 집합 지칭 또는 국가 측 지칭). 조직은 이 계층 밖에 있다 (ADR-0013 대안 A 기각 유지). 판정이 갈려도 지칭의 종류는 최종 판정의 것 하나다 — 앞선 판정은 최종이 아닌 해소 주장으로 남는다 (ADR-0043)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ17;CQ04" ;
    nuproc:ontocleanDependence "+D Depends on CodedParticipation"@en,
        "+D CodedParticipation 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "The CodedParticipation in which the reference is used (at most 1 reference per participation · at most 1 participation per reference). The label is not part of the identity but an attribute"@en,
        "그 지칭이 쓰인 CodedParticipation (참여당 지칭 최대 1 · 지칭당 참여 최대 1). 표기는 동일성의 일부가 아니라 속성이다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One referring expression"@en,
        "+U 하나의 지칭 표현"@ko .

nuproc:EngagementRole a owl:Class ;
    rdfs:label "Engagement Role"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf _:n497e3fac30ba97ad,
        _:ne73f063fa2132f43 ;
    owl:disjointWith nuproc:CodedParticipation,
        nuproc:CodingActivity,
        nuproc:Engagement,
        nuproc:Organization,
        nuproc:ValidationActivity ;
    skos:definition "A role that an organization bears in one procurement case, either being on one side of it or one of the six role facets, and that is realized in the engagements of that case in which the organization acts in that role."@en,
        "조직이 한 조달 사례에서 지니는 역할 — 그 사례의 한 측에 서는 것, 또는 역할 facet 여섯 가운데 하나 — 이며, 그 조직이 그 역할로 움직인 그 사례의 관여들에서 실현된다."@ko ;
    skos:scopeNote "The real-world layer asserts only what the data identify: facet role individuals are created only from the final role claims of resolved participations (supportedByClaim), and side role individuals only from the side values (hasSide) of resolved participations. A facet role is realized in the engagement that its claim's cluster reports, and a side role in the engagement reported by the cluster of such a participation (BFO realized in). A cluster that a person judged to bring two or more engagements together (identification state merged) reports no engagement, so its claims support the role but assert no realization. Only a cluster whose final occurrence status is occurred grounds a role; the role claims of any other cluster (planned, denied or unclear, or stating no status) stay claims, and its participation yields no side role. This is a rule for asserting roles, not a condition of their existence: a role can exist before any engagement takes place, as a contracted supplier's does before the first meeting, but the report of an engagement not stated to have taken place is not taken as evidence for it. An unresolved participation stays in the information layer as a reference and role claims; no participant is invented. The role classes are rigid for role individuals (+R); what is anti-rigid is an organization's taking a role. Roles are tied to a case rather than to an engagement because a BFO role inheres in its bearer, may exist unrealized and may be realized in several processes"@en,
        "실세계 층은 자료가 식별한 것만 단언한다 — facet 역할 개체는 해소된 참여의 최종 역할 주장에서만 (supportedByClaim), 측 역할 개체는 해소된 참여의 측 값 (hasSide) 에서만 만든다. facet 역할은 그 주장의 군집이 보도한 관여에서, 측 역할은 그런 참여를 가진 군집이 보도한 관여에서 실현된다 (BFO realized in). 사람이 둘 이상의 관여를 묶었다고 판단한 군집 (식별 상태 merged) 은 관여를 보도하지 않으므로, 그 주장은 역할을 뒷받침하지만 실현을 단언하지 않는다. 역할의 근거는 최종 발생 상태가 occurred 인 군집뿐이다 — 다른 군집 (예정 · 부인 · 불명, 또는 상태를 적지 않은 군집) 의 역할 주장은 주장으로 남고, 그 참여는 측 역할을 낳지 않는다. 역할을 단언하는 규칙이지 역할이 있기 위한 조건이 아니다: 역할은 관여가 일어나기 전에도 있을 수 있지만 (계약을 맺은 공급자의 역할은 첫 회의 전에도 있다), 일어났다고 보도되지 않은 관여의 보도를 그 근거로 삼지 않는다 (ADR-0041 덧붙임 4 · 5). 해소되지 않은 참여는 정보 층의 지칭과 역할 주장으로만 남는다 — 참여자를 지어내지 않는다 (ADR-0040 §1). 역할 클래스는 역할 개체에 대해 강성이다 (+R) — 조직이 역할을 맡는 것이 반강성이다. 역할을 관여가 아니라 사례에 매는 까닭: BFO 의 역할은 담지자에 inhere 하고, 실현되지 않은 채로 있을 수 있으며, 여러 과정에서 실현될 수 있다 (ADR-0040)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:role (obo:BFO_0000023)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE+DnS:Role"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Inheres in its bearer organization. It exists because of the organization's circumstances in the case (a bid, a contract, government backing and the like) and does not depend on any one engagement: it is the same role whether no realization is asserted or it is realized in several engagements"@en,
        "+D 담지 조직에 inhere 한다. 그 조직이 그 사례에서 놓인 처지 (입찰 · 계약 · 정부 후원 등) 때문에 있고 어느 한 관여에 의존하지 않는다 — 실현이 단언되지 않아도, 여러 관여에서 실현되어도 같은 역할이다"@ko ;
    nuproc:ontocleanIdentityCriterion "(bearer organization, procurement case, role type): an organization does not have two roles of the same type in the same case"@en,
        "(담지 조직, 조달 사례, 역할 유형) — 같은 조직이 같은 사례에서 같은 유형의 역할을 둘 갖지 않는다"@ko ;
    nuproc:ontocleanRigidity "+R for role individuals: a role individual is a role of its kind for as long as it exists. What is anti-rigid is an organization's taking a role: no organization is necessarily a technology supplier. NuProc defines no class of organizations that take a role"@en,
        "+R — 역할 개체에 대해: 역할 개체는 있는 동안 늘 그 종류의 역할이다. 반강성인 것은 조직이 역할을 맡는 것이다 — 어느 조직도 반드시 노형 공급자인 것은 아니다. NuProc 은 '역할을 맡은 조직' 의 클래스를 두지 않는다"@ko ;
    nuproc:ontocleanUnity "+U One role of one kind that one organization bears in one procurement case"@en,
        "+U 한 조직이 한 사례에서 지니는 한 종류의 역할"@ko .

nuproc:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    dcterms:source "The source dataset (player_canon: 75 distinct values)"@en,
        "DATA_AUDIT §6 (player_canon 75종)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0010>,
        <https://w3id.org/nuproc/adr/ADR-0014>,
        <https://w3id.org/nuproc/adr/ADR-0026> ;
    rdfs:subClassOf org:Organization,
        prov:Agent ;
    owl:disjointWith nuproc:CodingActivity,
        nuproc:UnnamedActorReference,
        nuproc:ValidationActivity ;
    skos:definition "A uniquely identified legal person or institution, or a group of them acting together as one party (a consortium or a joint delegation). It can be denoted as a participant of reported engagement-event clusters and retains its identity across cases."@en,
        "고유하게 식별되는 법인·기관, 또는 함께 한 당사자로 움직이는 그 무리 (컨소시엄 · 공동 대표단). 보고된 관여 군집의 참여자로 지시될 수 있으며 사례를 넘어 동일성이 유지된다."@ko ;
    skos:scopeNote "A reference that does not determine which of its candidate organizations is meant is not an Organization but an AmbiguousOrganizationReference, and its candidate organizations are linked with hasCandidateOrganization / hasCandidateLabel. The kind of a reference is set event by event by the source: the same label 'KHNP/KEPCO' resolves in some events to one organization or to the consortium organization, is a national-side reference in others, and remains a candidate-set reference in the rest. The coding-stage decision to keep the merged label as coded is unchanged. A consortium or joint-delegation organization is also typed org:OrganizationalCollaboration (W3C ORG)"@en,
        "후보 조직 가운데 어느 것인지 정하지 않는 지칭은 Organization 이 아니라 AmbiguousOrganizationReference 이며, 후보 조직은 hasCandidateOrganization / hasCandidateLabel 로 잇는다 (ADR-0026 · ADR-0031 §11). 지칭의 종류는 사건마다 원천이 정한다 — 같은 'KHNP/KEPCO' 표기가 사건에 따라 한 조직으로, 컨소시엄 조직으로 해소되거나, 국가 측 지칭이 되거나, 후보 집합 지칭으로 남는다 (ADR-0041 §3 · §4). 코딩 단계의 결정은 ADR-0010 그대로다. 컨소시엄 · 공동 대표단 조직은 W3C ORG 의 org:OrganizationalCollaboration 으로도 유형을 단다 (ADR-0041 덧붙임 4)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:object aggregate — the members of a consortium or a joint delegation (org:hasMember) are organizations, themselves object aggregates. BFO's member part relates only objects to an aggregate, so org:hasMember is W3C ORG's organizational membership and is not asserted as a BFO parthood (ADR-0044 §2.6)"@en,
        "BFO:object aggregate — 컨소시엄 · 공동 대표단의 구성원 (org:hasMember) 은 조직, 곧 그 자체가 대상 집합이다. BFO 의 member part 는 대상 (object) 만 집합에 잇는다 — org:hasMember 는 W3C ORG 의 조직 구성원 관계이고, BFO 의 부분 관계로 단언하지 않는다 (ADR-0044 §2.6)"@ko ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Social Agent"@en ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ14;CQ17" ;
    nuproc:ontocleanDependence "-D" ;
    nuproc:ontocleanIdentityCriterion "Being the same body: for a legal person, the same legal person; for a public body without legal personality of its own (a government, a ministry, a diplomatic office), the same body as established under public law. Different bodies of one state are different organizations even though they share the state's legal personality. For a consortium or a joint delegation without legal personality, the same collaboration: its members (org:hasMember) act together as one party for one defining purpose, in NuProc one procurement case (one bid or project). The case is the context in which a collaboration acts, not its identity: two consortia competing in one case are two organizations, and the same organizations acting together in another case form another collaboration. A collaboration remains the same organization while it continues as the same party (the same bid or agreement), even if its membership changes (W3C ORG org:OrganizationalCollaboration: an identity and defining purpose independent of its particular members). An organization that changes its name remains the same organization if it is the same body. The canonical id assigned in the actor registry records this identity; it does not constitute it"@en,
        "같은 기관 — 법인이면 같은 법인격, 자체 법인격이 없는 공공 기관 (정부 · 부처 · 재외 공관 등) 이면 그 기관을 두는 공법상의 같은 기관이다. 한 국가의 서로 다른 기관은 국가의 법인격을 함께 지더라도 서로 다른 조직이다. 법인격이 없는 컨소시엄 · 공동 대표단이면 같은 협력체다 — 구성원 (org:hasMember) 이 한 목적, NuProc 에서는 한 조달 사례 (한 입찰 · 한 사업) 를 위해 한 당사자로 함께 움직인다. 조달 사례는 협력체가 활동하는 맥락이지 그 동일성이 아니다: 같은 사례에서 경쟁하는 두 컨소시엄은 두 조직이고, 같은 조직들이 다른 사례에서 함께 움직이면 다른 협력체다. 협력체는 같은 당사자로 이어지는 동안 (같은 응찰 · 같은 협약) 구성원이 바뀌어도 같은 조직이다 (W3C ORG 의 org:OrganizationalCollaboration — 구성원과 따로인 정체성과 목적). 이름이 바뀌어도 같은 기관이면 같은 조직이다. 행위자 레지스트리가 부여한 canonical_id 는 이 동일성을 기록할 뿐 이루지 않는다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U one legal person, one public body, or one collaboration acting together as one party for one purpose (a consortium)"@en,
        "+U 하나의 법인, 하나의 공공 기관, 또는 한 목적을 위해 한 당사자로 함께 움직이는 하나의 협력체 (컨소시엄)"@ko .

nuproc:Engagement a owl:Class ;
    rdfs:label "Engagement"@en ;
    dcterms:source "docs/adr/ADR-0040-v080-real-world-layer-roles.md §1" ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0040> ;
    rdfs:subClassOf _:n48a9041833e28d07,
        _:nbd13593cc4e4a635 ;
    owl:disjointWith nuproc:ActorReference,
        nuproc:CodedParticipation,
        nuproc:CodingActivity,
        nuproc:EngagementCluster,
        nuproc:EventRecord,
        nuproc:IdentificationClaim,
        nuproc:OccurrenceClaim,
        nuproc:Organization,
        nuproc:ProcurementCase,
        nuproc:ResolutionClaim,
        nuproc:RoleClaim,
        nuproc:SourceArticle,
        nuproc:ValidationActivity ;
    skos:definition "A process in which parties engage with one another over a new-build nuclear procurement case — a meeting, consultation, visit, negotiation, agreement signing or public commitment addressed to the other party — whether or not and however it was reported."@en,
        "신규 원전 조달 사례를 두고 당사자들이 서로 관여하는 과정 — 회의 · 협의 · 방문 · 협상 · 협정 서명 · 상대를 향한 공개 약속. 보도 여부 · 방식과 무관하다."@ko ;
    skos:scopeNote "There is one engagement individual per cluster that reports an engagement: the cluster is the bundle of records that reported the engagement. A cluster that a person judged to bring two or more engagements together (identification state merged), and a cluster whose final occurrence status is not occurred, report no engagement. The real-world layer asserts only what the data identify: participants are linked only for resolved participations, and an unresolved participant is not invented. The type, channel and month of an engagement stay in the information layer (the cluster) as coded values"@en,
        "관여 개체는 관여를 보도하는 군집마다 하나다 — 군집은 그 관여를 보도한 기록들의 묶음이다. 사람이 둘 이상의 관여를 묶었다고 판단한 군집 (식별 상태 merged) 과 최종 발생 상태가 occurred 가 아닌 군집은 관여를 보도하지 않는다 (ADR-0041 §2). 실세계 층은 자료가 식별한 것만 단언한다: 참여자는 해소된 참여에서만 잇고, 해소되지 않은 참여자를 지어내지 않는다. 관여의 유형 · 채널 · 달은 코딩된 값으로 정보 층 (군집) 에 남는다 (ADR-0040 §1)"@ko ;
    nuproc:alignmentReadinessBFO "BFO:process (obo:BFO_0000015)"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Perdurant"@en ;
    nuproc:justifyingCompetencyQuestion "CQ18;CQ19" ;
    nuproc:ontocleanDependence "+D Depends on its participants (organizations): there is no engagement without participants"@en,
        "+D 참여자 (조직) 에 의존 — 참여자 없는 관여는 없다"@ko ;
    nuproc:ontocleanIdentityCriterion "Being the same process: the same parties, the same case, the same time. In the data the cluster that reports it is the handle on it (the cluster key is a handle on the identity; it does not constitute it)"@en,
        "같은 과정 — 같은 당사자 · 같은 사례 · 같은 때. 자료에서는 그것을 보도한 군집이 손잡이다 (군집 키는 동일성을 잡는 손잡이일 뿐 이루지 않는다)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U One engagement process"@en,
        "+U 하나의 관여 과정"@ko .

nuproc:CodedParticipation a owl:Class ;
    rdfs:label "Coded Participation"@en ;
    dcterms:source "docs/adr/ADR-0001-analytic-unit.md (two-party structure); docs/adr/ADR-0002-role-vocabulary.md"@en,
        "ADR-0001 2자 구조, ADR-0002"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0013>,
        <https://w3id.org/nuproc/adr/ADR-0014>,
        <https://w3id.org/nuproc/adr/ADR-0032>,
        <https://w3id.org/nuproc/adr/ADR-0034>,
        <https://w3id.org/nuproc/adr/ADR-0036> ;
    skos:definition "One side of a reported engagement-event cluster. It is a component of the cluster's representation: it carries the side (export side or host side) when the source separates the two, it carries the coded values (coded player category, engagement roles, counterparty role), and it points to the organization it denotes as participant (namesParticipant) or to the referring expression used in its place (hasParticipantReference)."@en,
        "보고된 관여 사건 군집의 한 쪽. 군집 표현의 구성요소다: 원천이 수출 측 · 발주 측을 가르면 측 (수출 측 또는 발주 측) 을 담고, 코딩된 값을 담으며, 참여자로 지시하는 조직(namesParticipant) 또는 그 자리에 쓰인 지칭(hasParticipantReference)을 가리킨다."@ko ;
    skos:scopeNote "A component of the event representation (an information entity), not a real-world participation. The real-world layer is the engagement (Engagement) with its participant organizations and their roles. Each event has exactly two sides, as the identity criterion states (the side is structure). The side value is a property of the side. In NuProc data every cluster has one export-side and one host-side participation: every participation carries a side, and the profile layer requires it. In this dataset the host-side participant is always empty, because the source data have no counterparty organization column"@en,
        "사건 표현(정보 개체)의 구성요소다 — 실세계 참여가 아니다 (ADR-0032 §1). 실세계 층은 관여 (Engagement) 와 그 참여자 조직 · 역할이다 (ADR-0040). 사건마다 쪽이 정확히 둘이다 — 동일성 기준이 그것을 적는다(쪽은 구조다, ADR-0034). 측은 쪽의 속성이다 (ADR-0036 · ADR-0040 §4). NuProc 자료에서는 군집마다 수출 측 1 · 발주 측 1 이다 — 모든 참여가 측을 가지며, 프로파일 층이 그것을 요구한다. 이 자료에서는 발주 측 참여자가 늘 비어 있다 — 원자료에 상대 조직 열이 없다"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity — a component of the EngagementCluster cluster. namesParticipant can be read as IAO 'denotes' (an alignment-readiness annotation only)"@en,
        "BFO/IAO:information content entity — EngagementCluster 군집의 구성요소. namesParticipant 는 IAO 'denotes' 로 읽을 수 있다 (정렬 준비 주석일 뿐 — ADR-0012)"@ko ;
    nuproc:alignmentReadinessDOLCE "A component of a DUL:InformationObject"@en,
        "DUL:InformationObject 의 구성요소"@ko ;
    nuproc:justifyingCompetencyQuestion "CQ02;CQ03;CQ04;CQ14;CQ15" ;
    nuproc:ontocleanDependence "+D Depends on EngagementCluster (the part depends on the whole)"@en,
        "+D EngagementCluster 에 의존 (부분은 전체에 의존)"@ko ;
    nuproc:ontocleanIdentityCriterion "(event, side): each event has two sides. When the source separates the export side from the host side, the side value names the side; otherwise the side key does. The occupant is not part of the identity"@en,
        "(사건, 쪽) — 사건마다 쪽이 둘이다. 원천이 수출 · 발주 측을 가르면 측 값이 쪽의 이름이고, 아니면 sideKey 가 이름이다. 점유자는 동일성의 일부가 아니다"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U The record of one side of one event"@en,
        "+U 한 사건의 한 쪽의 기록"@ko .

nuproc:EngagementCluster a owl:Class ;
    rdfs:label "Engagement Cluster"@en ;
    dcterms:source "docs/adr/ADR-0001-analytic-unit.md (1,210 events)"@en,
        "ADR-0001 (1,210건), DATA_AUDIT §2"@ko ;
    rdfs:isDefinedBy <https://w3id.org/nuproc/core> ;
    rdfs:seeAlso <https://w3id.org/nuproc/adr/ADR-0001>,
        <https://w3id.org/nuproc/adr/ADR-0019>,
        <https://w3id.org/nuproc/adr/ADR-0027>,
        <https://w3id.org/nuproc/adr/ADR-0032> ;
    owl:disjointWith nuproc:CodedParticipation,
        nuproc:EventRecord ;
    skos:definition "A reported engagement-event cluster: one or more coded article-level engagements that share a six-field key (case, channel, event subtype, leading actor, counterparty role, calendar month) and are therefore treated as one event. It is an analytical representation of what sources reported, not a directly observed real-world occurrence."@en,
        "보고된 관여 사건 군집 — 여섯 요소(사례·채널·사건 하위유형·주도 행위자·상대측 역할·달)를 공유해 하나로 묶인 기사 수준 관여들. 직접 관측된 실세계 사건이 아니라 출처가 보고한 것의 분석적 표현이다 (ADR-0027)."@ko ;
    skos:scopeNote "All event-level counts are conditional on this clustering rule. event-level κ 0.60 · merge correctness 81.5–92.4%. || Changed on 2026-08-22. The previous alignment was BFO:process / DOLCE:Perdurant — that applied to the pre-v0.3 reading of this class as a 'real-world event'. Because this class is defined as 'an analytical representation of what was reported', it is aligned as a representation, not as a process. This is the same treatment as AmbiguousOrganizationReference, which for the same reason is already an information content entity. The EngagementCluster↔EventRecord distinction stands unchanged — one is the report in a single article, the other is the cluster that groups those reports by the six-field key. || The judgement that counterparty role, event type and channel are anti-rigid (~R) for an organization or an activity concerns their bearer; for the cluster, these values are the values that constitute its identity — the two do not conflict. There is no anti-rigid property that subsumes EngagementCluster || From v0.8.0 a cluster points with reportsEngagement to the one real-world engagement (Engagement) it reports. The engagement's identity is the process itself; the cluster key is the practical handle on it, so two meetings in one month under the same key are taken as one cluster (under-separation) and one engagement spanning two months is taken as two clusters (over-separation). The identification of a cluster with one engagement therefore has a state: key-based, verified or merged (hasEngagementIdentification). A merged cluster, and a cluster whose final occurrence status is not occurred (planned, denied or unclear), reports no engagement"@en,
        "모든 사건 수준 집계는 이 군집 규칙에 조건적이다. event-level κ 0.60 · merge correctness 81.5–92.4% (ADR-0027). || ADR-0027 결과 (2026-08-22). 종전 정렬은 BFO:process / DOLCE:Perdurant 였다 — 그것은 v0.3 이전의 '실세계 사건' 읽기에 대한 것이다. ADR-0027 이 이 클래스를 '보도된 것의 분석적 표현' 으로 확정했으므로 과정이 아니라 표현물로 정렬한다. AmbiguousOrganizationReference 가 같은 이유로 이미 information content entity 인 것과 같은 처리다. ADR-0019 의 EngagementCluster↔EventRecord 구분은 그대로다 — 하나는 한 기사의 보도, 다른 하나는 그 보도들을 6요소 키로 묶은 군집이다 (ADR-0027 §5). || ADR-0032 §2. 상대측 역할·사건 유형·채널이 조직이나 활동에 대해 반강성(~R)이라는 판정은 그 담지자에 대한 것이고, 군집에게 이 값들은 동일성을 이루는 값이다 — 충돌하지 않는다. EngagementCluster 를 포섭하는 반강성 속성이 없다 || 0.8.0 — 군집은 그것이 보도한 실세계 관여 (Engagement) 하나를 reportsEngagement 로 가리킨다. 관여의 동일성은 과정 자신이고 군집 키는 그것을 실무에서 잡는 손잡이다 — 같은 달 같은 키의 두 회의는 한 군집으로 잡히고 (과소 분리), 두 달에 걸친 한 관여는 두 군집으로 잡힌다 (과다 분리) (ADR-0040 §1). 그래서 군집이 관여 하나를 보도한다는 식별에는 상태가 있다 — 키 기반 · 확인됨 · 병합 (hasEngagementIdentification). 병합된 군집과 최종 발생 상태가 occurred 가 아닌 군집 (예정 · 부인 · 불명) 은 관여를 보도하지 않는다 (ADR-0041 §2)"@ko ;
    nuproc:alignmentReadinessBFO "BFO/IAO:information content entity"@en ;
    nuproc:alignmentReadinessDOLCE "DOLCE:Non-agentive Social Object"@en ;
    nuproc:justifyingCompetencyQuestion "CQ01;CQ02;CQ03;CQ09;CQ10;CQ11;CQ12;CQ14;CQ15" ;
    nuproc:ontocleanDependence "+D Depends on its constituent EventRecords (at least 1) and on the clustering rule (MonthGranularityRule)"@en,
        "+D 구성 EventRecord(최소 1) 와 군집 규칙(MonthGranularityRule) 에 의존"@ko ;
    nuproc:ontocleanIdentityCriterion "Under the clustering rule that clusteredBy points to, the coded six-field key value shared by the constituent EventRecords (case_id · activity_type · primary_code · player_canon · counterparty_role · month). The key values are coded values and are essential to this cluster — a different value or a different rule means a different cluster"@en,
        "clusteredBy 가 가리키는 군집 규칙 아래에서, 구성 EventRecord 들이 공유하는 코딩된 6요소 키 값 (case_id · activity_type · primary_code · player_canon · counterparty_role · month). 키 값은 코딩된 값이며 이 군집에 본질적이다 — 값이나 규칙이 다르면 다른 군집이다 (ADR-0019 §1 · ADR-0027 · ADR-0032 §2)"@ko ;
    nuproc:ontocleanRigidity "+R" ;
    nuproc:ontocleanUnity "+U Unifying relation = equivalence of the six-field key under the rule. One cluster may merge two or more reported activities (merge correctness 81.5–92.4%)"@en,
        "+U 통합 관계 = 규칙 아래 6요소 키 동치. 한 군집이 둘 이상의 보도 활동을 합칠 수 있다 (merge correctness 81.5–92.4%)"@ko .

<https://w3id.org/nuproc/core> a owl:Ontology ;
    dcterms:creator "Wonbae Park" ;
    dcterms:description "Classes and properties for engagements in nuclear new-build procurement and the roles that organizations take in them, and for the reports of those engagements: the reported engagement-event clusters, the article-level records they are built from, the organizations and references they point to, the coding activities and quality measurements behind them, and the role, occurrence, resolution and identification claims that record which activity claimed each coded role value, each coded occurrence status, each resolution of an actor reference and each identification of a cluster with one engagement."@en ;
    dcterms:issued "2026-08-17"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-29"^^xsd:date ;
    dcterms:title "NuProc Ontology — core"@en ;
    vann:preferredNamespacePrefix "nuproc" ;
    vann:preferredNamespaceUri "https://w3id.org/nuproc/ns#" ;
    rdfs:seeAlso <https://github.com/bonjwanim/nuprockg> ;
    owl:imports <http://www.w3.org/2004/02/skos/core>,
        <http://www.w3.org/ns/prov-o> ;
    owl:priorVersion <https://w3id.org/nuproc/core/0.8.0> ;
    owl:versionIRI <https://w3id.org/nuproc/core/0.9.0> ;
    owl:versionInfo "0.9.0" ;
    nuproc:status "v0.9.0 release. The licence is CC BY 4.0. This version is a logical revision of v0.8.0. It separates the identification of a reported cluster with one engagement from the occurrence of that engagement: a cluster carries a coded occurrence status (OccurrenceStatus: occurred, planned, denied or unclear) with one claim per coded value (OccurrenceClaim), and only a cluster whose occurrence status is occurred, and that a person has not judged to merge engagements, reports an engagement, as do its records. The axiom that every event record reports an engagement was removed, so that the report of a planned or denied engagement does not imply that the engagement exists. A group of organizations acting together as one party, such as a consortium, is one organization whose members are given with W3C ORG (org:hasMember), and the pattern layer again allows at most one participant organization per participation. Each judgement of how an actor reference is resolved is a claim (ResolutionClaim) with the status it gives and, for a resolved reference, the organization; the status and resolvedTo asserted on a reference are those of its final claim, and the claims that were not adopted remain. Each judgement of what a cluster's identification with one engagement rests on (the clustering key alone, a person's check, or a person's finding that it merges engagements) is likewise a claim (IdentificationClaim). A procurement case is aligned, like an engagement, to the BFO process. The information-layer property that names the organization a coded participation denotes is now namesParticipant (hasParticipant in v0.8.0), apart from RO's has participant. The SHACL pattern layer now also requires that a record whose cluster reports no engagement reports none, that an activity which made a final claim names its agent and plan on a qualified association, and that an engagement in the data is reported by a cluster, and it lets only a cluster whose occurrence status is occurred ground a role or a side role (a rule for asserting roles, not a condition of their existence). The disjointness axioms now also cover the occurrence, resolution and identification claims, codebook versions, prompt specifications, quality measurements and the clustering rule, and organizations, roles and cases, like engagements, are disjoint with the coding and validation activities. v0.8.0 added a real-world layer whose classes are aligned by IRI to BFO and whose relations are reused from RO and BFO: an engagement (Engagement) is a process in which parties engage with one another over a procurement case, organizations participate in it, and the engagement roles of an organization (EngagementRole, with two side roles and six role facets) are its roles in a procurement case and are realized in the engagements of that case in which it acts in them; clusters and records report engagements (reportsEngagement, a subproperty of IAO is about). It replaced the single coded engagement function with engagement role types that may be combined, with one claim per coded value (RoleClaim), and the direction role with a side role, and added class restrictions, a functional property, disjointness axioms and the pattern-layer constraints on role claims, qualified associations and the real-world layer. No aliases are kept for renamed terms, because no earlier version was released. v0.7.0 renamed the information entities (EngagementCluster, CodedParticipation, concernsCase), added the function claims and the IAO alignment, and corrected two pattern-layer constraints on actor references. v0.6.1 revised annotations only. v0.6.0 made the direction role optional in the SHACL pattern layer and added the side key; that revision was designed after the v0.5.0 cross-dataset reuse results had been seen. The earlier logical revisions were v0.5.0 (reference resolution completed, coding plans, and SHACL shapes split into a domain-neutral pattern layer and a NuProc profile layer), v0.4.0 (a counterparty participation may carry one participant) and v0.3.0 (the player axis split into a coded category and an engagement function, organization-type axes, typed actor references, and the event as an analytical cluster). No earlier version was released. The cross-dataset reuse results and the reserved-case results reported with this version were obtained on it. No ORCID identifier is recorded for the creator."@en .

[] a owl:Axiom ;
    rdfs:comment "A role claim is about one participation of a cluster; it is not the cluster."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:RoleClaim ;
    owl:annotatedTarget nuproc:EngagementCluster .

[] a owl:Axiom ;
    rdfs:comment "A reference is an information entity, an organization is an agent; resolving a reference links it to an organization (resolvedTo) but does not make it one."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:ActorReference ;
    owl:annotatedTarget nuproc:Organization .

[] a owl:Axiom ;
    rdfs:comment "An engagement and the procurement case it concerns are both real-world processes, and neither is the other: an engagement concerns one case (concernsCase), and NuProc does not assert that it is a part of the case."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:ProcurementCase .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a process that the sources report; a coding activity is a process of this work that produced records, claims or measurements. Neither is the other."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:CodingActivity .

[] a owl:Axiom ;
    rdfs:comment "A participation points to its reference (hasActorReference); it is not one. Asserting the disjointness turns a domain misuse into an inconsistency instead of a silent re-typing."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:ActorReference ;
    owl:annotatedTarget nuproc:CodedParticipation .

[] a owl:Axiom ;
    rdfs:comment "A resolution claim is about a reference (resolutionClaimAbout); it is not the reference. Asserting the disjointness turns a domain misuse into an inconsistency instead of a silent re-typing."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:ResolutionClaim ;
    owl:annotatedTarget nuproc:ActorReference .

[] a owl:Axiom ;
    rdfs:comment "An engagement concerns exactly one procurement case."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget _:n48a9041833e28d07 .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; an event record is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:EventRecord .

[] a owl:Axiom ;
    rdfs:comment "An article-level record and the analytical cluster it contributes to are never the same thing: the record reports one engagement in one article, the cluster groups the records that share a six-field key. Neither is a directly observed real-world occurrence. The analytic unit of NuProc rests on this separation."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:EngagementCluster ;
    owl:annotatedTarget nuproc:EventRecord .

[] a owl:Axiom ;
    rdfs:comment "An identification claim gives exactly one identification status."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:IdentificationClaim ;
    owl:annotatedTarget _:n95f12b644f21f87f .

[] a owl:Axiom ;
    rdfs:comment "An occurrence claim was generated by a coding or adjudication activity. That there is exactly one is checked by SHACL, for the same reason as for role claims."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:OccurrenceClaim ;
    owl:annotatedTarget _:n2dae27dca630e206 .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; a source article is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:SourceArticle .

[] a owl:Axiom ;
    rdfs:comment "A resolution claim was generated by a judging activity. That there is exactly one is checked by SHACL, for the same reason as for role claims."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:ResolutionClaim ;
    owl:annotatedTarget _:nf8829843966daf70 .

[] a owl:Axiom ;
    rdfs:comment "An engagement has at least one participant organization. Under the open-world reading the participant need not be named: an engagement whose participant was not resolved has one, and the data do not say which."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget _:nbd13593cc4e4a635 .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; a reported cluster is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:EngagementCluster .

[] a owl:Axiom ;
    rdfs:comment "A procurement case is not a validation activity, a process of this work that produced records, claims or measurements; asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:ProcurementCase ;
    owl:annotatedTarget nuproc:ValidationActivity .

[] a owl:Axiom ;
    rdfs:comment "An identification claim is about exactly one engagement-event cluster."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:IdentificationClaim ;
    owl:annotatedTarget _:n0c5f767f326767fb .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; an identification claim is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:IdentificationClaim .

[] a owl:Axiom ;
    rdfs:comment "A reference is used in one participation of an event cluster; it is not the cluster."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:ActorReference ;
    owl:annotatedTarget nuproc:EngagementCluster .

[] a owl:Axiom ;
    rdfs:comment "An engagement role is a role of its bearer in exactly one procurement case. It is realized in the engagements of that case in which the bearer acts in it, possibly several; none needs to be asserted."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:EngagementRole ;
    owl:annotatedTarget _:n497e3fac30ba97ad .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; a role claim is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:RoleClaim .

[] a owl:Axiom ;
    rdfs:comment "An organization is not a validation activity, a process of this work that produced records, claims or measurements; asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Organization ;
    owl:annotatedTarget nuproc:ValidationActivity .

[] a owl:Axiom ;
    rdfs:comment "An identification claim is about a cluster (identificationClaimAbout); it is not the cluster. Asserting the disjointness turns a domain misuse into an inconsistency instead of a silent re-typing."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:IdentificationClaim ;
    owl:annotatedTarget nuproc:EngagementCluster .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; an occurrence claim is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:OccurrenceClaim .

[] a owl:AllDisjointClasses ;
    rdfs:comment "The real-world layer (organizations, engagements, engagement roles, procurement cases) and the information layer (engagement clusters, event records, source articles, coded participations, actor references, role claims, occurrence claims, resolution claims, identification claims, codebook versions, prompt specifications, quality measurements and the clustering rule) are disjoint, and so are the classes within each layer: nothing is both an organization and a record, a role and a claim, a case and a cluster, or an engagement and a codebook. The information layer is about the real-world layer, and no entity belongs to both."@en ;
    owl:members ( nuproc:Organization nuproc:Engagement nuproc:EngagementRole nuproc:ProcurementCase nuproc:EngagementCluster nuproc:EventRecord nuproc:SourceArticle nuproc:CodedParticipation nuproc:ActorReference nuproc:RoleClaim nuproc:OccurrenceClaim nuproc:ResolutionClaim nuproc:IdentificationClaim nuproc:CodebookVersion nuproc:PromptSpecification nuproc:DataQualityMeasurement nuproc:MonthGranularityRule ) .

[] a owl:Axiom ;
    rdfs:comment "An occurrence claim is about exactly one engagement-event cluster."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:OccurrenceClaim ;
    owl:annotatedTarget _:n423ca93898b38189 .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; an actor reference is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:ActorReference .

[] a owl:Axiom ;
    rdfs:comment "A role is realized in an engagement; it is not the engagement. Roles are continuants, engagements are processes."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:EngagementRole ;
    owl:annotatedTarget nuproc:Engagement .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; an organization, which participates in it, is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:Organization .

[] a owl:Axiom ;
    rdfs:comment "An event and a participation in it are never the same thing. The conceptual model has always implied this; v0.2 could not assert it because the event-level player role was carried on a property whose domain is the participation class (then named Participation). v0.3 moves that value to hasSelectedPlayerRole, so the axiom can be asserted."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:EngagementCluster ;
    owl:annotatedTarget nuproc:CodedParticipation .

[] a owl:Axiom ;
    rdfs:comment "A role is not a validation activity, a process of this work that produced records, claims or measurements; asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:EngagementRole ;
    owl:annotatedTarget nuproc:ValidationActivity .

[] a owl:Axiom ;
    rdfs:comment "An identification claim was generated by an activity: the clustering, a check by a person, or the reference derived from such checks. That there is exactly one is checked by SHACL, for the same reason as for role claims."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:IdentificationClaim ;
    owl:annotatedTarget _:nfc59f29bf8274f6f .

[] a owl:Axiom ;
    rdfs:comment "A role is not a coding activity, a process of this work that produced records, claims or measurements; asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:EngagementRole ;
    owl:annotatedTarget nuproc:CodingActivity .

[] a owl:Axiom ;
    rdfs:comment "A role claim is about a participation (claimAbout); it is not one. Asserting the disjointness turns a domain misuse into an inconsistency instead of a silent re-typing."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:RoleClaim ;
    owl:annotatedTarget nuproc:CodedParticipation .

[] a owl:Axiom ;
    rdfs:comment "A role inheres in an organization; it is not the organization. The same organization has different roles in different procurement cases."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:EngagementRole ;
    owl:annotatedTarget nuproc:Organization .

[] a owl:Axiom ;
    rdfs:comment "An occurrence claim is about a cluster (occurrenceClaimAbout); it is not the cluster. Asserting the disjointness turns a domain misuse into an inconsistency instead of a silent re-typing."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:OccurrenceClaim ;
    owl:annotatedTarget nuproc:EngagementCluster .

[] a owl:Axiom ;
    rdfs:comment "A coded participation records a role as a coded value (hasEngagementRole); it is not the role. The role is a real-world entity that inheres in the participant organization."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:EngagementRole ;
    owl:annotatedTarget nuproc:CodedParticipation .

[] a owl:Axiom ;
    rdfs:comment "An organization is not a coding activity, a process of this work that produced records, claims or measurements; asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Organization ;
    owl:annotatedTarget nuproc:CodingActivity .

[] a owl:Axiom ;
    rdfs:comment "A role claim claims exactly one role value."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:RoleClaim ;
    owl:annotatedTarget _:na597143ea2208d7c .

[] a owl:Axiom ;
    rdfs:comment "A procurement case is not a coding activity, a process of this work that produced records, claims or measurements; asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:ProcurementCase ;
    owl:annotatedTarget nuproc:CodingActivity .

[] a owl:Axiom ;
    rdfs:comment "A role claim is about exactly one coded participation."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:RoleClaim ;
    owl:annotatedTarget _:n70bd5cb2eccf2671 .

[] a owl:Axiom ;
    rdfs:comment "A definite reference picked out one individual organization; an unnamed reference did not. Whether a definite reference has been matched to a registered organization is its resolution status, not its kind."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:DefiniteOrganizationReference ;
    owl:annotatedTarget nuproc:UnnamedActorReference .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Each engagement role individual is of one kind: a side role or one of the six role facets. An organization that has several roles in one procurement case has several role individuals, one per kind, and one engagement can realize several of them, so the facets can be combined without any individual being of two kinds."@en ;
    owl:members ( nuproc:ExportSideRole nuproc:HostSideRole nuproc:TechnologySupplyRole nuproc:ConstructionContractRole nuproc:FinancingRole nuproc:StateSponsorRole nuproc:CommercialSupplyRole nuproc:OtherEngagementRole ) .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; a coded participation is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:CodedParticipation .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a process that the sources report; a validation activity is a process of this work that produced records, claims or measurements. Neither is the other."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:ValidationActivity .

[] a owl:Axiom ;
    rdfs:comment "A role claim was generated by a coding or adjudication activity. That there is exactly one is checked by SHACL: PROV-O defines prov:wasGeneratedBy with a property chain, so it is not a simple property, and a cardinality restriction on it would take the ontology out of OWL 2 DL."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:RoleClaim ;
    owl:annotatedTarget _:nc414a07715f68d5f .

[] a owl:Axiom ;
    rdfs:comment "A resolution claim gives exactly one resolution status."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:ResolutionClaim ;
    owl:annotatedTarget _:ne30ac9fb4d16f5c3 .

[] a owl:Axiom ;
    rdfs:comment "A resolution claim is about exactly one actor reference."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:ResolutionClaim ;
    owl:annotatedTarget _:n9a888a3570682fca .

[] a owl:Axiom ;
    rdfs:comment "Identity criteria differ: an organization remains the same organization as long as it is the same legal person, for a public body without legal personality of its own such as a ministry the same body, or for a consortium or joint delegation without legal personality the same collaboration (its canonical id records this identity), while a reference is identified by the participation in which it is used, so nothing can be both (an OntoClean identity violation). A common Actor superclass was rejected on related grounds: a reference is an expression, not an actor."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Organization ;
    owl:annotatedTarget nuproc:UnnamedActorReference .

[] a owl:AllDisjointClasses ;
    rdfs:comment "A reference denotes either several organizations, exactly one unidentified organization, a national side, or one of a known candidate set — never more than one of these at once."@en ;
    owl:members ( nuproc:CollectiveActorReference nuproc:AnonymousSingularReference nuproc:NationalSideReference nuproc:AmbiguousOrganizationReference ) .

[] a owl:Axiom ;
    rdfs:comment "An engagement is a real-world process; a resolution claim is not. The information layer reports engagements (reportsEngagement) but none of its entities is one, and asserting the disjointness turns a misuse of the two layers into an inconsistency."@en ;
    owl:annotatedProperty owl:disjointWith ;
    owl:annotatedSource nuproc:Engagement ;
    owl:annotatedTarget nuproc:ResolutionClaim .

[] a owl:Axiom ;
    rdfs:comment "An occurrence claim gives exactly one occurrence status."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:OccurrenceClaim ;
    owl:annotatedTarget _:n154dff0d1abbfc2d .

[] a owl:Axiom ;
    rdfs:comment "An engagement role is the role of exactly one organization, its bearer."@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource nuproc:EngagementRole ;
    owl:annotatedTarget _:ne73f063fa2132f43 .

