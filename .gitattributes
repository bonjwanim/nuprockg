# Line endings: every text file is LF, in the repository and in the working tree. Without this, a checkout
# with core.autocrlf=true turns LF into CRLF, and the downloaded modules no longer match the SHA-256 values in
# ontology/CHECKSUMS.txt.

*           text=auto eol=lf

*.ttl       text eol=lf
*.rq        text eol=lf
*.rdf       text eol=lf
*.trig      text eol=lf
*.nt        text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.csv       text eol=lf
*.tsv       text eol=lf
*.txt       text eol=lf
*.sha256    text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.cff       text eol=lf
*.tex       text eol=lf
*.bib       text eol=lf
*.html      text eol=lf
*.htaccess  text eol=lf

# Binary files are left as they are
*.png       binary
*.jpg       binary
*.pdf       binary
*.xlsx      binary
*.jar       binary
*.zip       binary
