# SHACL shapes that a builder of composition.ttl has to write for the four constraints of the comparison. None of
# the vocabularies in the composition publishes shapes for them. Each named shape starts with the constraint it
# serves (C1 ... C4); run.py counts its lines and triples. Run with SHACL-SPARQL enabled (pySHACL advanced=True),
# with composition_ext.ttl mixed into the data graph (the codes carry skos:inScheme).
#
#   c1  a candidate-set reference names at least two candidates and is not marked resolved
#   c2  every role value on a participation has exactly one final claim that agrees with it
#   c3  a coding activity has a qualified association per plan, and a model activity has a prompt-specification plan
#   c4  a role's bearer participates in the engagement that realizes it
#
# The SPARQL bodies use full IRIs, as ontology/nuproc-shapes.ttl does, so that line counts compare like with like.

@prefix cs:      <https://example.org/composition-shapes#> .
@prefix ex:      <https://example.org/ext#> .
@prefix exstat:  <https://example.org/ext/status/> .
@prefix gaf:     <http://groundedannotationframework.org/gaf#> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sem:     <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

# c1. Every actor reference has one status; it names candidates exactly when its status is
# unresolvable_candidate_set, and then it names at least two and denotes no organisation.
cs:C1_CandidateSetReferenceShape a sh:NodeShape ;
    sh:targetObjectsOf ex:actorReference ;
    sh:property [ sh:path ex:resolutionStatus ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( exstat:resolved exstat:unresolved exstat:unresolvable_candidate_set ) ] ;
    sh:property [ sh:path ex:candidate ; sh:class org:Organization ] ;
    sh:or (
        [ sh:not [ sh:property [ sh:path ex:resolutionStatus ; sh:hasValue exstat:unresolvable_candidate_set ] ] ;
          sh:property [ sh:path ex:candidate ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path ex:resolutionStatus ; sh:hasValue exstat:unresolvable_candidate_set ] ;
          sh:property [ sh:path ex:candidate ; sh:minCount 2 ] ;
          sh:property [ sh:path gaf:denotes ; sh:maxCount 0 ] ]
    ) ;
    sh:message "c1: a reference names candidate organisations exactly when it is a candidate set, and a candidate set names at least two and is not marked resolved." ;
    sh:severity sh:Violation .

# c2 (claims). A claim reifies one sem:roleType statement about one participation and was generated by one
# activity; a revised claim is about the same participation as the claim it revises.
cs:C2_ClaimShape a sh:NodeShape ;
    sh:targetClass rdf:Statement ;
    sh:property [ sh:path rdf:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sem:Role ] ;
    sh:property [ sh:path rdf:predicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue sem:roleType ] ;
    sh:property [ sh:path rdf:object ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Activity ] ;
    sh:property [ sh:path prov:wasRevisionOf ; sh:maxCount 1 ; sh:class rdf:Statement ] ;
    sh:sparql [
        sh:message "c2: a revised claim is about the same participation as the claim it revises." ;
        sh:select """
            SELECT $this ?value WHERE {
              $this <http://www.w3.org/ns/prov#wasRevisionOf> ?value ;
                    <http://www.w3.org/1999/02/22-rdf-syntax-ns#subject> ?p .
              FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#subject> ?p }
            }
        """ ;
    ] ;
    sh:message "c2: a claim names one participation, one role type and the one activity that made it." ;
    sh:severity sh:Violation .

# c2 (final claims). Each role type on a participation has exactly one final claim (a claim the participation was
# derived from) about this participation that claims that value, and every final claim claims a value it carries.
cs:C2_FinalClaimShape a sh:NodeShape ;
    sh:targetClass sem:Role ;
    sh:sparql [
        sh:message "c2: each role value of a participation has exactly one final claim that agrees with it, and every final claim agrees with a value of the participation." ;
        sh:select """
            SELECT $this ?value WHERE {
              {
                $this <http://semanticweb.cs.vu.nl/2009/11/sem/roleType> ?value .
                ?value <http://www.w3.org/2004/02/skos/core#inScheme> <https://example.org/ext/role/> .
                FILTER NOT EXISTS {
                  $this <http://www.w3.org/ns/prov#wasDerivedFrom> ?c .
                  ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#subject> $this ;
                     <http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate> <http://semanticweb.cs.vu.nl/2009/11/sem/roleType> ;
                     <http://www.w3.org/1999/02/22-rdf-syntax-ns#object> ?value .
                }
              } UNION {
                $this <http://www.w3.org/ns/prov#wasDerivedFrom> ?c .
                ?c a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement> ;
                   <http://www.w3.org/1999/02/22-rdf-syntax-ns#object> ?value .
                FILTER NOT EXISTS { $this <http://semanticweb.cs.vu.nl/2009/11/sem/roleType> ?value }
              } UNION {
                $this <http://www.w3.org/ns/prov#wasDerivedFrom> ?value .
                ?value a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement> .
                FILTER NOT EXISTS { ?value <http://www.w3.org/1999/02/22-rdf-syntax-ns#subject> $this }
              } UNION {
                $this <http://www.w3.org/ns/prov#wasDerivedFrom> ?c1 , ?c2 .
                FILTER(?c1 != ?c2)
                ?c1 a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement> ;
                    <http://www.w3.org/1999/02/22-rdf-syntax-ns#object> ?value .
                ?c2 a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement> ;
                    <http://www.w3.org/1999/02/22-rdf-syntax-ns#object> ?value .
              }
            }
        """ ;
    ] ;
    sh:severity sh:Violation .

# c3. Every activity that generated a record or a claim has at least one qualified association; each association
# names one agent and at most one plan (so an activity that followed two plans has two associations); the activity
# followed at least one plan; and an activity whose agent is a software agent (a model) followed a prompt
# specification.
cs:C3_CodingActivityShape a sh:NodeShape ;
    sh:targetObjectsOf prov:wasGeneratedBy ;
    sh:property [ sh:path prov:qualifiedAssociation ; sh:minCount 1 ; sh:node cs:C3_AssociationShape ;
                  sh:message "c3: an activity names its agent and plans on qualified associations, one agent and at most one plan each." ] ;
    sh:property [ sh:path ( prov:qualifiedAssociation prov:hadPlan ) ; sh:minCount 1 ;
                  sh:message "c3: an activity followed at least one plan, recorded on a qualified association." ] ;
    sh:sparql [
        sh:message "c3: an activity carried out by a software agent (a model) has a prompt specification among the plans of its qualified associations." ;
        sh:select """
            SELECT $this WHERE {
              $this <http://www.w3.org/ns/prov#qualifiedAssociation>/<http://www.w3.org/ns/prov#agent> ?a .
              ?a a <http://www.w3.org/ns/prov#SoftwareAgent> .
              FILTER NOT EXISTS {
                $this <http://www.w3.org/ns/prov#qualifiedAssociation>/<http://www.w3.org/ns/prov#hadPlan> ?p .
                ?p <http://purl.org/dc/terms/type> <https://example.org/ext/plantype/prompt_specification> .
              }
            }
        """ ;
    ] ;
    sh:severity sh:Violation .

cs:C3_AssociationShape a sh:NodeShape ;
    sh:property [ sh:path prov:agent ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:hadPlan ; sh:maxCount 1 ] .

# c4. In SEM the role and the participation are one node: a sem:Role constraint on the engagement's sem:hasActor
# whose rdf:value is the bearer. The bearer therefore participates in the engagement that realizes its roles by
# construction, and what is left to check is that the node hangs on exactly one engagement and has at most one
# bearer, an organisation.
cs:C4_RoleInEngagementShape a sh:NodeShape ;
    sh:targetClass sem:Role ;
    sh:property [ sh:path [ sh:inversePath sem:hasActor ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sem:Event ;
                  sh:message "c4: a role (a participation node) is realized in exactly one engagement: it is the value of sem:hasActor of exactly one event." ] ;
    sh:property [ sh:path rdf:value ; sh:maxCount 1 ; sh:class org:Organization ;
                  sh:message "c4: a role has at most one bearer, an organisation." ] ;
    sh:severity sh:Violation .
