# The case of composition_example/README.md, expressed with a composition of existing vocabularies and no NuProc
# term. Every individual is synthetic; every label carries "(SYN)".
#
#   SEM (Simple Event Model, namespace document of 2009-11; not imported)
#     sem:Event for the procurement case and each engagement, sem:subEventOf, sem:hasTimeStamp, sem:eventType,
#     sem:hasActor with a sem:Role constraint node per side; the constraint node takes the place of the actor,
#     rdf:value points to the actor when one has been identified, and sem:roleType carries the side and every role
#     type (no cardinality limit, so several role types sit on one node).
#   GAF (Grounded Annotation Framework, cltl/GRaSP @ b773cb4; not imported)
#     gaf:Mention for the news records ("Mentions are references to members of the gaf:Instance class as they occur
#     in (web) media") and for the actor mention used for each participation; gaf:denotes from a record to the
#     engagement it reports, and from a resolved actor mention to the organisation.
#   PROV-O
#     A claim is an rdf:Statement (RDF reification: rdf:subject = the participation node, rdf:predicate =
#     sem:roleType, rdf:object = the claimed role type), generated by an activity (prov:wasGeneratedBy); the
#     activity has one qualified association per plan (prov:agent, prov:hadPlan); an adjudicated claim
#     prov:wasRevisionOf the claim it revises; the participation node prov:wasDerivedFrom its final claims.
#   W3C ORG (org:Organization), SKOS (codes), DCTERMS (dcterms:type for the type of a plan).
#   Ad-hoc (composition_ext.ttl): ex:actorReference, ex:candidate, ex:resolutionStatus, and the builder's codes.
#
# Section markers ("# == <id> <title> ==") are read by run.py; the sections mirror those of nuproc.ttl.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix excp:    <https://example.org/ext/counterparty/> .
@prefix ex:      <https://example.org/ext#> .
@prefix explan:  <https://example.org/ext/plantype/> .
@prefix exrole:  <https://example.org/ext/role/> .
@prefix exside:  <https://example.org/ext/side/> .
@prefix exstat:  <https://example.org/ext/status/> .
@prefix extype:  <https://example.org/ext/eventtype/> .
@prefix gaf:     <http://groundedannotationframework.org/gaf#> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sem:     <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix syn:     <https://example.org/syn/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# == S0 case, engagements, records and the two sides of each engagement ==

syn:case a sem:Event ;
    rdfs:label "Demo case (SYN)" .

# Engagement A: the export side (reported as the bundled label "Vendor K / Utility K (SYN)") meets the host
# government's ministry; two news records report it. As in NewsReader, the records that report the same event
# denote one event instance: the cluster is the event, and no separate cluster node or clustering rule is kept.
syn:engagement-A a sem:Event ;
    rdfs:label "Engagement A (SYN)" ;
    sem:eventType extype:meeting ;
    sem:hasActor syn:participation-A-export , syn:participation-A-host ;
    sem:hasTimeStamp "2024-03"^^xsd:gYearMonth ;
    sem:subEventOf syn:case .

# Engagement B: a second engagement in the same case; its export-side actor resolves to Vendor Beta (SYN).
syn:engagement-B a sem:Event ;
    rdfs:label "Engagement B (SYN)" ;
    sem:eventType extype:meeting ;
    sem:hasActor syn:participation-B-export , syn:participation-B-host ;
    sem:hasTimeStamp "2024-05"^^xsd:gYearMonth ;
    sem:subEventOf syn:case .

syn:record-A1 a gaf:Mention ;
    gaf:denotes syn:engagement-A ;
    prov:wasDerivedFrom syn:article-A1 ;
    prov:wasGeneratedBy syn:activity-event-extraction .

syn:record-A2 a gaf:Mention ;
    gaf:denotes syn:engagement-A ;
    prov:wasDerivedFrom syn:article-A2 ;
    prov:wasGeneratedBy syn:activity-event-extraction .

syn:record-B1 a gaf:Mention ;
    gaf:denotes syn:engagement-B ;
    prov:wasDerivedFrom syn:article-B1 ;
    prov:wasGeneratedBy syn:activity-event-extraction .

syn:article-A1 a prov:Entity .
syn:article-A2 a prov:Entity .
syn:article-B1 a prov:Entity .

# One sem:Role constraint node per side. Only a resolved participation has rdf:value (the actor).
syn:participation-A-export a sem:Role ;
    sem:roleType exside:export_side .

syn:participation-A-host a sem:Role ;
    sem:roleType excp:host_government , exside:host_side .

syn:participation-B-export a sem:Role ;
    rdf:value syn:org-vendor-beta ;
    sem:roleType exside:export_side .

syn:participation-B-host a sem:Role ;
    sem:roleType excp:host_government , exside:host_side .

syn:activity-event-extraction a prov:Activity ;
    rdfs:label "Event extraction (SYN)" ;
    prov:qualifiedAssociation syn:association-event-extraction-codebook ,
        syn:association-event-extraction-prompt ;
    prov:wasAssociatedWith syn:agent-extraction-model .

syn:association-event-extraction-codebook a prov:Association ;
    prov:agent syn:agent-extraction-model ;
    prov:hadPlan syn:plan-extraction-codebook .

syn:association-event-extraction-prompt a prov:Association ;
    prov:agent syn:agent-extraction-model ;
    prov:hadPlan syn:plan-extraction-prompt .

syn:agent-extraction-model a prov:SoftwareAgent ;
    rdfs:label "Extraction model (SYN)" .

syn:plan-extraction-codebook a prov:Plan ;
    rdfs:label "Extraction codebook (SYN)" ;
    dcterms:type explan:codebook .

syn:plan-extraction-prompt a prov:Plan ;
    rdfs:label "Extraction prompt specification (SYN)" ;
    dcterms:type explan:prompt_specification .

# == S1 organisations ==

syn:org-vendor-k a org:Organization , sem:Actor ;
    rdfs:label "Vendor K (SYN)" .

syn:org-utility-k a org:Organization , sem:Actor ;
    rdfs:label "Utility K (SYN)" .

syn:org-vendor-beta a org:Organization , sem:Actor ;
    rdfs:label "Vendor Beta (SYN)" .

# == P1 actor references: the candidate set of engagement A and the resolved reference of engagement B ==

# The bundled label names two candidate organisations and the evidence does not say which one is meant. The mention
# denotes nothing that the graph names; its candidates and its status need the ad-hoc terms.
syn:participation-A-export ex:actorReference syn:reference-A-export .

syn:reference-A-export a gaf:Mention ;
    prov:value "Vendor K / Utility K (SYN)" ;
    ex:candidate syn:org-utility-k , syn:org-vendor-k ;
    ex:resolutionStatus exstat:unresolvable_candidate_set .

syn:participation-B-export ex:actorReference syn:reference-B-export .

syn:reference-B-export a gaf:Mention ;
    gaf:denotes syn:org-vendor-beta ;
    prov:value "Vendor Beta (SYN)" ;
    ex:resolutionStatus exstat:resolved .

# == P2 role claims and their provenance ==

# One claim per (activity, participation, value), each the reification of one sem:roleType statement about the
# participation node; the statement itself is asserted only for the final values (section P3).
syn:claim-A-export-v3-construction_contract a rdf:Statement ;
    rdf:subject syn:participation-A-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:construction_contract ;
    prov:wasGeneratedBy syn:activity-role-coding-v3 .

syn:claim-A-export-v3-technology_supply a rdf:Statement ;
    rdf:subject syn:participation-A-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:technology_supply ;
    prov:wasGeneratedBy syn:activity-role-coding-v3 .

syn:claim-B-export-v3-financing a rdf:Statement ;
    rdf:subject syn:participation-B-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:financing ;
    prov:wasGeneratedBy syn:activity-role-coding-v3 .

syn:claim-B-export-v3-technology_supply a rdf:Statement ;
    rdf:subject syn:participation-B-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:technology_supply ;
    prov:wasGeneratedBy syn:activity-role-coding-v3 .

syn:claim-B-export-first-pass a rdf:Statement ;
    rdf:subject syn:participation-B-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:commercial_supply ;
    prov:wasGeneratedBy syn:activity-function-first-pass .

syn:claim-B-export-human-coder-A a rdf:Statement ;
    rdf:subject syn:participation-B-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:construction_contract ;
    prov:wasGeneratedBy syn:activity-function-coder-A .

syn:claim-B-export-adjudication a rdf:Statement ;
    rdf:subject syn:participation-B-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:technology_supply ;
    prov:wasGeneratedBy syn:activity-function-adjudication ;
    prov:wasRevisionOf syn:claim-B-export-first-pass .

# Which claim is final for each value: the participation node was derived from its final claims (PROV derivation:
# "the construction of a new entity based on a pre-existing entity"). The node is thereby read both as SEM's
# constraint on the engagement's actor and as a record derived from claims.
syn:participation-A-export prov:wasDerivedFrom syn:claim-A-export-v3-construction_contract ,
        syn:claim-A-export-v3-technology_supply .

syn:participation-B-export prov:wasDerivedFrom syn:claim-B-export-v3-financing ,
        syn:claim-B-export-v3-technology_supply .

syn:activity-role-coding-v3 a prov:Activity ;
    rdfs:label "Role coding v3 (SYN)" ;
    prov:qualifiedAssociation syn:association-role-coding-v3-codebook ,
        syn:association-role-coding-v3-prompt ;
    prov:wasAssociatedWith syn:agent-model-m3 .

syn:association-role-coding-v3-codebook a prov:Association ;
    prov:agent syn:agent-model-m3 ;
    prov:hadPlan syn:plan-codebook-v3 .

syn:association-role-coding-v3-prompt a prov:Association ;
    prov:agent syn:agent-model-m3 ;
    prov:hadPlan syn:plan-prompt-v3 .

syn:activity-function-first-pass a prov:Activity ;
    rdfs:label "Function coding, first pass (SYN)" ;
    prov:qualifiedAssociation syn:association-function-first-pass-codebook ,
        syn:association-function-first-pass-prompt ;
    prov:wasAssociatedWith syn:agent-model-m2 .

syn:association-function-first-pass-codebook a prov:Association ;
    prov:agent syn:agent-model-m2 ;
    prov:hadPlan syn:plan-codebook-v2 .

syn:association-function-first-pass-prompt a prov:Association ;
    prov:agent syn:agent-model-m2 ;
    prov:hadPlan syn:plan-prompt-v1 .

syn:activity-function-coder-A a prov:Activity ;
    rdfs:label "Function coding by human coder A (SYN)" ;
    prov:qualifiedAssociation syn:association-function-coder-A-codebook ;
    prov:wasAssociatedWith syn:agent-human-coder-A .

syn:association-function-coder-A-codebook a prov:Association ;
    prov:agent syn:agent-human-coder-A ;
    prov:hadPlan syn:plan-codebook-v2 .

syn:activity-function-adjudication a prov:Activity ;
    rdfs:label "Function adjudication (SYN)" ;
    prov:qualifiedAssociation syn:association-function-adjudication-rule ;
    prov:wasAssociatedWith syn:agent-adjudicator ;
    prov:wasInformedBy syn:activity-function-first-pass .

syn:association-function-adjudication-rule a prov:Association ;
    prov:agent syn:agent-adjudicator ;
    prov:hadPlan syn:plan-adjudication-rule .

syn:agent-model-m3 a prov:SoftwareAgent ;
    rdfs:label "Coding model M3 (SYN)" .

syn:agent-model-m2 a prov:SoftwareAgent ;
    rdfs:label "Coding model M2 (SYN)" .

syn:agent-human-coder-A a prov:Person ;
    rdfs:label "Human coder A (SYN)" .

syn:agent-adjudicator a prov:Person ;
    rdfs:label "Adjudicator (SYN)" .

syn:plan-codebook-v3 a prov:Plan ;
    rdfs:label "Codebook v3.0 (SYN)" ;
    dcterms:type explan:codebook .

syn:plan-prompt-v3 a prov:Plan ;
    rdfs:label "Prompt specification v3 (SYN)" ;
    dcterms:type explan:prompt_specification .

syn:plan-codebook-v2 a prov:Plan ;
    rdfs:label "Codebook v2.0 (SYN)" ;
    dcterms:type explan:codebook .

syn:plan-prompt-v1 a prov:Plan ;
    rdfs:label "Prompt specification v1 (SYN)" ;
    dcterms:type explan:prompt_specification .

syn:plan-adjudication-rule a prov:Plan ;
    rdfs:label "Adjudication rule (SYN)" .

# == P3 roles: the role types on the participation nodes ==

# The final role values, as further sem:roleType values of the participation node. For engagement A the node has no
# rdf:value, so in SEM it reads "an actor, not identified, took these roles"; no organisation bears them.
syn:participation-A-export sem:roleType exrole:construction_contract , exrole:technology_supply .

syn:participation-B-export sem:roleType exrole:financing , exrole:technology_supply .
