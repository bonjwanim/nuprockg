# Report groups C, D and E of the demo case, the occurrence, identification and resolution statuses of all five report
# groups with their claims and provenance, and the organisations asserted to have taken part, expressed with a
# composition of existing vocabularies. Every individual is synthetic; every label carries "(SYN)".
#
# The conventions are those of composition.ttl:
#   SEM      a report group is a sem:Event, a sub-event of the case, with a sem:Role constraint node per side; its
#            records denote it, and no separate cluster node is kept. rdf:value on a node is the organisation asserted
#            as its actor; sem:roleType carries the side, the counterparty role and the coded role types.
#   GAF      gaf:Mention for the records and the actor references; gaf:denotes from a resolved reference to the
#            organisation.
#   PROV-O   a claim is an rdf:Statement (RDF reification), generated by one activity; the activity has one qualified
#            association per plan; a claim that corrects an earlier one prov:wasRevisionOf it; a node
#            prov:wasDerivedFrom its final claims. The earlier claim stays in the graph and is not final.
# Added here:
#   schema:eventStatus (schema.org) for the occurrence status of a report group, with the builder's codes.
#   adms:status (ADMS) for the identification status of a report group, with the builder's codes: the standing of the
#            group in the identification workflow (clustering key, then re-check).
#   A resolution claim is one reified ex:resolutionStatus statement and, when it resolves the reference, one reified
#            gaf:denotes statement made by the same activity; an earlier claim's candidates are reified ex:candidate
#            statements of the activity that made it.
#   dcterms:type on a software agent, with a code, marks software that is not a language model.
#
# What a group is taken to be follows from its two statuses: it reports an engagement when it occurred and is not
# merged. Only then may an organisation be asserted as an actor (rdf:value). The coded role types of the other groups,
# their references and their claims stay in the graph as coded values and claims.
#
# Section markers ("# == <id> <title> ==") delimit the sections.

@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex:      <https://example.org/ext#> .
@prefix exagent: <https://example.org/ext/agentkind/> .
@prefix excp:    <https://example.org/ext/counterparty/> .
@prefix exid:    <https://example.org/ext/identification/> .
@prefix exocc:   <https://example.org/ext/occurrence/> .
@prefix explan:  <https://example.org/ext/plantype/> .
@prefix exrole:  <https://example.org/ext/role/> .
@prefix exside:  <https://example.org/ext/side/> .
@prefix exstat:  <https://example.org/ext/status/> .
@prefix extype:  <https://example.org/ext/eventtype/> .
@prefix gaf:     <http://groundedannotationframework.org/gaf#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <https://schema.org/> .
@prefix sem:     <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix syn:     <https://example.org/syn/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# == G report groups C, D and E: events, records, articles, sides, labels and role claims ==

# Group C reports a meeting announced for later, group D two meetings of one month that the clustering key joined, and
# group E a meeting that took place. Each is a sem:Event, like groups A and B, and its records denote it. Being a
# sem:Event does not say that the event happened (SEM counts "mythical journeys" among events): the occurrence and the
# identification status say what the group is taken to be.
syn:engagement-C a sem:Event ;
    rdfs:label "Report group C (SYN)" ;
    sem:eventType extype:meeting ;
    sem:hasActor syn:participation-C-export , syn:participation-C-host ;
    sem:hasTimeStamp "2024-06"^^xsd:gYearMonth ;
    sem:subEventOf syn:case .

syn:engagement-D a sem:Event ;
    rdfs:label "Report group D (SYN)" ;
    sem:eventType extype:meeting ;
    sem:hasActor syn:participation-D-export , syn:participation-D-host ;
    sem:hasTimeStamp "2024-07"^^xsd:gYearMonth ;
    sem:subEventOf syn:case .

syn:engagement-E a sem:Event ;
    rdfs:label "Report group E (SYN)" ;
    sem:eventType extype:meeting ;
    sem:hasActor syn:participation-E-export , syn:participation-E-host ;
    sem:hasTimeStamp "2024-08"^^xsd:gYearMonth ;
    sem:subEventOf syn:case .

syn:record-C1 a gaf:Mention ;
    gaf:denotes syn:engagement-C ;
    prov:wasDerivedFrom syn:article-C1 ;
    prov:wasGeneratedBy syn:activity-event-extraction .

syn:record-D1 a gaf:Mention ;
    gaf:denotes syn:engagement-D ;
    prov:wasDerivedFrom syn:article-D1 ;
    prov:wasGeneratedBy syn:activity-event-extraction .

syn:record-D2 a gaf:Mention ;
    gaf:denotes syn:engagement-D ;
    prov:wasDerivedFrom syn:article-D2 ;
    prov:wasGeneratedBy syn:activity-event-extraction .

syn:record-E1 a gaf:Mention ;
    gaf:denotes syn:engagement-E ;
    prov:wasDerivedFrom syn:article-E1 ;
    prov:wasGeneratedBy syn:activity-event-extraction .

syn:article-C1 a prov:Entity .
syn:article-D1 a prov:Entity .
syn:article-D2 a prov:Entity .
syn:article-E1 a prov:Entity .

# One sem:Role constraint node per side. The export side carries its coded role type and is derived from its final
# role claim, as in the base graph; no node has rdf:value here (section W holds the one that does). The host side is
# the host government, with no organisation identified and no reference.
syn:participation-C-export a sem:Role ;
    ex:actorReference syn:reference-C-export ;
    prov:wasDerivedFrom syn:claim-C-export-v3-financing ;
    sem:roleType exrole:financing , exside:export_side .

syn:participation-C-host a sem:Role ;
    sem:roleType excp:host_government , exside:host_side .

syn:participation-D-export a sem:Role ;
    ex:actorReference syn:reference-D-export ;
    prov:wasDerivedFrom syn:claim-D-export-v3-commercial_supply ;
    sem:roleType exrole:commercial_supply , exside:export_side .

syn:participation-D-host a sem:Role ;
    sem:roleType excp:host_government , exside:host_side .

syn:participation-E-export a sem:Role ;
    ex:actorReference syn:reference-E-export ;
    prov:wasDerivedFrom syn:claim-E-export-v3-technology_supply ;
    sem:roleType exrole:technology_supply , exside:export_side .

syn:participation-E-host a sem:Role ;
    sem:roleType excp:host_government , exside:host_side .

# The export-side labels, as mentions; their resolution is in section R.
syn:reference-C-export a gaf:Mention ;
    prov:value "Vendor Beta (SYN)" .

syn:reference-D-export a gaf:Mention ;
    prov:value "Vendor Beta (SYN)" .

syn:reference-E-export a gaf:Mention ;
    prov:value "Vendor K / Utility K (SYN)" .

syn:claim-C-export-v3-financing a rdf:Statement ;
    rdf:subject syn:participation-C-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:financing ;
    prov:wasGeneratedBy syn:activity-role-coding-v3 .

syn:claim-D-export-v3-commercial_supply a rdf:Statement ;
    rdf:subject syn:participation-D-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:commercial_supply ;
    prov:wasGeneratedBy syn:activity-role-coding-v3 .

syn:claim-E-export-v3-technology_supply a rdf:Statement ;
    rdf:subject syn:participation-E-export ;
    rdf:predicate sem:roleType ;
    rdf:object exrole:technology_supply ;
    prov:wasGeneratedBy syn:activity-role-coding-v3 .

# == O occurrence status of groups C, D and E, with claims ==

# The status is the value of the group's final occurrence claim. The activity is in section B0: groups A and B share it.
syn:engagement-C schema:eventStatus exocc:planned ;
    prov:wasDerivedFrom syn:claim-C-occurrence .

syn:engagement-D schema:eventStatus exocc:occurred ;
    prov:wasDerivedFrom syn:claim-D-occurrence .

syn:engagement-E schema:eventStatus exocc:occurred ;
    prov:wasDerivedFrom syn:claim-E-occurrence .

syn:claim-C-occurrence a rdf:Statement ;
    rdf:subject syn:engagement-C ;
    rdf:predicate schema:eventStatus ;
    rdf:object exocc:planned ;
    prov:wasGeneratedBy syn:activity-occurrence-coding .

syn:claim-D-occurrence a rdf:Statement ;
    rdf:subject syn:engagement-D ;
    rdf:predicate schema:eventStatus ;
    rdf:object exocc:occurred ;
    prov:wasGeneratedBy syn:activity-occurrence-coding .

syn:claim-E-occurrence a rdf:Statement ;
    rdf:subject syn:engagement-E ;
    rdf:predicate schema:eventStatus ;
    rdf:object exocc:occurred ;
    prov:wasGeneratedBy syn:activity-occurrence-coding .

# == I identification status of groups C, D and E, with claims, activities and plans ==

# The status is the value of the group's final identification claim. Group C rests on the clustering key alone. The
# re-check corrected the key-based claim of group D (the key joined two meetings: merged) and confirmed that of group E
# (verified); each corrected claim stays in the graph as a claim that is not final. The clustering activity is in
# section B0: groups A and B share it.
syn:engagement-C adms:status exid:key_based ;
    prov:wasDerivedFrom syn:claim-C-identification-clustering .

syn:engagement-D adms:status exid:merged ;
    prov:wasDerivedFrom syn:claim-D-identification-recheck .

syn:engagement-E adms:status exid:verified ;
    prov:wasDerivedFrom syn:claim-E-identification-recheck .

syn:claim-C-identification-clustering a rdf:Statement ;
    rdf:subject syn:engagement-C ;
    rdf:predicate adms:status ;
    rdf:object exid:key_based ;
    prov:wasGeneratedBy syn:activity-clustering .

syn:claim-D-identification-clustering a rdf:Statement ;
    rdf:subject syn:engagement-D ;
    rdf:predicate adms:status ;
    rdf:object exid:key_based ;
    prov:wasGeneratedBy syn:activity-clustering .

syn:claim-D-identification-recheck a rdf:Statement ;
    rdf:subject syn:engagement-D ;
    rdf:predicate adms:status ;
    rdf:object exid:merged ;
    prov:wasGeneratedBy syn:activity-identification-recheck ;
    prov:wasRevisionOf syn:claim-D-identification-clustering .

syn:claim-E-identification-clustering a rdf:Statement ;
    rdf:subject syn:engagement-E ;
    rdf:predicate adms:status ;
    rdf:object exid:key_based ;
    prov:wasGeneratedBy syn:activity-clustering .

syn:claim-E-identification-recheck a rdf:Statement ;
    rdf:subject syn:engagement-E ;
    rdf:predicate adms:status ;
    rdf:object exid:verified ;
    prov:wasGeneratedBy syn:activity-identification-recheck ;
    prov:wasRevisionOf syn:claim-E-identification-clustering .

syn:activity-identification-recheck a prov:Activity ;
    rdfs:label "Identification re-check (SYN)" ;
    prov:qualifiedAssociation syn:association-identification-recheck-protocol ;
    prov:wasAssociatedWith syn:agent-adjudicator .

syn:association-identification-recheck-protocol a prov:Association ;
    prov:agent syn:agent-adjudicator ;
    prov:hadPlan syn:plan-identification-recheck-protocol .

syn:plan-identification-recheck-protocol a prov:Plan ;
    rdfs:label "Identification re-check protocol (SYN)" .

# == R resolution of the references of groups C, D and E, with claims, activities and plans ==

# A reference's status and organisation are those of its final resolution claim: one reified ex:resolutionStatus
# statement and, because each of these references is resolved, one reified gaf:denotes statement of the same activity.
# A reference that is resolved but belongs to a group that did not occur or is merged still denotes its organisation:
# that is a coded value, not an assertion that the organisation took part (section W).
syn:reference-C-export ex:resolutionStatus exstat:resolved ;
    gaf:denotes syn:org-vendor-beta ;
    prov:wasDerivedFrom syn:claim-C-export-resolution-status , syn:claim-C-export-resolution-organisation .

syn:reference-D-export ex:resolutionStatus exstat:resolved ;
    gaf:denotes syn:org-vendor-beta ;
    prov:wasDerivedFrom syn:claim-D-export-resolution-status , syn:claim-D-export-resolution-organisation .

syn:reference-E-export ex:resolutionStatus exstat:resolved ;
    gaf:denotes syn:org-vendor-k ;
    prov:wasDerivedFrom syn:claim-E-export-rejudgement-status , syn:claim-E-export-rejudgement-organisation .

syn:claim-C-export-resolution-status a rdf:Statement ;
    rdf:subject syn:reference-C-export ;
    rdf:predicate ex:resolutionStatus ;
    rdf:object exstat:resolved ;
    prov:wasGeneratedBy syn:activity-reference-resolution .

syn:claim-C-export-resolution-organisation a rdf:Statement ;
    rdf:subject syn:reference-C-export ;
    rdf:predicate gaf:denotes ;
    rdf:object syn:org-vendor-beta ;
    prov:wasGeneratedBy syn:activity-reference-resolution .

syn:claim-D-export-resolution-status a rdf:Statement ;
    rdf:subject syn:reference-D-export ;
    rdf:predicate ex:resolutionStatus ;
    rdf:object exstat:resolved ;
    prov:wasGeneratedBy syn:activity-reference-resolution .

syn:claim-D-export-resolution-organisation a rdf:Statement ;
    rdf:subject syn:reference-D-export ;
    rdf:predicate gaf:denotes ;
    rdf:object syn:org-vendor-beta ;
    prov:wasGeneratedBy syn:activity-reference-resolution .

# The model's earlier claim on the reference of group E: the bundled label is an unresolvable candidate set with these
# two candidates. It stays in the graph and is not final; reifying ex:candidate does not assert it, so the reference
# itself names no candidate.
syn:claim-E-export-model-status a rdf:Statement ;
    rdf:subject syn:reference-E-export ;
    rdf:predicate ex:resolutionStatus ;
    rdf:object exstat:unresolvable_candidate_set ;
    prov:wasGeneratedBy syn:activity-reference-resolution-by-model .

syn:claim-E-export-model-candidate-vendor-k a rdf:Statement ;
    rdf:subject syn:reference-E-export ;
    rdf:predicate ex:candidate ;
    rdf:object syn:org-vendor-k ;
    prov:wasGeneratedBy syn:activity-reference-resolution-by-model .

syn:claim-E-export-model-candidate-utility-k a rdf:Statement ;
    rdf:subject syn:reference-E-export ;
    rdf:predicate ex:candidate ;
    rdf:object syn:org-utility-k ;
    prov:wasGeneratedBy syn:activity-reference-resolution-by-model .

# The adjudicator's re-judgement resolves it to Vendor K and corrects the status of the earlier claim.
syn:claim-E-export-rejudgement-status a rdf:Statement ;
    rdf:subject syn:reference-E-export ;
    rdf:predicate ex:resolutionStatus ;
    rdf:object exstat:resolved ;
    prov:wasGeneratedBy syn:activity-reference-rejudgement ;
    prov:wasRevisionOf syn:claim-E-export-model-status .

syn:claim-E-export-rejudgement-organisation a rdf:Statement ;
    rdf:subject syn:reference-E-export ;
    rdf:predicate gaf:denotes ;
    rdf:object syn:org-vendor-k ;
    prov:wasGeneratedBy syn:activity-reference-rejudgement .

syn:activity-reference-resolution-by-model a prov:Activity ;
    rdfs:label "Reference resolution by model (SYN)" ;
    prov:qualifiedAssociation syn:association-reference-resolution-by-model-rules ,
        syn:association-reference-resolution-by-model-prompt ;
    prov:wasAssociatedWith syn:agent-model-m3 .

syn:association-reference-resolution-by-model-rules a prov:Association ;
    prov:agent syn:agent-model-m3 ;
    prov:hadPlan syn:plan-reference-resolution-rules .

syn:association-reference-resolution-by-model-prompt a prov:Association ;
    prov:agent syn:agent-model-m3 ;
    prov:hadPlan syn:plan-prompt-v3 .

syn:activity-reference-rejudgement a prov:Activity ;
    rdfs:label "Reference re-judgement (SYN)" ;
    prov:qualifiedAssociation syn:association-reference-rejudgement-rules ;
    prov:wasAssociatedWith syn:agent-adjudicator .

syn:association-reference-rejudgement-rules a prov:Association ;
    prov:agent syn:agent-adjudicator ;
    prov:hadPlan syn:plan-reference-resolution-rules .

# == W what is asserted about the real world for groups C, D and E ==

# Only group E occurred and is not merged, so only its export side gains an organisation. The role type coded on the
# node (section G) is thereby read as a role this organisation realized. Groups C and D have no triple here: their
# coded values and claims stay where they are, and no organisation is asserted to have taken part in them.
syn:participation-E-export rdf:value syn:org-vendor-k .

# == B0 statuses, claims and shared activities of groups A and B ==

# Occurrence and identification statuses of groups A and B and their final claims.
syn:engagement-A schema:eventStatus exocc:occurred ;
    adms:status exid:key_based ;
    prov:wasDerivedFrom syn:claim-A-occurrence , syn:claim-A-identification-clustering .

syn:engagement-B schema:eventStatus exocc:occurred ;
    adms:status exid:key_based ;
    prov:wasDerivedFrom syn:claim-B-occurrence , syn:claim-B-identification-clustering .

syn:claim-A-occurrence a rdf:Statement ;
    rdf:subject syn:engagement-A ;
    rdf:predicate schema:eventStatus ;
    rdf:object exocc:occurred ;
    prov:wasGeneratedBy syn:activity-occurrence-coding .

syn:claim-B-occurrence a rdf:Statement ;
    rdf:subject syn:engagement-B ;
    rdf:predicate schema:eventStatus ;
    rdf:object exocc:occurred ;
    prov:wasGeneratedBy syn:activity-occurrence-coding .

syn:claim-A-identification-clustering a rdf:Statement ;
    rdf:subject syn:engagement-A ;
    rdf:predicate adms:status ;
    rdf:object exid:key_based ;
    prov:wasGeneratedBy syn:activity-clustering .

syn:claim-B-identification-clustering a rdf:Statement ;
    rdf:subject syn:engagement-B ;
    rdf:predicate adms:status ;
    rdf:object exid:key_based ;
    prov:wasGeneratedBy syn:activity-clustering .

# Final resolution claims of the references of groups A and B. The status and the organisation are those the base graph
# already holds on the references; here they gain their claims and provenance.
syn:reference-A-export prov:wasDerivedFrom syn:claim-A-export-resolution-status .

syn:reference-B-export prov:wasDerivedFrom syn:claim-B-export-resolution-status ,
        syn:claim-B-export-resolution-organisation .

syn:claim-A-export-resolution-status a rdf:Statement ;
    rdf:subject syn:reference-A-export ;
    rdf:predicate ex:resolutionStatus ;
    rdf:object exstat:unresolvable_candidate_set ;
    prov:wasGeneratedBy syn:activity-reference-resolution .

syn:claim-B-export-resolution-status a rdf:Statement ;
    rdf:subject syn:reference-B-export ;
    rdf:predicate ex:resolutionStatus ;
    rdf:object exstat:resolved ;
    prov:wasGeneratedBy syn:activity-reference-resolution .

syn:claim-B-export-resolution-organisation a rdf:Statement ;
    rdf:subject syn:reference-B-export ;
    rdf:predicate gaf:denotes ;
    rdf:object syn:org-vendor-beta ;
    prov:wasGeneratedBy syn:activity-reference-resolution .

# The activities groups A and B share with the new groups.
syn:activity-occurrence-coding a prov:Activity ;
    rdfs:label "Occurrence coding (SYN)" ;
    prov:qualifiedAssociation syn:association-occurrence-coding-protocol ;
    prov:wasAssociatedWith syn:agent-model-m3 .

syn:association-occurrence-coding-protocol a prov:Association ;
    prov:agent syn:agent-model-m3 ;
    prov:hadPlan syn:plan-occurrence-coding-protocol .

syn:plan-occurrence-coding-protocol a prov:Plan ;
    rdfs:label "Occurrence coding protocol (SYN)" ;
    dcterms:type explan:prompt_specification .

# The clustering rule is run by software that is not a language model: it is a prov:SoftwareAgent, and dcterms:type
# marks it as non-model software, which frees it from the requirement of a prompt specification on model activities.
syn:activity-clustering a prov:Activity ;
    rdfs:label "Clustering (SYN)" ;
    prov:qualifiedAssociation syn:association-clustering-rule ;
    prov:wasAssociatedWith syn:agent-aggregation-pipeline .

syn:association-clustering-rule a prov:Association ;
    prov:agent syn:agent-aggregation-pipeline ;
    prov:hadPlan syn:plan-month-granularity-rule .

syn:agent-aggregation-pipeline a prov:SoftwareAgent ;
    rdfs:label "Aggregation pipeline (SYN)" ;
    dcterms:type exagent:non_model_software .

syn:plan-month-granularity-rule a prov:Plan ;
    rdfs:label "Month granularity rule (SYN)" .

syn:activity-reference-resolution a prov:Activity ;
    rdfs:label "Reference resolution (SYN)" ;
    prov:qualifiedAssociation syn:association-reference-resolution-rules ;
    prov:wasAssociatedWith syn:agent-adjudicator .

syn:association-reference-resolution-rules a prov:Association ;
    prov:agent syn:agent-adjudicator ;
    prov:hadPlan syn:plan-reference-resolution-rules .

syn:plan-reference-resolution-rules a prov:Plan ;
    rdfs:label "Reference resolution rules (SYN)" .
