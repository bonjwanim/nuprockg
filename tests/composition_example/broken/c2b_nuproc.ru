# c2b (NuProc). The earlier claim of human coder A (construction contract), which disagrees with the role values of
# the participation, is also marked final.
PREFIX nuproc: <https://w3id.org/nuproc/ns#>
PREFIX syn:    <https://example.org/syn/>
INSERT DATA { syn:participation-B-export nuproc:hasFinalRoleClaim syn:claim-B-export-human-coder-A . }
