<https://w3id.org/nuproc/demo/validation/channel_presence> a nuproc:ValidationActivity ;
    rdfs:label "Channel-presence coding validation"@en ;
    rdfs:comment "Sample of 240 items, validated by two independent human coders blind to the model labels and to each other."@en ;
    prov:wasAssociatedWith <https://w3id.org/nuproc/demo/agent/human-coder-1>,
        <https://w3id.org/nuproc/demo/agent/human-coder-2> ;
    nuproc:generatedQualityMeasurement <https://w3id.org/nuproc/demo/qm/channel-kappa-b2b>,
        <https://w3id.org/nuproc/demo/qm/channel-kappa-b2g>,
        <https://w3id.org/nuproc/demo/qm/channel-kappa-g2g> .

<https://w3id.org/nuproc/demo/validation/engagement_role_validation> a nuproc:ValidationActivity ;
    rdfs:label "Engagement-role validation (stratified sample of 150 design events)"@en ;
    rdfs:comment "150 design events drawn stratified by the output of the v3 role coding (VALIDATION_PROTOCOL section 2.1). Two human coders coded the roles separately, blind to the model coding and each other (as asked; not verifiable), and judged whether the excerpts describe one engagement; the author adjudicated the role cells on which they disagreed, without the per-event model values. Where both coders judged one engagement the cluster's identification is verified, where both judged several it is merged. The adjudicated reference gives the final role values of the sampled events (a decision taken after the validation results had been seen). The scoring script was frozen before the coders' sheets were read (scripts/score_validation_v3.py)."@en ;
    prov:wasAssociatedWith <https://w3id.org/nuproc/demo/agent/role-validation-coder-A>,
        <https://w3id.org/nuproc/demo/agent/role-validation-coder-B>,
        <https://w3id.org/nuproc/demo/agent/rule-author> ;
    nuproc:generatedQualityMeasurement <https://w3id.org/nuproc/demo/qm/role-alpha-masi-A-B>,
        <https://w3id.org/nuproc/demo/qm/role-alpha-masi-A-B-model>,
        <https://w3id.org/nuproc/demo/qm/role-exact-A-B>,
        <https://w3id.org/nuproc/demo/qm/role-exact-A-model>,
        <https://w3id.org/nuproc/demo/qm/role-exact-B-model> .

<https://w3id.org/nuproc/demo/validation/event_audit> a nuproc:ValidationActivity ;
    rdfs:label "Event-level audit"@en ;
    rdfs:comment "Sample of 96 items, validated by two independent human coders blind to the model labels and to each other."@en ;
